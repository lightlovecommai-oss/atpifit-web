---
import { SHEET_API } from '../consts';

interface Props {
  title?: string;
  lead?: string;
  /* 記錄是從哪一頁訂閱的，供之後看哪篇文章帶得動名單 */
  source?: string;
  /* 一頁只有一顆主行動鈕（24 §3.8 Nike 原則）。
     頁面上已經有主鈕時（例如首頁的「做健檢」），這裡要傳 'sub' 退成次行動。 */
  variant?: 'main' | 'sub';
}
const {
  title = '每週一封，一次練一塊肌肉',
  lead = '把課堂上講的方法拆成可以馬上用的一個小動作，寄到你信箱。隨時可以退訂。',
  source = 'web',
  variant = 'main',
} = Astro.props;
---

<section class="news" aria-labelledby="news-title">
  <div class="inner">
    <p class="kicker">電子報</p>
    <h2 id="news-title">{title}</h2>
    <p class="lead">{lead}</p>

    <form class="form" data-source={source} data-endpoint={SHEET_API} novalidate>
      <div class="fields">
        <label class="visually-hidden" for="nl-name">你的稱呼</label>
        <input id="nl-name" name="name" type="text" autocomplete="given-name" placeholder="你的稱呼（選填）" />

        <label class="visually-hidden" for="nl-email">Email</label>
        <input id="nl-email" name="email" type="email" autocomplete="email" required
               placeholder="你的 Email" aria-describedby="nl-msg" />

        <button class={`btn btn-${variant}`} type="submit">訂閱</button>
      </div>
      <p class="msg" id="nl-msg" role="status" aria-live="polite"></p>
      <p class="fine">我們不寄廣告，也不會把你的 Email 給任何人。</p>
    </form>
  </div>
</section>

<script>
  /* 低摩擦守則（規範 31）：追蹤或網路出事都不可以卡住使用者，一律只寫 console。 */
  document.querySelectorAll<HTMLFormElement>('.news .form').forEach((form) => {
    const email = form.querySelector<HTMLInputElement>('input[name="email"]')!;
    const name = form.querySelector<HTMLInputElement>('input[name="name"]')!;
    const btn = form.querySelector<HTMLButtonElement>('button')!;
    const msg = form.querySelector<HTMLParagraphElement>('.msg')!;
    const endpoint = form.dataset.endpoint!;

    const say = (text: string, ok = false) => {
      msg.textContent = text;
      msg.dataset.state = ok ? 'ok' : 'err';
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const value = email.value.trim();
      if (!value || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
        say('這個 Email 看起來不太對，再確認一下？');
        email.focus();
        return;
      }

      btn.disabled = true;
      const original = btn.textContent;
      btn.textContent = '送出中…';
      msg.textContent = '';

      const payload = {
        action: 'subscribe',
        email: value,
        name: name.value.trim(),
        source: form.dataset.source || 'web',
        page: location.pathname,
        timestamp: new Date().toISOString(),
        track: (window as any).trackPayload?.() ?? {},
      };

      try {
        /* text/plain＝簡單請求，不觸發 CORS 預檢（跟測驗端同一個做法） */
        const r = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'text/plain;charset=utf-8' },
          body: JSON.stringify(payload),
        });
        const d = await r.json().catch(() => ({}));
        if (!r.ok || d.status !== 'ok') throw new Error(d.status || `HTTP ${r.status}`);

        form.querySelector('.fields')!.remove();
        /* 不承諾「第一封信馬上到」：寄信要 LaunChill 那把 webhook 設好才會發，
           後端沒設的時候名單只會進 Sheet，句子就會變成謊話。 */
        say('訂閱好了。之後有新的內容，我會寄到這個信箱。', true);
        try { (window as any).track?.('lead_submit', { has_name: !!payload.name, source: payload.source }); } catch {}
      } catch (err) {
        console.warn('訂閱送出失敗：', err);
        say('送出的時候出了點狀況，麻煩再按一次。');
        btn.disabled = false;
        btn.textContent = original;
      }
    });
  });
</script>

<style>
  .news { background: var(--a-tint); border-radius: 20px; padding: clamp(32px, 5vw, 52px) 0; }
  .inner { max-width: 620px; margin-inline: auto; padding-inline: 24px; text-align: center; }
  .news .lead { margin-top: 10px; }

  .form { margin-top: 26px; }
  .fields { display: flex; gap: 10px; flex-wrap: wrap; }
  .fields input {
    flex: 1 1 180px; min-height: 56px; padding: 14px 18px;
    font-family: inherit; font-size: 16px; color: var(--ink);
    background: #fff; border: 1.5px solid var(--line-soft); border-radius: var(--r-btn);
  }
  .fields input::placeholder { color: var(--ink-soft); opacity: .8; }
  .fields input:focus-visible { border-color: var(--act); }
  .fields button { flex: 0 0 auto; min-width: 120px; }
  .fields button[disabled] { opacity: .7; cursor: wait; }

  .msg { margin-top: 12px; font-size: 15px; font-weight: 600; min-height: 1.5em; }
  .msg[data-state="ok"] { color: var(--t-deep); }
  .msg[data-state="err"] { color: var(--act-deep); }
  .fine { margin-top: 10px; font-size: 13px; color: var(--ink-soft); }

  @media (max-width: 520px) {
    .fields { flex-direction: column; }
    .fields button { width: 100%; }
  }
</style>
