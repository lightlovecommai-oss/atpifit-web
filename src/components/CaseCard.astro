---
/* 學員案例卡（24 §3.8 招6 見證規格）：引言泡＋原始截圖（微傾）＋名字＋身分＋系列落款。
   ⚠️ 引言絕不代擬——quote 必須逐字等於 shot 截圖裡的原文。 */
import type { CaseItem } from '../consts';

interface Props { c: CaseItem }
const { c } = Astro.props;
---

<article class="case">
  {c.stat && (
    <p class="case-stat">
      <b>{c.stat.num}</b>
      <span>{c.stat.label}</span>
    </p>
  )}
  <blockquote class="case-quote">
    <p>{c.quote}</p>
  </blockquote>
  <figure class="case-shot photo">
    <img
      src={c.shot}
      alt={`${c.name}的原始訊息截圖`}
      loading="lazy"
      style={`object-position:${c.shotPos ?? '50% 0%'}`}
    />
    <figcaption>📷 原始截圖</figcaption>
  </figure>
  <footer class="case-meta">
    <b>{c.name}</b>
    <span>{c.who}</span>
    <span class="case-series">{c.series}</span>
  </footer>
</article>

<style>
  .case { background: var(--card); border: 1px solid var(--line); border-radius: var(--r-card); padding: 22px; }

  /* 大數字（§3.8 招4）：數字以截圖為準 */
  .case-stat { display: flex; align-items: baseline; gap: 10px; margin: 0 0 14px; flex-wrap: wrap; }
  .case-stat b { font-size: 30px; font-weight: 800; color: var(--act-deep); letter-spacing: .01em; }
  .case-stat span { font-size: 13.5px; color: var(--ink-soft); }

  /* 引言泡：客戶原話規格（底色框，不用品牌大金引號——那個只給光頭金句） */
  .case-quote { margin: 0; background: var(--bg-alt); border: 1px solid var(--line); border-radius: 12px; padding: 16px 18px; }
  .case-quote p { font-size: 16px; line-height: 1.85; color: var(--ink); }

  /* 固定視窗：原始截圖常是整頁長擷取（900×4000+），攤開會變一條白帶——
     只露關鍵段，露哪段由 shotPos 控制 */
  .case-shot { margin: 16px 0 0; transform: rotate(-1.2deg); }
  .case-shot img { width: 100%; height: 300px; object-fit: cover; display: block; }

  .case-meta { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 10px; margin-top: 16px; font-size: 14px; color: var(--ink-soft); }
  .case-meta b { font-size: 15px; color: var(--ink); }
  .case-series { margin-left: auto; font-size: 12.5px; font-weight: 700; letter-spacing: .06em; color: var(--act-deep); }
</style>
