---
import { SITE, SAME_AS, LINKS } from '../consts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/brand.css';

interface Props {
  title: string;
  description: string;
  /* 分享圖。預設用品牌 OG 圖（24 §1.3：所有對外連結都要掛，否則分享到 LINE/FB 會空白）*/
  image?: string;
  /* 頁面專屬的 JSON-LD。Organization/WebSite 已在本層全站掛好，這裡只加頁面型別。*/
  schema?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  /* 文章頁用寬度較窄的正文欄 */
  bodyClass?: string;
}

const { title, description, image = '/assets/og-default.png', schema, noindex = false, bodyClass = '' } = Astro.props;

const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
const pageTitle = Astro.url.pathname === '/' ? title : `${title}｜${SITE.name}`;

/* 全站型結構化資料。Organization 與 Person 是 AI 搜尋認得「我們是誰」的主要依據。 */
const orgSchema = {
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  alternateName: ['ATPIFit', '影響力健身房 ATPIFit'],
  url: SITE.url,
  logo: { '@type': 'ImageObject', url: `${SITE.url}/assets/logo-avatar.png` },
  description,
  founder: { '@id': `${SITE.url}/about#person` },
  sameAs: [...SAME_AS],
  areaServed: { '@type': 'Country', name: '台灣' },
  knowsLanguage: ['zh-Hant'],
};

const siteSchema = {
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: SITE.url,
  name: SITE.nameFull,
  inLanguage: 'zh-Hant-TW',
  publisher: { '@id': `${SITE.url}/#organization` },
};

const graph = [orgSchema, siteSchema, ...(schema ? (Array.isArray(schema) ? schema : [schema]) : [])];
const jsonLd = { '@context': 'https://schema.org', '@graph': graph };
---

<!DOCTYPE html>
<html lang={SITE.lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <meta name="theme-color" content="#F7F1EC" />
  <link rel="icon" href="/assets/favicon-32.png" sizes="32x32" />
  <link rel="apple-touch-icon" href="/assets/favicon-180.png" />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content={SITE.nameFull} />
  <meta property="og:locale" content={SITE.locale} />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <link rel="alternate" type="application/rss+xml" title={`${SITE.name}｜文章`} href="/rss.xml" />
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

  <link rel="preconnect" href="https://rsms.me/" />
  <link rel="stylesheet" href="https://rsms.me/inter/inter.css" />
  <!-- Noto Sans TC＝quiz／member 同款字體，900 級大標是視覺語言的一部分 -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;600;700;900&display=swap" />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <!-- 數位足跡。規範＝productkit 31-數位足跡與追蹤規範。
       ⭐ 鐵則：只 push dataLayer，絕不在頁面直接呼叫 gtag／fbq。 -->
  <script is:inline src="/track.js"></script>
</head>
<body class={bodyClass}>
  <a class="skip" href="#main">跳到主要內容</a>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />

  <!-- 手機 sticky 健檢欄：北極星指標＝Quiz 點擊率（2026-09-10 拍板），長頁讀到一半的人也要搆得到主行動。
       滑過首屏才升起，跟頁內主鈕不同時出現＝不違反一頁一顆主鈕。 -->
  <div class="sticky-quiz" id="sticky-quiz" aria-hidden="true">
    <a class="btn btn-main" href={LINKS.quiz} data-cta="quiz" data-cta-position="sticky">
      免費影響力健檢｜3 分鐘
    </a>
  </div>
  <script>
    /* cta_click 的發射器（規範 31 §4E）：track.js 只給函式不綁 click，
       這裡統一監聽 [data-cta]，否則北極星（Quiz 點擊率）量不到。低摩擦：出事只吞掉，不擋跳轉。 */
    document.addEventListener('click', (e) => {
      const el = (e.target as Element).closest?.('[data-cta]') as HTMLElement | null;
      if (!el) return;
      try {
        (window as any).track?.('cta_click', {
          cta_id: el.dataset.cta,
          cta_position: el.dataset.ctaPosition || '',
          cta_text: (el.textContent || '').trim(),
        });
      } catch {}
    });

    const bar = document.getElementById('sticky-quiz')!;
    let shown = false;
    const onScroll = () => {
      const want = window.scrollY > 560;
      if (want !== shown) {
        shown = want;
        bar.classList.toggle('on', want);
        bar.setAttribute('aria-hidden', String(!want));
      }
    };
    addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  </script>
  <style>
    .sticky-quiz {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 60;
      display: none; padding: 10px 16px calc(10px + env(safe-area-inset-bottom));
      background: rgba(247, 241, 236, .95);
      backdrop-filter: saturate(140%) blur(10px);
      border-top: 1px solid var(--line);
      transform: translateY(110%); transition: transform .25s ease;
    }
    .sticky-quiz.on { transform: none; }
    .sticky-quiz .btn { width: 100%; }
    @media (max-width: 900px) { .sticky-quiz { display: block; } }
  </style>
</body>
</html>
