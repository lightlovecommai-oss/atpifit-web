  /* ═══ 06 兩個課的覆蓋條 ═══
     ⚠️ 用 .courses-grid 不用 .grid-2 的 auto-fit：auto-fit 會在中等寬度（900–1024px）
        把兩張卡壓成一欄一卡，看起來像只買得到一門。寬度強制兩欄。 */
  .ladder-k {
    margin-top: clamp(46px, 6vw, 72px);
    font-size: clamp(21px, 2.6vw, 26px); color: var(--ink);
  }
  .ladder-sub { margin-top: 8px; font-size: clamp(16px, 1.9vw, 18px); color: var(--ink-soft); max-width: 50ch; }
  .courses-grid {
