  @media (max-width: 760px) {
    /* 窄螢幕：三欄疊成三列，每一段自己一排薄片＋文字 */
    .ladder { grid-template-columns: 1fr; gap: 30px; }
    .lstage + .lstage::before { display: none; }
    .lstage + .lstage { border-top: 1px solid var(--line-soft); padding-top: 26px; }
    /* 單欄時薄片不能再 flex:1 撐滿——一片 100px 高 34px 就成了橫躺的色塊，
