---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, LINKS, FOUNDER_PHOTO } from '../consts';

/* 「超引力成交學」方法論長頁（LP），取代舊的 lp.atpifit.com 系列。
   ⭐ 2026-10-01 改版：目標對象從「學生／舊生」換成**陌生的專業工作者**——
      業務員、職人與接案者、講師、中小企業主。所以整頁的順序也換了：
      先認出痛（01、02）→ 先賣人（03，教的人是誰從第 9 站搬到第 3 站）→
      才講方法（04）→ 好處（05）→ 證明（06）→ 篩選（07）→ 怎麼進來（08）。
   ⚠️ 文案真相＝productkit/7-KOL通路/01-活動通文案.md（已核准的客戶版第三層）。
      段落照抄，不重寫；只有講座專屬那幾段（§7–§9、§11）沒有搬過來，那是另一個製作物的事。
   ⚠️ 舊版的舊生複訓開關（CTA_MODE）整組拿掉：舊生的路在 /courses/retrain，
      這頁退回純陌生人頁，主行動鈕永遠是免費 1v1 諮詢。
   ⚠️ 方法論的主圖是「四個斷點」（§04）；L1–L13 的課表攤在 §06、交付物在 §07。
      12 小肌群牆與四塊肌肉在 /method/——同一張圖不在兩頁各畫一次。
   ⭐ 2026-10-24：/courses/ 是過渡期的課程頁，內容全部搬進這一頁，該頁退役轉址過來
      （astro.config.mjs 的 redirects）。導覽列的「課程」也改指這裡。
      /courses/retrain 是另一條路（電話邀請的舊生），不受影響、照常運作。

   ⚠️ 視覺＝科技版深色底（bodyClass="theme-dark"），這不是門面破例，是產品線區隔：
   影響力健身房＝館，暖版；超引力成交學＝實戰私教，科技版。色值真相＝
   consult-workshop/pro.html，變數層在 brand.css 的 body.theme-dark。

   ⚠️ 作廢詞：一階／二階／三階／Level 1-3／引力式系列／8週·12週／1+1 系統／「〇〇力」／收割。
   ⚠️ 價值堆疊與定價話術是諮詢現場用的，不上 LP（03-產品體系總覽 §C）。
   ⚠️ 見證數字與客戶原話一律照抄來源，不代擬、不潤飾。 */

const title = '超引力成交學｜明明很專業，為什麼沒人買單？';
const description =
  '業務、職人、講師、中小企業主——你不是不夠專業，只是沒有人教過你怎麼把價值講出來。超引力成交學把「一個人為什麼會願意跟你買」拆成 ATPI 四塊影響力肌肉：吸引、信任、專業、推進，一課一塊，練到在真實對話裡走得通。先預約一次免費 1v1 諮詢。';

/* 四句自問（§2 原文）。維度只是上色用的順序，不是說這句話對應那塊肌肉。 */
const asks = [
  { dim: 'A', q: '是不是我還不夠專業？' },
  { dim: 'T', q: '是不是我不會行銷？' },
  { dim: 'P', q: '是不是我價格開太高？' },
  { dim: 'I', q: '還是……我就是不適合做生意，我不會推銷。' },
];

/* 四種人掛在嘴邊的那一句：原文＝productkit/6-BNI通路/BNI-TA痛點卡.md。
   ⚠️ 來源表還有一欄「賣哪階」用的是作廢詞，刻意沒有搬過來。 */
const pains = [
  { dim: 'A', role: '業務員', quote: '講半天沒感覺',
    who: '對產品超熟、客戶卻只說再考慮的業務' },
  { dim: 'T', role: '中小企業主', quote: '問他們都沒反應',
    who: '開會永遠自己一人講、幹部不敢表達的中小企業主' },
  { dim: 'P', role: '講師', quote: '講完沒人行動',
    who: '專業超強、但一上台就照稿念、收不了單的顧問型講師' },
  { dim: 'I', role: '職人・接案者', quote: '不敢開口收更高',
    who: '諮詢口碑好、但接不到下一個、不敢升價的 1v1 顧問' },
];

/* 創辦人六條（§12 原文）。數字用 <b> 標起來，所以走 set:html。 */
const feats = [
  { dim: 'A', l: '從零開始', s: '家裡背了 2000 萬的債，我把手上最後 100 萬拿去繳學費，回來隔著一個海峽，簽下一個從沒見過面的陌生客戶，<b>120 萬</b>' },
  { dim: 'T', l: '一對一', s: '2 小時陌生開發，成交 <b>20 萬</b>' },
  { dim: 'P', l: '一對多', s: '<b>200 場以上</b>演講；3 小時新品發表會，<b>1000 萬</b>營業額' },
  { dim: 'I', l: '帶團隊', s: '帶一個業務團隊，6 個月從 <b>300 萬做到 3000 萬</b>' },
  { dim: 'T', l: '帶機構', s: '輔導一家教育機構，公司營收從 <b>50 萬/月</b>到<b>穩定 200 萬+/月</b>' },
  { dim: 'P', l: '可複製', s: '輔導超過 <b>2000 位</b>學員，把「怎麼開口」變成一套可以教的系統' },
];

/* 四個斷點流程圖：一場對話會斷在哪四個地方。結果句鎖字典 01:58–61。 */
const chain = [
  { dim: 'A', muscle: '吸引肌肉', from: '你開口', to: '他想聽', broke: '他沒有一個非聽不可的理由' },
  { dim: 'T', muscle: '信任肌肉', from: '他想聽', to: '他說真話', broke: '他給你客套，你只能自己猜' },
  { dim: 'P', muscle: '專業肌肉', from: '他說真話', to: '他認定你', broke: '他聽懂了，但去找了別人' },
  { dim: 'I', muscle: '推進肌肉', from: '他認定你', to: '他真的做', broke: '氣氛很熱，散場之後什麼都沒發生' },
];

/* 對照表（§4 原文，三欄照搬）。第三欄的原標題是「真正缺的」，這裡改成「真正該練的」：
   「缺」是赤字語言（跟薄／弱／補同一類），對外一律不用。改的是標籤不是內容，欄裡的四句照搬。 */
const diag = [
  { dim: 'A', see: '沒有人主動來找你', think: '我不會行銷', need: '讓他<b>想靠近</b>你的那塊' },
  { dim: 'T', see: '對方很客氣，但不講真話、只問價格', think: '客戶只在乎便宜', need: '讓他<b>願意說</b>的那塊' },
  { dim: 'P', see: '他聽懂了、點頭了，然後去找了別人', think: '我講得不夠深', need: '讓他<b>要找你</b>的那塊' },
  { dim: 'I', see: '都聊到最後了，你卻沒開口', think: '我不想給人壓力', need: '讓他<b>願意行動</b>的那塊' },
];

/* 你手上會多什麼。⚠️ 這四條是**課**的好處，不是講座的（§8 那份是講座專屬，沒有搬）。
   set:html 只為了塞 .nb 斷行保護，字句本身沒動。 */
const gets = [
  { t: '卡住的位置，變成看得到的數字',
    s: '四塊肌肉、十二條小肌群，免費健檢三分鐘就量得出來。<span class="nb">先練哪塊最有感，</span><span class="nb">不用靠感覺猜。</span>' },
  { t: '一套你自己的話，不是別人的腳本',
    s: '我們教結構，不教背稿。腳本是別人的身體，<span class="nb">穿不上你的。</span>' },
  { t: '這週真的要談的那一場',
    s: '每週把你的現場帶進小組，<span class="nb">4 到 5 人 Hot Seat 輪流，</span><span class="nb">顧問當場校正，</span><span class="nb">結果再帶回下一堂。</span>' },
  { t: '前後各量一次，進步不靠感覺',
    s: '開課前做入學健檢當起點，結業後複測做前後對照。<span class="nb">看得到數字。</span>' },
];

/* 輔導過的人（§6 原文）。⚠️ q 是客戶自己說的話，一字不動，也不替沒說話的人代擬。 */
const results = [
  { who: '身心靈課程創辦人', s: '調整了說話的底層邏輯之後，課程轉換率衝到 <b>40%</b>',
    q: '成交變自然了，我不用再逼自己去推銷。' },
  { who: '療癒師', s: '原本月收才 4 千，上完課 <b>36 天變現 10 萬</b>' },
  { who: '到府按摩師', s: '做生意失敗負債 100 萬轉行，<b>1 月總收入衝到 13 萬 5 千</b>',
    q: '如何說話讓自己感覺起來有自信，讓顧客更信賴我，快速幫我拓展客源。' },
  { who: '兩性教育機構主理人', s: '公司營收從 50 萬/月，做到<b>穩定 200 萬+/月</b>' },
  { who: '房產講師', s: '一個月<b>漲粉破千</b>、轉換率翻倍，開始有大公司主動邀約' },
  { who: '醫美保養品主理人', s: '新品發表會親自上台、親自邀請，<b>3 小時創造 1000 萬營業額</b>' },
];

/* 學員見證卡：productkit/產品kit/見證素材/見證卡/輸出 出的原圖，這裡只是放。
   要換人或改數字＝回去改那邊再重出，不要在這頁動。 */
const proof = [
  { src: '/assets/cases/card-weixiang.png',
    alt: '學員見證・王偉翔（到府按摩師、負債 100 萬轉行）：轉行後單月總收入 13.5 萬，卡片附原始對話截圖。維度標籤 T 信任肌肉。' },
  { src: '/assets/cases/card-linjiaxuan.png',
    alt: '學員見證・林珈鉉（企管顧問＋身心靈工作者）：上完課後的第一次實體銷講，15 人到場、9 位有效聽眾、8 位申請 1v1、3 位全數成交，過去同類型銷講成交率 6–9%。維度標籤 P 專業肌肉。' },
  { src: '/assets/cases/card-liumuyang.png',
    alt: '學員見證・劉沐洋（艾斯，家族辦公室主理人）：FB 公開發文寫「他只講了幾句話，就把我成交了。」，卡片附原始貼文截圖。維度標籤 A 吸引肌肉、T 信任肌肉、P 專業肌肉。' },
];

/* 誰適合／誰不適合（§10 原文，語氣不改）。先說清楚比較公平。 */
const fitYes = [
  '有真本事，<span class="nb">但客戶總是說「我再想想」的</span><span class="nb">專業工作者</span>——<span class="nb">顧問、教練、諮詢師、</span><span class="nb">療癒師、設計師、接案者</span>',
  '<span class="nb">有在做一對一諮詢／服務，</span><span class="nb">但成交靠緣分的人</span>',
  '<span class="nb">已經在講台上，</span><span class="nb">但講完沒有人行動的講師</span>',
  '<span class="nb">想把自己的專業或人生故事，</span><span class="nb">變成一份收入的人</span>',
];
const fitNo = [
  '想找「一句話就讓對方買單」的話術懶人包的人',
  '手上還沒有任何專業或服務可以賣的人——<span class="nb">你聽了也用不上，</span><span class="nb">會浪費你的時間</span>',
  '認為「讓人願意付錢」這件事本身很髒的人——<span class="nb">那我們價值觀不同</span>',
  '喜歡強迫推銷、而且覺得那樣才有效的人——<span class="nb">這套課教的是</span><span class="nb">完全相反的方向</span>',
];

/* 怎麼進來。健檢與諮詢都免費，而且明講——不講的話這兩步看起來像兩道門檻。 */
const how = [
  { n: 1, name: '免費影響力健檢', here: true,
    body: '12 題，大約三分鐘。量出四塊肌肉現在的樣子，看出先練哪塊最有感。' },
  { n: 2, name: '免費 1v1 諮詢', here: false,
    body: '線上 60 分鐘，不收費。我們會先聽你的現況，再把卡住的地方指出來。<span class="nb">不適合會直接說，</span><span class="nb">不會硬推。</span>' },
  { n: 3, name: '開課，一週一個模組', here: false,
    body: '錄播自己安排時間看、健身房每天打卡、討論課對練。班級 20 人以內，課前課後各量一次。' },
];

/* ⚠️ 不放價格：定價是諮詢現場攤開狀況之後才講的事，不在 LP 上比價（03-產品體系總覽 §C）。
   ⭐ 2026-10-24：這份開始也餵 §06 課程結構的兩張覆蓋卡——所以多了 upto（跟 range 是同一件事
      的兩種形式，給覆蓋條畫幾格用）。要改課程範圍兩邊都要改。 */
const courses = [
  { name: '超引力顧問課', range: 'L1–L8', upto: 8, dim: 'T',
    stages: '鍛鍊段＋放大段', who: '一對一還沒跑順，講完之後對方沒有下一步。' },
  { name: '超引力公眾演說課', range: 'L1–L13', upto: 13, dim: 'I',
    stages: '鍛鍊段＋放大段＋演說段', who: '一對一已經會了，卡在一次只能面對一個人。' },
];
const TOTAL = 13;

/* 三段 L1–L13。段落說明三句搬自已退役的 /courses/，一字不動。
   from／to 畫薄片階梯用，code 給人讀——同一件事的兩種形式，改範圍要兩邊同步。

   lessons ＝ 每一段的課表。真相＝productkit/1-手冊（內部）/15-課程梳理-L1-L12對到大包裝.md
   （檔名是舊的，裡面已經是 L1–L13；該檔 §85 說「檔名維持舊名，另案處理」）。
   ⚠️ L1–L8 這八個名字是老師 2026-10-17 逐堂裁定的定稿版，Skool 課程樹也用這八句，
      一個字都不要改；要改回去改那份梳理表，再同步過來。
   ⚠️ L9–L13 還沒有定稿課名，這裡填的是梳理表 §1 的「主題／一句話」欄，不是我自己編的。
      其中 L12 整堂「尚待老師拍板」（梳理表 §47）——拍板後這一列可能整列換掉。
      課名定稿之後回來換成定稿句。 */
const stages = [
  { from: 1, to: 4, code: 'L1–L4', name: '鍛鍊段',
    body: '一課一塊肌肉。L1 練吸引、L2 練信任、L3 練專業、L4 練推進，四堂涵蓋十二個小肌群。這一段練的是單點零件，目的是先讓每一塊都動得起來。',
    lessons: [
      { n: 1, dim: 'A', t: '創造 PR99% 的超引力場' },
      { n: 2, dim: 'T', t: '存入 3 層次的信任資產' },
      { n: 3, dim: 'P', t: '做出 0 比價的專業體驗' },
      { n: 4, dim: 'I', t: '練成 主動 +1 的感召成交' },
    ] },
  { from: 5, to: 8, code: 'L5–L8', name: '放大段',
    body: '把四塊肌肉串成你自己的一對一路徑。同樣是那四塊，但這裡練的是怎麼在一場真實的對話裡把它們接起來。',
    lessons: [
      { n: 5, dim: '四塊', t: '跑通 4in1 超引力顧問腳本' },
      { n: 6, dim: '四塊', t: '挑出 6 選 1 的甜蜜變現路徑' },
      { n: 7, dim: 'T', t: '養熟 7×11×4 的成交水溫' },
      { n: 8, dim: 'T', t: '守住 3 不賣的成交初心' },
    ] },
  { from: 9, to: 13, code: 'L9–L13', name: '演說段',
    body: '把同一條路搬上舞台。從一對一換到一對多，<span class="nb">肌肉沒變，</span><span class="nb">動作變了。</span>',
    lessons: [
      { n: 9, dim: 'A', t: '銷講開場：一開口就讓全場願意聽' },
      { n: 10, dim: 'P', t: '舞台版招牌動作：讓每個乾貨都有體驗感' },
      { n: 11, dim: 'I', t: '銷講收單：收單不是逼，是送禮物' },
      { n: 12, dim: '四塊', t: '三種長度的講稿：5 分、30 分、1.5 小時' },
      { n: 13, dim: 'I', t: '公眾演說大師之路（含畢業考核）' },
    ] },
];

/* 每一課做出來的那一份東西。真相＝productkit/4-學習單/交付物/L{n}-*.md 的開頭一句話，
   照抄不改寫（只補句末句號）。規格在同夾的 00-交付物規格.md。
   ⚠️ 目前實際存在的是 L1–L7 七份，所以這裡就只列七份——L8 以後還沒做出來，不補空殼。
      做好了再加，不要先寫一個看起來有的。
   ⚠️ tag 是維度標籤；L5／L6 是四塊一起跑、L7 是 T＋I，這幾張不吃 ATPI 單色。 */
const kits = [
  { l: 'L1', dim: 'A', tag: 'A 吸引', name: '超引力牛肉庫',
    s: '把你創造過的「結果」分五類收好，隨時端得出來——這是你整套溝通的彈藥庫。' },
  { l: 'L2', dim: 'T', tag: 'T 信任', name: '信賴感提問集',
    s: '把你的問句照「皮→肉→骨」三層收成一本，現場照著問——這是信任這塊肌肉唯一可以事先備好、上場照唸的東西。' },
  { l: 'L3', dim: 'P', tag: 'P 專業', name: '超引力圖像化收單圖',
    s: '把你的服務畫成 3–4 格、當著他的面畫一次——讓「你有沒有料」從用聽的，變成用看的。' },
  { l: 'L4', dim: 'I', tag: 'I 推進', name: '被動跟進乾貨磁鐵',
    s: '做一個「他拿了會用、用了會回頭找你」的東西，配一句讓他回來的說法——這是被拒之後，唯一還在替你工作的東西。' },
  { l: 'L5', dim: null, tag: '四塊一起', name: '超引力 1v1 變現腳本',
    s: '把 60 分鐘的諮詢拆成一段一格小肌群、一段一個看得見的過關訊號。' },
  { l: 'L6', dim: null, tag: '四塊一起', name: '個人甜蜜變現路徑分析報告',
    s: '把健檢分數變成一條你實際會走的路——這一份不是給你答案，是讓你第一次看見自己的衝突。' },
  { l: 'L7', dim: null, tag: 'T＋I', name: '超引力顧客關係表',
    s: '把你想推進的每一段關係放進同一張表，用「他現在幾度」和「我們走到哪」定位。' },
];

const faq = [
  { q: '1v1 諮詢真的免費嗎？要準備什麼？',
    a: '免費，線上 60 分鐘。你不用準備任何資料，先做一次免費的影響力健檢就夠了，我們會拿你的結果一起看。諮詢不是銷售會議，不適合我們會直接說。' },
  { q: '我不是業務，這套課對我有用嗎？',
    a: '有用。ATPI 四塊影響力肌肉練的是讓別人理解你、願意跟你一起做，這件事在提案、諮詢、面試、帶團隊、家庭對話裡都在發生。成交在這裡的意思是讓人願意行動，不限於買賣。' },
  { q: '我已經上過行銷課跟話術課了，這有什麼不一樣？',
    a: '話術是一句一句的，學回來當下有用，過兩週又打回原形，因為換掉的是話，沒有換掉底下的能力。這套課不給你腳本，它把「一個人為什麼會願意跟你買」拆成四塊可以量、可以練、可以驗收的肌肉，一課練一塊。' },
  { q: '「成交」這個詞會不會太業務導向？',
    a: '成交在這裡的意思是讓人願意行動，不是話術與施壓。這套課從頭到尾的立場是：先有真實與信任，行動才會發生。技巧是工具，真實才是地基。' },
  { q: '要花多少時間？我很忙。',
    a: '一個模組等於一週。乾貨錄播自己安排時間看，直播討論課固定時段，課間在影響力健身房打卡練 2 到 3 天，一天一個小動作。回放一年、討論會籍一年，一年內都可以回來重看、回來參加討論課。' },
  { q: '超引力成交學有幾種課？我要怎麼知道自己適合哪一個？',
    a: '對外只有兩個：超引力顧問課，內容是 L1 到 L8，包含鍛鍊段與放大段；超引力公眾演說課，內容是 L1 到 L13，也就是前面全部再加上演說段。這個選擇不會由你自己在網頁上決定，它會在諮詢現場把你的狀況攤開來看過之後才決定，我們不預設賣哪一個。' },
  { q: '超引力成交學跟影響力健身房是什麼關係？',
    a: '影響力健身房是館名，也是母品牌；超引力成交學是這間館裡的教練課系列。就像健身房本身跟教練課的關係。日後還會有別的教練課掛在同一個館名下。' },
  { q: '報名之後可以退嗎？', a: '報名後 7 天內可退款。' },
];

/* ═══ 站表：這頁的骨架 ═══
   這頁有十段，原本每一段都是「眉標→大標→導言→一個框」往下堆，捲到中段就沒有任何線索
   知道自己走了多遠。所以整頁當成一條「站」來排：每一站有編號、以及軌上的一個點。
   編號與軌上的點都從這一份清單長出來，不在 HTML 裡各寫一次。
   ⚠️ label 全部取自頁面上原本就有的字，不另外編新文案。
   開場不計號（它是入口不是站），終點另外標（它是要按的，不是要讀的）。 */
const stops = [
  { id: 'g-open', label: '超引力場' },
  { id: 'g-ask', label: '都不是' },
  { id: 'g-pain', label: '四種人' },
  { id: 'g-coach', label: '教你的人是誰' },
  { id: 'g-order', label: '有順序的' },
  { id: 'g-get', label: '你會帶走' },
  { id: 'g-ladder', label: '怎麼安排' },
  { id: 'g-kit', label: '你會做出來的' },
  { id: 'g-proof', label: '練過的人' },
  { id: 'g-fit', label: '誰適合來' },
  { id: 'g-how', label: '怎麼進來' },
  { id: 'g-faq', label: '常見問題' },
];
const END = { id: 'g-cta', label: '預約諮詢' };
const no = (id: string) => String(stops.findIndex((s) => s.id === id)).padStart(2, '0');

const url = `${SITE.url}/gravity/`;
const schema = [
  {
    '@type': 'WebPage', '@id': `${url}#webpage`, url, name: title, description,
    inLanguage: 'zh-Hant-TW',
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: { '@id': `${SITE.url}/#organization` },
  },
  ...courses.map((c) => ({
    '@type': 'Course',
    '@id': `${url}#${c.range.toLowerCase().replace(/[^a-z0-9]/g, '')}`,
    name: c.name,
    description: `${c.stages}，內容涵蓋 ${c.range}。適合的情況：${c.who}`,
    inLanguage: 'zh-Hant-TW',
    provider: { '@id': `${SITE.url}/#organization` },
    url,
  })),
  {
    '@type': 'FAQPage', '@id': `${url}#faq`,
    mainEntity: faq.map((f) => ({
      '@type': 'Question', name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  schema={schema}
  bodyClass="theme-dark"
  themeColor="#0c131e"
>
  <!-- ═══ 場：整頁的底 ═══
       這頁叫超引力，底就不做成一塊平板。做成一個有中心的場：中心在視窗正中（「你」永遠
       在自己那個場的中心），往下捲環會放大、十二道刻度會轉——捲動因此不只是換段落，
       是往場裡面落。十二道刻度就是十二條小肌群，數量本身是語意。
       ⚠️ 這層只吃 --gy（整頁進度），不用 [data-px]：那套量的是元素自己穿過視窗，
          fixed 元素的 rect 不會動，算出來永遠同一個值。
       ⚠️ z-index 要比 .section-skew::before 的 -1 更低，否則斜切帶會被場壓住。 -->
  <div class="gfield" aria-hidden="true">
    <span class="gglow"></span>
    <svg class="grings" viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice">
      {[68, 112, 156, 200, 244].map((r) => (
        <circle cx="200" cy="200" r={r} fill="none" stroke="#E8C89A" stroke-width=".7" />
      ))}
      <g class="gticks">
        {Array.from({ length: 12 }, (_, i) => (
          <line x1="200" y1="-56" x2="200" y2="-30" stroke="#E8C89A" stroke-width="1.6"
                transform={`rotate(${i * 30} 200 200)`} />
        ))}
      </g>
    </svg>
  </div>

  <!-- ═══ 軌：十站的里程尺 ═══
       頁首那條 .readbar 只講「還剩多少」，講不出「總共幾站、我在第幾站」。這條軌補後者：
       一點一站，全部先露出（未到的站不畫虛線也不上鎖，這頁的內容是可以先看的）。
       名字收在 hover 才出來——1280px 以下的螢幕容不下常駐的名字欄，而軌本身只有 15px 寬，
       任何寬度都擠不到內容。最後那一枚是終點不是站，所以是金色空心環，形狀就跟站不一樣。 -->
  <nav class="spine" aria-label="頁內導覽">
    <ul>
      {stops.map((s) => (
        <li><a href={`#${s.id}`} data-stop={s.id}><i aria-hidden="true"></i><span class="sp-l">{s.label}</span></a></li>
      ))}
      <li class="sp-end"><a href={`#${END.id}`} data-stop={END.id}><i aria-hidden="true"></i><span class="sp-l">{END.label}</span></a></li>
    </ul>
  </nav>

  <!-- ═══ Hero ═══ -->
  <section class="hero" id="g-open">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="prokick"><span>SUPER ATTRACTION<i>·</i><b>專業工作者的成交關鍵</b></span></p>
        <h1>明明很專業，<br /><span class="hl">為什麼沒人買單？</span></h1>
        <!-- ⚠️ 中文段落一律寫成單行：原始碼換行會變成一個空白，在中文裡會看成排版破洞。 -->
        <p class="lead hero-lead">業務、職人、講師、中小企業主——你不是不夠專業，只是沒有人教過你怎麼把價值講出來。</p>

        <div class="btn-row hero-cta">
          <a class="btn btn-main" href={LINKS.booking} data-cta="booking" data-cta-position="lp-hero">
            預約免費 1v1 諮詢
          </a>
          <a class="btn btn-sub" href={LINKS.quiz} data-cta="quiz" data-cta-position="lp-hero">
            先做 3 分鐘免費影響力健檢
          </a>
        </div>
        <!-- 第一屏就把人名放出來：這頁要先賣人，名字擺到第 3 站才出現就太晚了 -->
        <p class="hero-meta"><span>🧑‍🏫 <b>平凡人光頭</b>・ATPI 溝通 4 大肌肉框架創始人</span><span>🎤 200+ 場演講・輔導 2000+ 位學員</span><span>💬 諮詢<b>免費</b>・不適合會直接說</span></p>
      </div>

      <!-- 圖①超引力場：中心是你，客戶在外圈繞，每跨進一道軌就是一塊肌肉在作用。
           四道軌由外而內＝A→T→P→I，結果句鎖字典（想靠近／願意說／要找你／願意動）。
           軌的缺口一律開在正上方，缺口就是標籤的位置——由上往下讀就是客戶走近的順序。
           ⚠️ 方向只靠「箭頭＋漸層」那個頻道講（24 §3.9 三頻道）；軌線本身不做虛線，
              虛線在這套語言裡已經被「還沒到」佔走了。 -->
      <aside class="field card" aria-label="超引力場示意：客戶在外圈繞著你走，每跨進一道軌就更近一步，由外而內是吸引、信任、專業、推進四塊肌肉">
        <p class="sec">GRAVITY FIELD · <b>超引力場</b></p>
        <div class="field-fig" aria-hidden="true">
          <svg viewBox="0 0 360 360" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="pull" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="var(--i)" stop-opacity=".14" />
                <stop offset="1" stop-color="var(--i)" stop-opacity=".9" />
              </linearGradient>
            </defs>

            <!-- 四道軌（上方留缺口給標籤） -->
            <path d="M218 32.8 A154 154 0 1 1 142 32.8" fill="none" stroke="var(--a)" stroke-width="1.5" opacity=".38" />
            <path d="M218 64 A124 124 0 1 1 142 64" fill="none" stroke="var(--t)" stroke-width="1.5" opacity=".38" />
            <path d="M218 96 A94 94 0 1 1 142 96" fill="none" stroke="var(--p)" stroke-width="1.5" opacity=".38" />
            <path d="M218 130.5 A64 64 0 1 1 142 130.5" fill="none" stroke="var(--i)" stroke-width="1.5" opacity=".38" />

            <!-- 繞著你走的人：一個人一枚，顏色＝他現在停在哪一圈（pro 引力場同款讀法） -->
            <g class="orbit">
              <g transform="translate(298,281)"><g class="tok">
                <circle r="13" fill="var(--card-warm)" stroke="var(--a)" stroke-width="1.5" />
                <circle cy="-3.6" r="3.7" fill="var(--a)" />
                <path d="M-6.4 7.2a6.4 6.4 0 0 1 12.8 0z" fill="var(--a)" />
              </g></g>
              <g transform="translate(35,129)"><g class="tok">
                <circle r="13" fill="var(--card-warm)" stroke="var(--a)" stroke-width="1.5" />
                <circle cy="-3.6" r="3.7" fill="var(--a)" />
                <path d="M-6.4 7.2a6.4 6.4 0 0 1 12.8 0z" fill="var(--a)" />
              </g></g>
              <g transform="translate(325,129)"><g class="tok">
                <circle r="13" fill="var(--card-warm)" stroke="var(--a)" stroke-width="1.5" />
                <circle cy="-3.6" r="3.7" fill="var(--a)" />
                <path d="M-6.4 7.2a6.4 6.4 0 0 1 12.8 0z" fill="var(--a)" />
              </g></g>
              <g transform="translate(104,280)"><g class="tok">
                <circle r="13" fill="var(--card-warm)" stroke="var(--t)" stroke-width="1.5" />
                <circle cy="-3.6" r="3.7" fill="var(--t)" />
                <path d="M-6.4 7.2a6.4 6.4 0 0 1 12.8 0z" fill="var(--t)" />
              </g></g>
              <g transform="translate(287,120)"><g class="tok">
                <circle r="13" fill="var(--card-warm)" stroke="var(--t)" stroke-width="1.5" />
                <circle cy="-3.6" r="3.7" fill="var(--t)" />
                <path d="M-6.4 7.2a6.4 6.4 0 0 1 12.8 0z" fill="var(--t)" />
              </g></g>
              <g transform="translate(113,115)"><g class="tok">
                <circle r="13" fill="var(--card-warm)" stroke="var(--p)" stroke-width="1.5" />
                <circle cy="-3.6" r="3.7" fill="var(--p)" />
                <path d="M-6.4 7.2a6.4 6.4 0 0 1 12.8 0z" fill="var(--p)" />
              </g></g>
              <g transform="translate(174,246)"><g class="tok">
                <circle r="13" fill="var(--card-warm)" stroke="var(--i)" stroke-width="1.5" />
                <circle cy="-3.6" r="3.7" fill="var(--i)" />
                <path d="M-6.4 7.2a6.4 6.4 0 0 1 12.8 0z" fill="var(--i)" />
              </g></g>
            </g>

            <!-- 軌標壓在人上面：底色擋片是 pro .gring i 的同一招，人會從標籤後面繞過去 -->
            <g class="ring-tag">
              <rect x="152" y="26" width="56" height="15" rx="4" fill="var(--card)" />
              <rect x="152" y="57" width="56" height="15" rx="4" fill="var(--card)" />
              <rect x="152" y="89" width="56" height="15" rx="4" fill="var(--card)" />
              <rect x="152" y="123" width="56" height="15" rx="4" fill="var(--card)" />
              <text x="180" y="37" font-size="11" font-weight="700" fill="var(--a)" text-anchor="middle">A 想靠近</text>
              <text x="180" y="68" font-size="11" font-weight="700" fill="var(--t)" text-anchor="middle">T 願意說</text>
              <text x="180" y="100" font-size="11" font-weight="700" fill="var(--p)" text-anchor="middle">P 要找你</text>
              <text x="180" y="134" font-size="11" font-weight="700" fill="var(--i)" text-anchor="middle">I 願意動</text>
            </g>

            <!-- 走到你面前的那一個：漸層由淡到亮＝方向 -->
            <path
              d="M24 73 Q4 140 31 195 Q48 250 90 272 Q135 296 180 287 Q222 278 239 241 Q252 214 241 193 Q234 180 222 176"
              fill="none" stroke="url(#pull)" stroke-width="2.5" stroke-linecap="round"
            />
            <polygon points="219,173.3 229.8,176.3 223.2,183.7" fill="var(--i)" />
            <!-- 起點刻意擺在最外圈之外：.orbit 會轉，這一枚不轉，擺在軌上遲早會疊到人 -->
            <g transform="translate(24,73)">
              <circle r="13" fill="var(--card-warm)" stroke="var(--i)" stroke-width="2" />
              <circle cy="-3.6" r="3.7" fill="var(--i)" />
              <path d="M-6.4 7.2a6.4 6.4 0 0 1 12.8 0z" fill="var(--i)" />
            </g>

            <!-- 中心＝你。外圈四段弧＝場是這四塊肌肉撐出來的 -->
            <path d="M155.4 155.7 A36 36 0 0 1 204.6 155.7" fill="none" stroke="var(--a)" stroke-width="3" stroke-linecap="round" />
            <path d="M206.3 157.4 A36 36 0 0 1 206.3 206.6" fill="none" stroke="var(--t)" stroke-width="3" stroke-linecap="round" />
            <path d="M204.6 208.3 A36 36 0 0 1 155.4 208.3" fill="none" stroke="var(--p)" stroke-width="3" stroke-linecap="round" />
            <path d="M153.7 206.6 A36 36 0 0 1 153.7 157.4" fill="none" stroke="var(--i)" stroke-width="3" stroke-linecap="round" />
            <circle cx="180" cy="182" r="29" fill="var(--card-warm)" />
            <text x="180" y="178" font-size="14" font-weight="700" fill="var(--ink)" text-anchor="middle">你</text>
            <text x="180" y="195" font-size="9" font-weight="700" fill="var(--i-deep)" text-anchor="middle">YOU</text>
          </svg>
        </div>
        <p class="field-note">引力是結果，不是方法。四塊肌肉一塊一塊練強，場就成形——<span class="nb">對的人會自己一圈一圈繞近，</span><span class="nb">你不用追著跑。</span></p>
        <div class="rule4" role="presentation"></div>
      </aside>
    </div>
  </section>

  <!-- ═══ 01 四句自問 → 都不是 ═══ -->
  <section class="section section-skew" id="g-ask">
    <div class="wrap">
      <header class="shead">
        <span class="snum num" aria-hidden="true">{no('g-ask')}</span>
        <p class="kicker">先把問題放對地方</p>
        <h2 class="reveal"><span class="nb">我這麼專業，</span><span class="hl"><span class="nb">為什麼</span><span class="nb">日子還是這麼緊？</span></span></h2>
        <p class="lead sec-lead reveal" style="--rd:.06s">這句話，我在 2000 多位學員身上聽過無數次。你花了三年拿到那張證照，或者十年，把手藝磨到自己都滿意。同行說你厲害，客戶也說你厲害。</p>
      </header>

      <p class="body-p">可是月底打開帳戶，數字跟三年前差不多。更不甘心的是——<b>你已經試過了。</b>再去進修一張證照、<span class="nb">把作品集整個重做、</span><span class="nb">降價、</span><span class="nb">每天發限動、</span><span class="nb">上行銷課、</span><span class="nb">背話術、</span><span class="nb">找人做網站……</span></p>

      <!-- 客戶那一句單獨拉出來。它是整頁的起點，混在段落裡就沒有重量了。 -->
      <p class="client-line reveal">
        <span>然後呢？客戶聽完還是那一句</span>
        <b>「我再想想。」</b>
      </p>

      <!-- 四個問號：每一格是一句你問過自己的話。問號用描邊字，是背景不是主角。 -->
      <p class="asks-k">於是你開始懷疑一件事：<b>是不是專業根本不值錢？</b></p>
      <div class="asks">
        {asks.map((a, i) => (
          <div class="ask reveal" data-dim={a.dim} style={`--rd:${i * 0.06}s`}>
            <span class="ask-mark num" aria-hidden="true">？</span>
            <p class="ask-q">「{a.q}」</p>
          </div>
        ))}
      </div>

      <div class="verdict reveal">
        <p class="verdict-k">我可以直接告訴你答案</p>
        <p class="verdict-big">都不是<span class="jp">。</span></p>
        <div class="rule4" role="presentation"></div>
        <p class="punch">不是專業不值錢。<br /><span class="hl">是專業不會自己開口。</span></p>
      </div>
    </div>
  </section>

  <!-- ═══ 02 四種人，同一條鏈 ═══ -->
  <section class="section" id="g-pain">
    <div class="wrap">
      <header class="shead">
        <span class="snum num" aria-hidden="true">{no('g-pain')}</span>
        <p class="kicker">這一頁是寫給誰看的</p>
        <h2 class="reveal">四種人，<span class="hl">卡在同一個地方</span></h2>
        <p class="lead sec-lead reveal" style="--rd:.06s">業務、職人、講師、中小企業主。做的事不一樣，可是講起自己卡住的地方，用的是同一種句子。</p>
      </header>

      <div class="pains">
        {pains.map((p, i) => (
          <article class="pain reveal" data-dim={p.dim} style={`--rd:${i * 0.05}s`}>
            <p class="pain-role">{p.role}</p>
            <p class="pain-q">「{p.quote}」</p>
            <p class="pain-who">{p.who}</p>
          </article>
        ))}
      </div>

      <p class="pains-note">這四句話不是四種毛病，是同一條鏈斷在四個不同的位置。<b><span class="nb">而這四件事都是可以練的，</span><span class="nb">不是天賦</span></b>——沒有人是「天生會」的，只是有人練過，有人沒有。</p>
    </div>
  </section>

  <!-- ═══ 03 教你的人是誰 ═══
       ⭐ 這一站原本排在第 9，2026-10-01 搬到第 3：這頁寫給陌生人，要先賣人再講服務。
          一個人要先相信「講這話的人憑什麼」，才聽得進後面的方法。
       站頭橫跨滿寬，照片與故事排在底下：站頭要是縮在右欄裡，那條線就只剩半截，
       十站的里程尺會在這一站斷掉。 -->
  <section class="section section-skew" id="g-coach">
    <div class="wrap">
      <header class="shead">
        <span class="snum num" aria-hidden="true">{no('g-coach')}</span>
        <p class="kicker">教你的人是誰</p>
        <h2 class="reveal">平凡人光頭，<span class="hl">不是天生會講的人</span></h2>
        <p class="lead coach-lead reveal" style="--rd:.06s">本名徐哲彥。<span class="nb">影響力健身房創辦人、</span><span class="nb">ATPI 溝通 4 大肌肉框架創始人。</span>名字裡留著「平凡人」三個字，因為這套方法的前提就是：<span class="nb">影響力不是天賦，</span><span class="nb">是一塊可以練的肌肉。</span></p>
      </header>

      <div class:list={['coach', { 'has-photo': !!FOUNDER_PHOTO }]}>
        {FOUNDER_PHOTO && (
          <figure class="coach-photo">
            <img src={FOUNDER_PHOTO} alt="平凡人光頭（徐哲彥）——影響力健身房創辦人" width="380" height="450" loading="lazy" />
            <div class="rule4" role="presentation"></div>
          </figure>
        )}
        <!-- 故事照抄 §5，一字不動。它是這頁最重的一塊，不改寫、不壓縮成三個 bullet。 -->
        <div class="story">
          <p class="story-open">十年前，我家裡背了兩千萬的債。</p>
          <p>那不是我欠的，但它就在那裡。我很清楚一件事：<b><span class="nb">沒有人會來救我，</span><span class="nb">我只能為自己的未來</span><span class="nb">拼出一條路。</span></b></p>
          <p>於是我把手上最後 100 萬拿去繳學費，飛到對岸去學「怎麼開口」。</p>
          <p>回來之後我做的第一件事，是隔著一個海峽，簽下一個從沒見過面的陌生客戶——<b class="hl">120 萬</b>。</p>
          <p class="story-q">那一刻我確定了一件事：<b>這不是天賦，這有公式。</b></p>
          <p>這些年我在自己身上投了大約 <b>200 萬</b>的學費——溝通與銷講 100 萬、身心靈 25 萬、財商 20 萬，加上數不清的小課。</p>
          <p>我不是天生會講的人。我只是很早就決定一件事：<b>與其省下學費，不如把自己變成值得被投資的人。</b></p>
          <p>我到現在都不覺得自己是「天生會講的人」。我只是把「一個人為什麼會願意跟你買」，拆成了<b>可以練的東西</b>。</p>
        </div>
      </div>

      <!-- 六條驗證：排成規格列不排成卡片。這六條的關係是「同一個公式在六種場景跑過」，
           六張一樣大的卡會讀成六個選項。 -->
      <p class="feats-k">後來的十年，我把這個公式反覆驗證</p>
      <ul class="feats">
        {feats.map((f) => (
          <li data-dim={f.dim}>
            <span class="feat-l">{f.l}</span>
            <span class="feat-s" set:html={f.s} />
          </li>
        ))}
      </ul>

      <p class="coach-belief">我相信一件事：<b>影響力不是天賦，是一塊可以練的肌肉。</b><span class="nb">把它練強，</span><span class="nb">不是為了說贏誰、</span><span class="nb">壓過誰，</span>是為了讓你有能力，<span class="nb">把你真正的價值，</span><span class="nb">送進你想幫的那個人心裡。</span></p>
      <a class="coach-more" href="/about/">認識平凡人光頭的故事 →</a>

      <!-- ═══ 中途出口 ① ═══ 見 .jump 的註解：這裡是「信了人」那一拍 -->
      <div class="jump reveal">
        <p class="jump-t">看到這裡已經想談了？<b><span class="nb">那就不用把整頁讀完。</span></b></p>
        <a class="btn btn-main" href={LINKS.booking} data-cta="booking" data-cta-position="lp-mid-coach">
          預約免費 1v1 諮詢
        </a>
      </div>
    </div>
  </section>

  <!-- ═══ 04 不是加法，是有順序的 ═══
       這頁只留這一張方法論圖。12 小肌群牆與四塊肌肉在 /method/——
       同一張圖不在兩頁各畫一次。L1–L13 的課表在下面 §06，不在這裡。 -->
  <section class="section" id="g-order">
    <div class="wrap">
      <header class="shead">
        <span class="snum num" aria-hidden="true">{no('g-order')}</span>
        <p class="kicker">真正卡住的地方</p>
        <h2 class="reveal">一個人願不願意跟你買，<span class="hl">不是加法，是有順序的</span></h2>
        <p class="lead sec-lead reveal" style="--rd:.06s">我們都以為這件事是加法——<span class="nb">專業再多一點、</span><span class="nb">內容再好一點、</span><span class="nb">證照再多一張，</span><span class="nb">客戶就會買。</span>不是。這四件事有先後。</p>
      </header>

      <!-- 橫向鏈：五個狀態、四段推力。每段推力＝一塊肌肉，斷掉會怎樣寫在下面。 -->
      <div class="chain" role="img" aria-label="對話從你開口到他真的做，中間由吸引、信任、專業、推進四塊肌肉推動">
        {chain.map((c, i) => (
          <div class="ch" data-dim={c.dim}>
            <span class="ch-from">{c.from}</span>
            {/* 終點籤：桌機絕對定位到最右，手機退成靜態，所以要緊跟在起點籤後面才讀得出 from→to */}
            {i === chain.length - 1 && <span class="ch-to">{c.to}</span>}
            <span class="ch-arrow" aria-hidden="true">
              <i class="ch-slice"></i>
              <b class="ch-m">{c.dim} · {c.muscle}</b>
            </span>
            <span class="ch-broke">斷在這裡：{c.broke}</span>
          </div>
        ))}
      </div>

      <p class="chain-note"><b>前面那一關沒過，後面再用力都不算數。</b><span class="nb">信賴感是門檻，</span><span class="nb">門檻沒過，</span><span class="nb">專業是負分。</span><span class="nb">四塊不是加起來，</span>是<b>相乘</b>——<span class="nb">任何一塊趨近於零，</span><span class="nb">另外三塊再高，</span><span class="nb">整條鏈都會停在那裡。</span></p>

      <!-- 對照表：三欄照搬 §4。這是整頁最「消費者語言」的一塊——
           左邊是他親眼看到的事，中間是他自己下的錯誤診斷，右邊才是我們的說法。
           窄螢幕退成一欄，欄名改用每一格自己的前綴（CSS ::before），不留一張橫捲的表。 -->
      <p class="diag-k">對照一下，你是哪一種</p>
      <div class="diag">
        <div class="diag-h" aria-hidden="true">
          <span>你看到的</span><span>你以為的原因</span><span>真正該練的</span>
        </div>
        {diag.map((d) => (
          <div class="diag-r" data-dim={d.dim}>
            <span class="d-see">{d.see}</span>
            <span class="d-think">「{d.think}」</span>
            <span class="d-need" set:html={d.need} />
          </div>
        ))}
      </div>
      <p class="diag-note">而大部分專業工作者，<span class="nb">把 100% 的力氣花在第三項。</span><span class="nb">你確實把自己講懂了，</span>但你證明的是<span class="nb">「這件事有解」，</span>不是<span class="nb">「只有你能解」。</span><b><span class="nb">他聽懂了，</span><span class="nb">點頭了，</span><span class="nb">然後去找了別人。</span></b></p>
    </div>
  </section>

  <!-- ═══ 05 你手上會多什麼 ═══
       這四條排成規格列，不排成 2×2 卡片：正上方的對照表已經是一個三欄的格子，
       底下再來一組帶框的四格，兩塊會長得像同一件事重講一次。 -->
  <section class="section section-skew" id="g-get">
    <div class="wrap">
      <header class="shead">
        <span class="snum num" aria-hidden="true">{no('g-get')}</span>
        <p class="kicker">你會帶走什麼</p>
        <h2 class="reveal">練完之後，<span class="hl">你手上會多什麼</span></h2>
        <p class="lead sec-lead reveal" style="--rd:.06s">這套課不給你「一句話就讓對方買單」的懶人包。它給你四塊可以量、可以練、可以驗收的肌肉。</p>
      </header>

      <!-- 用 ol 不用 dl：這四條是有編號的一份清單，而且編號要排進左邊那一欄。
           dl 裡的 div 依規格只能裝 dt／dd，塞不進放號碼的 span。 -->
      <ol class="designs">
        {gets.map((g, i) => (
          <li class="design reveal" style={`--rd:${i * 0.06}s`}>
            <span class="dnum num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="d-t" set:html={g.t} />
            <p class="d-s" set:html={g.s} />
          </li>
        ))}
      </ol>

      <p class="gets-note">想看十三個模組怎麼排？<a href="#g-ladder"><span class="nb">課表就在下一站</span></a>。<span class="nb">四塊肌肉底下那十二條小肌群，</span><a href="/method/"><span class="nb">在方法頁</span></a>。</p>
    </div>
  </section>

  <!-- ═══ 06 課程結構：三段 L1–L13 ═══
       ⭐ 2026-10-24 新增：這一站是退役的 /courses/ 搬過來的，跟 §04 方法論接起來——
          先看順序（§04）、再看怎麼安排（§06）、再看會做出什麼（§07）、才看證明（§08）。
       ⚠️ 階梯、段落說明、兩張覆蓋卡的字句一字不動照搬。課名真相在 frontmatter 的註解。
       ⚠️ 前後都是 section-skew，這一站自己退回 section——三段連續斜切會暈。 -->
  <section class="section" id="g-ladder">
    <div class="wrap">
      <header class="shead">
        <span class="snum num" aria-hidden="true">{no('g-ladder')}</span>
        <p class="kicker">怎麼安排</p>
        <h2 class="reveal">三個段落，<span class="hl">十三個模組</span></h2>
        <p class="lead sec-lead reveal" style="--rd:.06s">一個模組等於一週，<span class="nb">全系列從 L1 排到 L13。</span></p>
      </header>

      <!-- 三段 L1–L13 的階梯：欄寬跟模組數成正比（4:4:5）、片高從 L1 一路爬到 L13。
           階梯感是版面在講的事，不是裝飾——不要排成三張並排的卡。 -->
      <ol class="ladder">
        {stages.map((s, i) => (
          <li class="lstage reveal" style={`--rd:${0.1 + i * 0.08}s`}>
            <ul class="lmods" aria-hidden="true">
              {Array.from({ length: s.to - s.from + 1 }).map((_, k) => {
                const n = s.from + k;
                return <li style={`--h:${34 + (n - 1) * 6}px; --lo:${(0.28 + (n - 1) * 0.045).toFixed(3)}`}><i></i><b>L{n}</b></li>;
              })}
            </ul>
            <p class="lstage-code">{s.code}</p>
            <h3 class="lstage-name">{s.name}</h3>
            <p class="lstage-body" set:html={s.body} />

            {/* 課表直接長在自己那一段底下，不另開一張十三列的表：
                段名在上面講過一次，再列一張表就要讀兩次才對得起來。
                維度籤借 ATPI 四色，跟 §04 的四個斷點是同一組顏色——
                讀者在這裡才會發現課表就是那四塊肌肉的排程。 */}
            <ol class="llist">
              {s.lessons.map((m) => (
                <li class="lrow">
                  <span class="ll-n num">L{m.n}</span>
                  <span class="ll-d" data-dim={m.dim.length === 1 ? m.dim : undefined}>{m.dim}</span>
                  <span class="ll-t">{m.t}</span>
                </li>
              ))}
            </ol>
          </li>
        ))}
      </ol>

      <!-- 兩個課的覆蓋條：兩個課攤在同一條十三格的尺上，差別用看的就知道，
           不用讀完兩段文字再自己比對。 -->
      <h3 class="ladder-k">兩個課，怎麼選</h3>
      <p class="ladder-sub">對外只有這兩個，<span class="nb">中間的段落不單獨販售。</span></p>
      <div class="grid courses-grid">
        {courses.map((c, i) => (
          <article class="card muscle reveal lift" data-dim={c.dim} style={`--rd:${0.1 + i * 0.08}s`}>
            <span class="muscle-tag">{c.range}</span>
            <h3 class="course-name">{c.name}</h3>
            <p class="stages-line">{c.stages}</p>
            <div class="cov" aria-hidden="true">
              {Array.from({ length: TOTAL }).map((_, k) => (
                <i class:list={[{ on: k < c.upto }]}></i>
              ))}
            </div>
            <p class="course-who"><b>適合的情況</b><br />{c.who}</p>
          </article>
        ))}
      </div>
      <p class="ladder-note">這個選擇不會由你自己在網頁上決定。它會在<span class="nb">免費 1v1 諮詢</span>的現場，把你的狀況<span class="nb">攤開來看過之後</span>才決定——<span class="nb">我們不預設賣哪一個。</span></p>
    </div>
  </section>

  <!-- ═══ 07 你會做出來的東西 ═══
       ⭐ 2026-10-24 新增。上一站講的是「課怎麼排」，那是我們的時間表；這一站講的是
          「你手上會多出哪幾份東西」，那是他的。課綱在消費者眼裡是抽象的，交付物不是。
       ⚠️ 七張卡的那一句照抄 productkit/4-學習單/交付物/L{n}-*.md 的開頭，不重寫。
       ⚠️ 只有七份，因為目前就只做出七份（L1–L7）。不補 L8 以後的空殼。
       ⚠️ 不做成跟 §05「你會帶走」一樣的編號規格列——那一站是抽象好處，這一站是具體物件，
          長得一樣會讀成同一件事講兩次。這裡走卡片。 -->
  <section class="section section-skew" id="g-kit">
    <div class="wrap">
      <header class="shead">
        <span class="snum num" aria-hidden="true">{no('g-kit')}</span>
        <p class="kicker">你會做出來的</p>
        <h2 class="reveal">每一課的終點，<span class="hl">不是筆記</span></h2>
        <p class="lead sec-lead reveal" style="--rd:.06s">是一份你自己做出來、<span class="nb">下一場對話就能帶著用的東西。</span>課上完，<span class="nb">這幾份會留在你手上。</span></p>
      </header>

      <ul class="kits">
        {kits.map((k, i) => (
          <li class="kit reveal lift" data-dim={k.dim ?? undefined} style={`--rd:${i * 0.05}s`}>
            <div class="kit-h">
              <span class="kit-l num">{k.l}</span>
              <span class="kit-tag">{k.tag}</span>
            </div>
            <h3 class="kit-n">{k.name}</h3>
            <p class="kit-s">{k.s}</p>
          </li>
        ))}
      </ul>

      <!-- 三種做法與「完成線設得很低」照 00-交付物規格 §一／§二⑤ 的立場寫，
           這段是骨層：我們在意的是他有沒有開始動，不是交出來的東西好不好看。 -->
      <div class="kit-how">
        <p class="kit-how-t">每一份都有三種做法，<b>挑一種就好</b></p>
        <ul class="kit-ways">
          <li><b>丟給 AI</b>　每一份都附一段可以直接複製的提示詞</li>
          <li><b>自己手寫</b>　一張 A4 印得下，不用開電腦</li>
          <li><b>在影響力健身房打卡</b>　做完就記一塊肌肉，進度自己看得到</li>
        </ul>
        <p class="kit-how-n">「做完」這條線我們故意設得很低——<b><span class="nb">寧可一份粗的做完，</span><span class="nb">不要一份精緻的沒開始。</span></b><span class="nb">只要有改變就會出結果，</span><span class="nb">那才是你來的原因。</span></p>
      </div>
    </div>
  </section>

  <!-- ═══ 08 練過的人 ═══
       上面那份是文字結果（照抄來源的數字與原話），下面三張是 productkit 出好的見證卡原圖。
       卡片裡的原始對話／貼文截圖才是可信度來源，拆成 HTML 就只剩轉述。
       ⚠️ 圖是暖版，刻意讓它像實體卡疊在科技底上。
       ⚠️ alt 與引言只描述來源上真的有的字，不代擬。 -->
  <section class="section" id="g-proof">
    <div class="wrap">
      <header class="shead">
        <span class="snum num" aria-hidden="true">{no('g-proof')}</span>
        <p class="kicker">練過的人</p>
        <h2 class="reveal">他們後來，<span class="hl">怎麼了</span></h2>
        <p class="lead sec-lead reveal" style="--rd:.06s">不同行業、不同起點。共同點是：他們一開始也都覺得自己只是「不會推銷」。</p>
      </header>

      <ul class="results">
        {results.map((r) => (
          <li class="res">
            <p class="res-who">{r.who}</p>
            <p class="res-s" set:html={r.s} />
            {r.q && <p class="res-q">「{r.q}」</p>}
          </li>
        ))}
      </ul>

      <div class="grid grid-3 proof">
        {proof.map((p) => (
          <a class="proof-card" href={p.src} target="_blank" rel="noopener">
            <img src={p.src} alt={p.alt} width="1080" height="1350" loading="lazy" />
          </a>
        ))}
      </div>
      <p class="proof-note">點任一張可以放大，看卡片裡的原始對話與貼文截圖。</p>

      <!-- ═══ 中途出口 ② ═══ 見 .jump 的註解：這裡是「信了結果」那一拍 -->
      <div class="jump reveal">
        <p class="jump-t">他們都是從一次 60 分鐘的對話開始的。<b><span class="nb">那一次不收費。</span></b></p>
        <a class="btn btn-main" href={LINKS.booking} data-cta="booking" data-cta-position="lp-mid-proof">
