---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, LINKS, FOUNDER_PHOTO } from '../consts';

/* 「超引力成交學」方法論長頁（LP），取代舊的 lp.atpifit.com 系列。
   分工：這頁負責說服（公開、給陌生人看），/courses/retrain 負責收單（noindex、舊生專用）。

   ⚠️ 視覺＝科技版深色底（bodyClass="theme-dark"），這不是門面破例，是產品線區隔：
   影響力健身房＝館，暖版；超引力成交學＝實戰私教，科技版。色值真相＝
   consult-workshop/pro.html，變數層在 brand.css 的 body.theme-dark。

   ⚠️ 圖比字重要（全貌感規則）：能用圖講的就不要用段落講。這頁六張圖＝
   引力場／四個斷點流程／12 小肌群牆／L1–L13 全貌／一週迴路／入場到結業旅程。

   ⚠️ 作廢詞：一階／二階／三階／Level 1-3／引力式系列／8週·12週／1+1 系統／「〇〇力」／收割。
   ⚠️ 價值堆疊與定價話術是諮詢現場用的，不上 LP（03-產品體系總覽 §C）。
   ⚠️ L5–L13 沒有對外定案的模組名稱，不可自己編——全貌圖那幾格只露編號。 */

const title = '超引力成交學｜把成交練成四塊肌肉的教練課';
const description =
  '超引力成交學是影響力健身房的實戰私教課。它把成交拆成 ATPI 四塊影響力肌肉——吸引、信任、專業、推進，一課一塊，練到在真實對話裡走得通。對外兩個課：超引力顧問課 L1–L8、超引力公眾演說課 L1–L13。';

/* ═══ CTA 單一開關 ═══
   'retrain'：10/12 B 班開課前的舊生回訓期，整頁主行動鈕全部推複訓，另有舊生橫幅（帶倒數）。
   'consult'：開課後改成這個值，橫幅整條消失，主行動鈕全部退回「預約 1v1 諮詢」。
   ⭐ 2026-09-19 老師指定：回訓期主鈕統一成複訓。原本的規則是「主鈕兩種模式都給諮詢」，
      理由是這頁寫給陌生人；現在改成回訓優先，陌生人的路留在 hero 副鈕（健檢）與頁尾那行。
   ⚠️ 主行動鈕**不要**掛 data-deadline——那個屬性會讓元素在開課日之後自己隱藏，
      主鈕消失等於整頁沒有出口。到期收尾請改這裡的 CTA_MODE，不要靠自動隱藏。 */
const CTA_MODE: 'retrain' | 'consult' = 'retrain';
const RETRAIN_OPEN = CTA_MODE === 'retrain';
const RETRAIN_DEADLINE = '2026-10-12'; // B 班（舊生回訓班）L5–L8 開課日

/* 整頁主行動鈕的唯一真相。要換文案或連結改這裡，不要逐顆改。 */
const MAIN_CTA = RETRAIN_OPEN
  ? { href: '/courses/retrain', label: '舊生複訓手刀・看梯次與報名', cta: 'retrain' }
  : { href: LINKS.booking, label: '預約 1v1 諮詢', cta: 'booking' };

/* 四個斷點流程圖：一場對話會斷在哪四個地方。結果句鎖字典 01:58–61。 */
const chain = [
  { dim: 'A', en: 'ATTRACT', muscle: '吸引肌肉', from: '你開口', to: '他想聽', broke: '他沒有一個非聽不可的理由' },
  { dim: 'T', en: 'TRUST', muscle: '信任肌肉', from: '他想聽', to: '他說真話', broke: '他給你客套，你只能自己猜' },
  { dim: 'P', en: 'PROFESSIONAL', muscle: '專業肌肉', from: '他說真話', to: '他認定你', broke: '他聽懂了，但去找了別人' },
  { dim: 'I', en: 'IMPACT', muscle: '推進肌肉', from: '他認定你', to: '他真的做', broke: '氣氛很熱，散場之後什麼都沒發生' },
];

/* 12 小肌群：名稱原文＝quiz 題庫 label，不可自創。
   示意高度照「肌肉牆預設 T>A>P>I」：信任最高、推進最矮（裝飾用預設態）。 */
const wall = [
  { dim: 'A', en: 'ATTRACT', name: '吸引肌肉', result: '讓他想靠近', lesson: 'L1',
    minis: [{ n: '讓他開口', v: 70 }, { n: '讓他追問', v: 62 }, { n: '讓他記得', v: 74 }],
    body: '在對方還沒有義務聽你說話的時候，讓他願意多聽一句。練的不是開場白，是你有沒有站在他要的東西那一邊。' },
  { dim: 'T', en: 'TRUST', name: '信任肌肉', result: '讓他願意說', lesson: 'L2',
    minis: [{ n: '讓他敢說', v: 82 }, { n: '讓他交心', v: 76 }, { n: '讓他當真', v: 88 }],
    body: '把對方心裡那句沒講出來的話問出來。你拿到真話才有東西可以解，拿到客套，你解的是空氣。' },
  { dim: 'P', en: 'PROFESSIONAL', name: '專業肌肉', result: '讓他要找你', lesson: 'L3',
    minis: [{ n: '讓他釐清', v: 58 }, { n: '讓他有感', v: 66 }, { n: '讓他放心', v: 54 }],
    body: '專業不是你懂多少，是他聽完之後認定你就是那個人。練的是怎麼把你會的東西，變成他聽得懂的一條路。' },
  { dim: 'I', en: 'IMPACT', name: '推進肌肉', result: '讓他願意動', lesson: 'L4',
    minis: [{ n: '讓他想要', v: 44 }, { n: '讓他敢要', v: 50 }, { n: '讓他答應', v: 40 }],
    body: '把好感變成今天就會發生的下一步。不是逼單，是把那個他本來就想做的決定，變得容易做出來。' },
];

/* L1–L13 全貌。⚠️ 只有 L1–L4 有對外定案的名稱（＝四塊肌肉，courses.astro 同一份真相）；
   L5 之後沒有公開模組名，格子只露編號，不編故事。 */
const road = [
  {
    code: 'L1–L4', name: '鍛鍊段', dim: 'A', open: true,
    body: '一課一塊肌肉，四堂涵蓋十二條小肌群。這一段練單點零件，目的是先讓每一塊都動得起來。',
    mods: [
      { id: 'L1', name: '吸引肌肉' }, { id: 'L2', name: '信任肌肉' },
      { id: 'L3', name: '專業肌肉' }, { id: 'L4', name: '推進肌肉' },
    ],
  },
  {
    code: 'L5–L8', name: '放大段', dim: 'T', open: false,
    body: '把四塊肌肉串成你自己的一對一路徑。同樣是那四塊，這裡練的是怎麼在一場真實的對話裡把它們接起來。',
    mods: [{ id: 'L5' }, { id: 'L6' }, { id: 'L7' }, { id: 'L8' }],
  },
  {
    code: 'L9–L13', name: '演說段', dim: 'I', open: false,
    body: '把同一條路搬上舞台。從一對一換到一對多，肌肉沒變，動作變了。',
    mods: [{ id: 'L9' }, { id: 'L10' }, { id: 'L11' }, { id: 'L12' }, { id: 'L13' }],
  },
];

/* ⚠️ 不放價格：定價是諮詢現場攤開狀況之後才講的事，不在 LP 上比價（03-產品體系總覽 §C）。 */
const courses = [
  { name: '超引力顧問課', range: 'L1–L8', span: 8, dim: 'T',
    stages: '鍛鍊段＋放大段', who: '一對一還沒跑順，講完之後對方沒有下一步。' },
  { name: '超引力公眾演說課', range: 'L1–L13', span: 13, dim: 'I',
    stages: '鍛鍊段＋放大段＋演說段', who: '一對一已經會了，卡在一次只能面對一個人。' },
];

/* 一週迴路（流程圖）：乾貨自己看、時間全部拿去練。
   s 走 set:html，只為了塞 .nb——四格在窄螢幕會縮到 150px 上下，
   不擋的話會斷成「Hot Seat 輪／流」「安／排時間看完」。 */
const loop = [
  { dim: 'A', n: '①', t: '看錄播乾貨', s: '這週那塊肌肉的結構，<span class="nb">自己安排時間看完。</span>' },
  { dim: 'T', n: '②', t: '進健身房打卡', s: '一天一個小動作，<span class="nb">一週練 2 到 3 天，</span><span class="nb">記下今天動到哪塊。</span>' },
  { dim: 'P', n: '③', t: '討論課對練', s: '<span class="nb">4 到 5 人小組</span> <span class="nb">Hot Seat 輪流，</span><span class="nb">顧問當場校正。</span>' },
  { dim: 'I', n: '④', t: '帶回真實現場', s: '拿去用在<span class="nb">這週真的要談的那一場，</span><span class="nb">結果再帶回下一堂。</span>' },
];

/* 入場到結業（旅程圖）。健檢不佔模組編號＝courses.astro 同一份真相。 */
const journey = [
  { n: 1, name: '免費影響力健檢', here: true, body: '12 題，大約三分鐘。量出四塊肌肉現在的樣子，先練哪塊最有感。' },
  { n: 2, name: '1v1 諮詢', here: false, body: '線上 60 分鐘。先聽你的現況，不適合會直接說——我們不預設賣哪一個課。' },
  { n: 3, name: '入學健檢', here: false, body: '開課前量一次當起點數據。健檢不佔模組編號。' },
  { n: 4, name: '一週一個模組', here: false, body: '錄播、打卡、討論課對練，一週一迴路。班級 20 人以內。' },
  { n: 5, name: '結業複測', here: false, body: '再量一次做前後對照。進步不靠感覺，看得到數字。' },
  { n: 6, name: '回放與討論會籍一年', here: false, body: '一年內都可以回來重看、回來參加討論課。' },
];

/* 學員見證卡：productkit/產品kit/見證素材/見證卡/輸出 出的原圖，這裡只是放。
   要換人或改數字＝回去改那邊再重出，不要在這頁動。 */
const proof = [
  { src: '/assets/cases/card-weixiang.png',
    alt: '學員見證・王偉翔（到府按摩師、負債 100 萬轉行）：轉行後單月總收入 13.5 萬，卡片附原始對話截圖。維度標籤 T 信任肌肉。' },
  { src: '/assets/cases/card-linjiaxuan.png',
    alt: '學員見證・林珈鉉（企管顧問＋身心靈工作者）：上完課後的第一次實體銷講，15 人到場、9 位有效聽眾、8 位申請 1v1、3 位全數成交，過去同類型銷講成交率 6–9%。維度標籤 P 專業肌肉。' },
  { src: '/assets/cases/card-liumuyang.png',
    alt: '學員見證・劉沐洋（艾斯，家族辦公室主理人）：FB 公開發文寫「他只講了幾句話，就把我成交了。」，卡片附原始貼文截圖。維度標籤 A 吸引肌肉、T 信任肌肉、P 專業肌肉。' },
];

/* 用 set:html 是為了塞 .nb 斷行保護，字句本身一個字都沒動。
   中文可以在任兩個漢字之間斷，這四條放進兩欄的規格表會斷在
   「4 到 5 人／小組」「投／影片」；Hot Seat 中間是半形空白，一樣是可斷點。 */
const designs = [
  { t: '乾貨錄播，直播只拿來對練',
    s: '知識自己看就會，能力要有人看著你做。所以直播時間全部留給<span class="nb">對練與當場校正，</span><span class="nb">不拿來重講一次投影片。</span>' },
  { t: '班級 20 人以內，課中拆成 <span class="nb">4 到 5 人小組</span>',
    s: '<span class="nb">Hot Seat</span> 輪流上場。人少不是為了精緻，<span class="nb">是為了每個人都真的輪得到。</span>' },
  { t: '課與課之間有地方練',
    s: '影響力健身房是每天打卡的地方：一天一個小動作、記一塊肌肉。課不是<span class="nb">一週一次的事件，</span><span class="nb">是一條連續的線。</span>' },
  { t: '前後各量一次',
    s: '開課前做入學健檢，結業後複測做前後對照。<span class="nb">進步不靠感覺，看得到數字。</span>' },
];

/* 原文＝03-產品體系總覽 §A 誰不是我們的人（諮詢過濾用），語氣不改。 */
const notFor = [
  '想找「速成話術腳本」背了就用的人——我們教結構，不教背稿。',
  '產品或服務本身有問題、想靠說話掩蓋的人。',
  '不願意在生活中實際練習的人——課程設計就是每週學一個核心、馬上練。',
];

const forWhom = [
  { dim: 'A', t: '顧問・教練・專業服務者', s: '你的專業沒問題，卡在怎麼讓對方在第一次談完就知道要找你。' },
  { dim: 'P', t: '業務・接案者・一人公司', s: '你不想推銷，但你需要案子穩定進來。' },
  { dim: 'I', t: '講師・帶團隊的人', s: '你一次要面對一群人，而且需要他們聽完真的去做。' },
];

const faq = [
  { q: '超引力成交學跟影響力健身房是什麼關係？',
    a: '影響力健身房是館名，也是母品牌；超引力成交學是這間館裡的教練課系列。就像健身房本身跟教練課的關係。日後還會有別的教練課掛在同一個館名下。' },
  { q: '超引力成交學有幾種課？',
    a: '對外只有兩個：超引力顧問課，內容是 L1 到 L8，包含鍛鍊段與放大段；超引力公眾演說課，內容是 L1 到 L13，也就是前面全部再加上演說段。中間的段落不單獨販售。' },
  { q: '為什麼不能只買演說的部分？',
    a: '因為你在台上做的每一件事，都是一對一的放大版。一對一走不通的路，人一多只會斷得更快。演說段建立在前面八個模組的基礎上，抽掉地基單獨學，學到的會是形式而不是能力。' },
  { q: '我要怎麼知道自己適合哪一個？',
    a: '這個選擇不會由你自己在網頁上決定。它會在諮詢現場，把你的狀況攤開來看過之後才決定，我們不預設賣哪一個。開始的方式是先做一次免費的影響力健檢。' },
  { q: '我不是業務，這套課對我有用嗎？',
    a: '有用。ATPI 四塊肌肉練的是讓別人理解你、願意跟你一起做，這件事在提案、面試、帶團隊、家庭對話裡都在發生。成交在這裡的意思是讓人願意行動，不限於買賣。' },
  { q: '「成交」這個詞會不會太業務導向？',
    a: '成交在這裡的意思是讓人願意行動，不是話術與施壓。這套課從頭到尾的立場是：先有真實與信任，行動才會發生。技巧是工具，真實才是地基。' },
  { q: '上課要花多少時間？',
    a: '一個模組等於一週。乾貨錄播自己安排時間看，直播討論課固定時段，課間在影響力健身房打卡練 2 到 3 天。回放一年，討論會籍一年，一年內都可以回來參加討論課。' },
  { q: '報名之後可以退嗎？', a: '報名後 7 天內可退款。' },
];

/* ═══ 站表：這頁的骨架 ═══
   這頁有十幾段，原本每一段都是「眉標→大標→導言→一個框」往下堆，十幾次都同一個形狀，
   捲到中段就沒有任何線索知道自己走了多遠、後面還有多少。所以整頁重新當成一條「站」來排：
   每一站有編號、線上的一格、以及軌上的一個點。編號與軌上的點都從這一份清單長出來，
   不在 HTML 裡各寫一次——寫兩次遲早會對不起來。
   ⚠️ label 全部取自頁面上原本就有的字（眉標或圖標），不另外編新文案。
   開場不計號（它是入口不是站），終點另外標（它是要按的，不是要讀的）。 */
const stops = [
  { id: 'g-open', label: '超引力場' },
  { id: 'g-break', label: '先看結構' },
  { id: 'g-why', label: '先講一件事' },
  { id: 'g-wall', label: '四塊肌肉' },
  { id: 'g-road', label: 'L1–L13' },
  { id: 'g-loop', label: '一週迴路' },
  { id: 'g-journey', label: '怎麼進來' },
  { id: 'g-sku', label: '兩個課' },
  { id: 'g-fit', label: '誰適合來' },
  { id: 'g-coach', label: '教的人是誰' },
  { id: 'g-proof', label: '練過的人' },
  { id: 'g-faq', label: '常見問題' },
];
const END = { id: 'g-cta', label: '怎麼開始' };
const no = (id: string) => String(stops.findIndex((s) => s.id === id)).padStart(2, '0');

const url = `${SITE.url}/gravity/`;
const schema = [
  {
    '@type': 'WebPage', '@id': `${url}#webpage`, url, name: title, description,
    inLanguage: 'zh-Hant-TW',
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: { '@id': `${SITE.url}/#organization` },
  },
  ...courses.map((c) => ({
    '@type': 'Course',
    '@id': `${url}#${c.range.toLowerCase().replace(/[^a-z0-9]/g, '')}`,
    name: c.name,
    description: `${c.stages}，內容涵蓋 ${c.range}。適合的情況：${c.who}`,
    inLanguage: 'zh-Hant-TW',
    provider: { '@id': `${SITE.url}/#organization` },
    url,
  })),
  {
    '@type': 'FAQPage', '@id': `${url}#faq`,
    mainEntity: faq.map((f) => ({
      '@type': 'Question', name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  schema={schema}
  bodyClass="theme-dark"
  themeColor="#0c131e"
>
  <!-- ═══ 場：整頁的底 ═══
       這頁叫超引力，底就不做成一塊平板。做成一個有中心的場：中心在視窗正中（「你」永遠
       在自己那個場的中心），往下捲環會放大、十二道刻度會轉——捲動因此不只是換段落，
       是往場裡面落。十二道刻度就是十二條小肌群，數量本身是語意。
       ⚠️ 這層只吃 --gy（整頁進度），不用 [data-px]：那套量的是元素自己穿過視窗，
          fixed 元素的 rect 不會動，算出來永遠同一個值。
       ⚠️ z-index 要比 .section-skew::before 的 -1 更低，否則斜切帶會被場壓住。 -->
  <div class="gfield" aria-hidden="true">
    <span class="gglow"></span>
    <svg class="grings" viewBox="0 0 400 400" preserveAspectRatio="xMidYMid slice">
      <g class="grings-g">
        {[68, 112, 156, 200, 244].map((r) => (
          <circle cx="200" cy="200" r={r} fill="none" stroke="#E8C89A" stroke-width=".7" />
        ))}
        <g class="gticks">
          {Array.from({ length: 12 }, (_, i) => (
            <line x1="200" y1="-56" x2="200" y2="-30" stroke="#E8C89A" stroke-width="1.6"
                  transform={`rotate(${i * 30} 200 200)`} />
          ))}
        </g>
      </g>
    </svg>
  </div>

  <!-- ═══ 軌：十一站的里程尺 ═══
       頁首那條 .readbar 只講「還剩多少」，講不出「總共幾站、我在第幾站」。這條軌補後者：
       一點一站，全部先露出（未到的站不畫虛線也不上鎖，這頁的內容是可以先看的）。
       名字收在 hover 才出來——1280px 以下的螢幕容不下常駐的名字欄，而軌本身只有 14px 寬，
       任何寬度都擠不到內容。最後那一枚是終點不是站，所以是金色空心環，形狀就跟站不一樣。 -->
  <nav class="spine" aria-label="頁內導覽">
    <ul>
      {stops.map((s) => (
        <li><a href={`#${s.id}`} data-stop={s.id}><i aria-hidden="true"></i><span class="sp-l">{s.label}</span></a></li>
      ))}
      <li class="sp-end"><a href={`#${END.id}`} data-stop={END.id}><i aria-hidden="true"></i><span class="sp-l">{END.label}</span></a></li>
    </ul>
  </nav>

  <!-- ═══ 01 Hero ═══ -->
  <section class="hero" id="g-open">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="prokick"><span>SUPER ATTRACTION · 實戰私教</span></p>
        <h1>你講的是對的，<br /><span class="hl">只是對方沒有動</span></h1>
        <!-- ⚠️ 中文段落一律寫成單行：原始碼換行會變成一個空白，在中文裡會看成排版破洞。 -->
        <p class="lead hero-lead">問題通常不在內容，在那四塊看不見的肌肉。超引力成交學把成交拆成吸引、信任、專業、推進四塊，一課練一塊，練到在真實的對話裡走得通。</p>

        <div class="btn-row hero-cta">
          <a class="btn btn-main" href={MAIN_CTA.href} data-cta={MAIN_CTA.cta} data-cta-position="lp-hero">
            {MAIN_CTA.label}
          </a>
          <a class="btn btn-sub" href={LINKS.quiz} data-cta="quiz" data-cta-position="lp-hero">
            先做免費影響力健檢
          </a>
        </div>
        <p class="hero-meta"><span>🎯 <b>ATPI</b> 四塊影響力肌肉</span><span>👥 班級 20 人以內</span><span>📈 課前課後各量一次</span></p>
      </div>

      <!-- 圖①超引力場：中心是你，客戶在外圈繞，每跨進一道軌就是一塊肌肉在作用。
           四道軌由外而內＝A→T→P→I，結果句鎖字典（想靠近／願意說／要找你／願意動）。
           軌的缺口一律開在正上方，缺口就是標籤的位置——由上往下讀就是客戶走近的順序。
           ⚠️ 方向只靠「箭頭＋漸層」那個頻道講（24 §3.9 三頻道）；軌線本身不做虛線，
              虛線在這套語言裡已經被「還沒到」佔走了。 -->
      <aside class="field card" aria-label="超引力場示意：客戶在外圈繞著你走，每跨進一道軌就更近一步，由外而內是吸引、信任、專業、推進四塊肌肉">
        <p class="sec">GRAVITY FIELD · <b>超引力場</b></p>
        <div class="field-fig" aria-hidden="true">
          <svg viewBox="0 0 360 360" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="pull" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="var(--i)" stop-opacity=".14" />
                <stop offset="1" stop-color="var(--i)" stop-opacity=".9" />
              </linearGradient>
            </defs>

            <!-- 四道軌（上方留缺口給標籤） -->
            <path d="M218 32.8 A154 154 0 1 1 142 32.8" fill="none" stroke="var(--a)" stroke-width="1.5" opacity=".38" />
            <path d="M218 64 A124 124 0 1 1 142 64" fill="none" stroke="var(--t)" stroke-width="1.5" opacity=".38" />
            <path d="M218 96 A94 94 0 1 1 142 96" fill="none" stroke="var(--p)" stroke-width="1.5" opacity=".38" />
            <path d="M218 130.5 A64 64 0 1 1 142 130.5" fill="none" stroke="var(--i)" stroke-width="1.5" opacity=".38" />

            <!-- 繞著你走的人：一個人一枚，顏色＝他現在停在哪一圈（pro 引力場同款讀法） -->
            <g class="orbit">
              <g transform="translate(298,281)"><g class="tok">
                <circle r="13" fill="var(--card-warm)" stroke="var(--a)" stroke-width="1.5" />
                <circle cy="-3.6" r="3.7" fill="var(--a)" />
                <path d="M-6.4 7.2a6.4 6.4 0 0 1 12.8 0z" fill="var(--a)" />
              </g></g>
              <g transform="translate(35,129)"><g class="tok">
                <circle r="13" fill="var(--card-warm)" stroke="var(--a)" stroke-width="1.5" />
                <circle cy="-3.6" r="3.7" fill="var(--a)" />
                <path d="M-6.4 7.2a6.4 6.4 0 0 1 12.8 0z" fill="var(--a)" />
              </g></g>
              <g transform="translate(325,129)"><g class="tok">
                <circle r="13" fill="var(--card-warm)" stroke="var(--a)" stroke-width="1.5" />
                <circle cy="-3.6" r="3.7" fill="var(--a)" />
                <path d="M-6.4 7.2a6.4 6.4 0 0 1 12.8 0z" fill="var(--a)" />
              </g></g>
              <g transform="translate(104,280)"><g class="tok">
                <circle r="13" fill="var(--card-warm)" stroke="var(--t)" stroke-width="1.5" />
                <circle cy="-3.6" r="3.7" fill="var(--t)" />
                <path d="M-6.4 7.2a6.4 6.4 0 0 1 12.8 0z" fill="var(--t)" />
              </g></g>
              <g transform="translate(287,120)"><g class="tok">
                <circle r="13" fill="var(--card-warm)" stroke="var(--t)" stroke-width="1.5" />
                <circle cy="-3.6" r="3.7" fill="var(--t)" />
                <path d="M-6.4 7.2a6.4 6.4 0 0 1 12.8 0z" fill="var(--t)" />
              </g></g>
              <g transform="translate(113,115)"><g class="tok">
                <circle r="13" fill="var(--card-warm)" stroke="var(--p)" stroke-width="1.5" />
                <circle cy="-3.6" r="3.7" fill="var(--p)" />
                <path d="M-6.4 7.2a6.4 6.4 0 0 1 12.8 0z" fill="var(--p)" />
              </g></g>
              <g transform="translate(174,246)"><g class="tok">
                <circle r="13" fill="var(--card-warm)" stroke="var(--i)" stroke-width="1.5" />
                <circle cy="-3.6" r="3.7" fill="var(--i)" />
                <path d="M-6.4 7.2a6.4 6.4 0 0 1 12.8 0z" fill="var(--i)" />
              </g></g>
            </g>

            <!-- 軌標壓在人上面：底色擋片是 pro .gring i 的同一招，人會從標籤後面繞過去 -->
            <g class="ring-tag">
              <rect x="152" y="26" width="56" height="15" rx="4" fill="var(--card)" />
              <rect x="152" y="57" width="56" height="15" rx="4" fill="var(--card)" />
              <rect x="152" y="89" width="56" height="15" rx="4" fill="var(--card)" />
              <rect x="152" y="123" width="56" height="15" rx="4" fill="var(--card)" />
              <text x="180" y="37" font-size="11" font-weight="700" fill="var(--a)" text-anchor="middle">A 想靠近</text>
              <text x="180" y="68" font-size="11" font-weight="700" fill="var(--t)" text-anchor="middle">T 願意說</text>
              <text x="180" y="100" font-size="11" font-weight="700" fill="var(--p)" text-anchor="middle">P 要找你</text>
              <text x="180" y="134" font-size="11" font-weight="700" fill="var(--i)" text-anchor="middle">I 願意動</text>
            </g>

            <!-- 走到你面前的那一個：漸層由淡到亮＝方向 -->
            <path
              d="M24 73 Q4 140 31 195 Q48 250 90 272 Q135 296 180 287 Q222 278 239 241 Q252 214 241 193 Q234 180 222 176"
              fill="none" stroke="url(#pull)" stroke-width="2.5" stroke-linecap="round"
            />
            <polygon points="219,173.3 229.8,176.3 223.2,183.7" fill="var(--i)" />
            <!-- 起點刻意擺在最外圈之外：.orbit 會轉，這一枚不轉，擺在軌上遲早會疊到人 -->
            <g transform="translate(24,73)">
              <circle r="13" fill="var(--card-warm)" stroke="var(--i)" stroke-width="2" />
              <circle cy="-3.6" r="3.7" fill="var(--i)" />
              <path d="M-6.4 7.2a6.4 6.4 0 0 1 12.8 0z" fill="var(--i)" />
            </g>

            <!-- 中心＝你。外圈四段弧＝場是這四塊肌肉撐出來的 -->
            <path d="M155.4 155.7 A36 36 0 0 1 204.6 155.7" fill="none" stroke="var(--a)" stroke-width="3" stroke-linecap="round" />
            <path d="M206.3 157.4 A36 36 0 0 1 206.3 206.6" fill="none" stroke="var(--t)" stroke-width="3" stroke-linecap="round" />
            <path d="M204.6 208.3 A36 36 0 0 1 155.4 208.3" fill="none" stroke="var(--p)" stroke-width="3" stroke-linecap="round" />
            <path d="M153.7 206.6 A36 36 0 0 1 153.7 157.4" fill="none" stroke="var(--i)" stroke-width="3" stroke-linecap="round" />
            <circle cx="180" cy="182" r="29" fill="var(--card-warm)" />
            <text x="180" y="178" font-size="14" font-weight="700" fill="var(--ink)" text-anchor="middle">你</text>
            <text x="180" y="195" font-size="9" font-weight="700" fill="var(--i-deep)" text-anchor="middle">YOU</text>
          </svg>
        </div>
        <p class="field-note">引力是結果，不是方法。四塊肌肉一塊一塊練強，場就成形——<span class="nb">對的人會自己一圈一圈繞近，</span><span class="nb">你不用追著跑。</span></p>
        <div class="rule4" role="presentation"></div>
      </aside>
    </div>
  </section>

  {RETRAIN_OPEN && (
    <!-- ═══ 舊生專屬橫幅（CTA_MODE 開關）：只給已上過課的人，倒數是事實不是話術 ═══ -->
    <section class="section alum-wrap">
      <div class="wrap">
        <aside class="alum" data-deadline={RETRAIN_DEADLINE}>
          <div>
            <p class="alum-k">已經上過平凡人光頭的課？</p>
            <p class="alum-t">你已經會做了。這一梯是把它變成<b>可以帶人</b>。</p>
            <p class="alum-s">12 月起這套課會系統化：乾貨全部錄播，每週只留 1.5 小時演練課。平凡人光頭從頭帶到尾的完整直播梯次，<span class="nb">剩下最後兩梯——</span><span class="nb">B 班 10/12 開課。</span></p>
          </div>
          <div class="alum-act">
            <a class="btn btn-main" href="/courses/retrain" data-cta="retrain" data-cta-position="lp-alumni">
              舊生複訓手刀・看梯次與報名
            </a>
          </div>
        </aside>
      </div>
    </section>
  )}

  <!-- ═══ 02 圖②：一場對話會斷在哪四個地方（流程圖）═══ -->
  <section class="section section-skew" id="g-break">
    <div class="wrap">
      <header class="shead">
        <span class="snum num" aria-hidden="true">{no('g-break')}</span>
        <p class="kicker">先看結構</p>
        <h2 class="reveal">一場對話，<span class="hl">會斷在四個地方</span></h2>
        <p class="lead sec-lead reveal" style="--rd:.06s">而且每一次斷掉的地方都不一樣。所以你把同一套方法再練一次，結果還是不穩。</p>
      </header>

      <!-- 橫向鏈：五個狀態、四段推力。每段推力＝一塊肌肉，斷掉會怎樣寫在下面。 -->
      <div class="chain" role="img" aria-label="對話從你開口到他真的做，中間由吸引、信任、專業、推進四塊肌肉推動">
        {chain.map((c, i) => (
          <div class="ch" data-dim={c.dim}>
            <span class="ch-from">{c.from}</span>
            {/* 終點籤：桌機絕對定位到最右，手機退成靜態，所以要緊跟在起點籤後面才讀得出 from→to */}
            {i === chain.length - 1 && <span class="ch-to">{c.to}</span>}
            <span class="ch-arrow" aria-hidden="true">
              <i class="ch-slice"></i>
              <b class="ch-m">{c.dim} · {c.muscle}</b>
            </span>
            <span class="ch-broke">斷在這裡：{c.broke}</span>
          </div>
        ))}
      </div>

      <p class="chain-note">四塊不是加起來，是<b>相乘</b>。任何一塊趨近於零，另外三塊再高，整條鏈都會停在那裡。</p>
    </div>
  </section>

  <!-- ═══ 03 為什麼話術沒用（骨層） ═══ -->
  <section class="section" id="g-why">
    <div class="wrap-text">
      <header class="shead narrow">
        <span class="snum num" aria-hidden="true">{no('g-why')}</span>
        <p class="kicker">先講一件事</p>
        <h2 class="reveal">話術像打氣打出來的肌肉，<span class="hl">一鬆手就消</span></h2>
        <p class="lead reveal" style="--rd:.06s">卡住的時候，多數人會去找更厲害的一句話。學回來當下有用，過兩週又打回原形，因為換掉的是話，沒有換掉底下的能力。</p>
      </header>
      <p class="body-p">影響力不是天生的個性，也不是話術的天分。它是可以量、可以練、可以驗收的能力。能拆解，就能練；能練，就能量出進步。</p>
      <p class="body-p">這也是為什麼我們不給你腳本。腳本是別人的身體，穿不上你的。</p>
    </div>
  </section>

  <!-- ═══ 04 圖③：12 小肌群牆（拆到可以量的顆粒）═══ -->
  <section class="section section-skew" id="g-wall">
    <div class="wrap">
      <header class="shead">
        <span class="snum num" aria-hidden="true">{no('g-wall')}</span>
        <p class="kicker">ATPI 四塊影響力肌肉</p>
        <h2 class="reveal">拆到<span class="hl">量得出來</span>為止</h2>
        <p class="lead sec-lead reveal" style="--rd:.06s">四塊大肌肉，底下各三條小肌群，一共十二條。鍛鍊段的四堂課，就是這四塊。</p>
      </header>

      <!-- 十二片從基線長上來：這面牆講的就是「量得出來」，量表本來就該當著你的面跑一次。
           一片一片錯開，順序是 A→T→P→I（先信任最高、推進最矮那套預設在別頁，這裡是示意牆）。 -->
      <div class="wall reveal" role="img" aria-label="四塊影響力肌肉各有三條小肌群，共十二條">
        {wall.map((m, ci) => (
          <div class="wg" data-dim={m.dim}>
            <div class="wg-bars">
              {m.minis.map((mi, k) => (
                <span class="wg-bar" style={`--bd:${ci * 3 + k}`}><i style={`height:${mi.v}%`}></i></span>
              ))}
            </div>
            <div class="wg-names">
              {m.minis.map((mi) => <span>{mi.n}</span>)}
            </div>
            <p class="wg-t"><b>{m.dim}</b> {m.name}<span class="wg-les">{m.lesson}</span></p>
            <p class="wg-r">{m.result}</p>
            <p class="wg-body">{m.body}</p>
          </div>
        ))}
      </div>
      <p class="wall-note">上面是示意。你自己那面牆，健檢三分鐘就量得出來。</p>
    </div>
  </section>

  <!-- ═══ 05 圖④：L1–L13 全貌（全圖露出、現在位置亮、未解鎖描虛線）═══ -->
  <section class="section" id="g-road">
    <div class="wrap-wide">
      <header class="shead">
        <span class="snum num" aria-hidden="true">{no('g-road')}</span>
        <p class="kicker">這條路長什麼樣</p>
        <h2 class="reveal">十三個模組，<span class="hl">全部先給你看</span></h2>
        <p class="lead sec-lead reveal" style="--rd:.06s">一個模組等於一週。包括你現在還沒走到的地方，先看全圖再決定要走多遠。</p>
      </header>

      <div class="road">
        {road.map((seg) => (
          <div class:list={['seg', { open: seg.open }]} data-dim={seg.dim}>
            <p class="seg-h"><span class="seg-code">{seg.code}</span><b>{seg.name}</b></p>
            <div class="mods">
              {seg.mods.map((m) => (
                <span class:list={['mod', { locked: !seg.open }]}>
                  <b class="mod-id num">{m.id}</b>
                  {m.name ? <i class="mod-n">{m.name}</i> : <i class="mod-n mod-lock">還沒解鎖</i>}
                </span>
              ))}
            </div>
            <p class="seg-s">{seg.body}</p>
            {seg.open && <span class="seg-here">你從這裡開始</span>}
          </div>
        ))}
      </div>

      <!-- 兩個 SKU 各自涵蓋到哪：長度＝實際涵蓋範圍，對齊上面 4+4+5 的格子 -->
      <div class="sku">
        <p class="sku-k">兩個課各自涵蓋到哪</p>
        {courses.map((c) => (
          <div class="sku-row">
            <span class="sku-bar" data-dim={c.dim} style={`grid-column:1/span ${c.span}`}>
              <b>{c.name}</b><i>{c.range}</i>
            </span>
          </div>
        ))}
        <p class="sku-note">中間的段落不單獨販售。走到最後，不是你變成一個很會講話的人，而是<b>你說的話，開始有人願意照著做</b>。他們相信的是你這個人。</p>
      </div>

      {RETRAIN_OPEN && (
        <aside class="alum-slim" data-deadline={RETRAIN_DEADLINE}>
          <p>看完全圖，<b>你已經走過前面那幾格了？</b><span class="nb">B 班 10/12 開課，L5–L8 接著往下。</span></p>
          <a class="btn btn-main" href="/courses/retrain" data-cta="retrain" data-cta-position="lp-road">
            舊生複訓手刀・看梯次與報名
          </a>
        </aside>
      )}
    </div>
  </section>

  <!-- ═══ 06 圖⑤：一週迴路（流程圖）═══ -->
  <section class="section section-skew" id="g-loop">
    <div class="wrap">
      <header class="shead">
        <span class="snum num" aria-hidden="true">{no('g-loop')}</span>
        <p class="kicker">課是怎麼上的</p>
        <h2 class="reveal">一週一個迴路，<span class="hl">時間全部留給練</span></h2>
      </header>

      <div class="loop" role="img" aria-label="一週迴路：看錄播、進健身房打卡、討論課對練、帶回真實現場，然後回到下一週">
        <div class="loop-row">
          {loop.map((s) => (
            <div class="lp" data-dim={s.dim}>
              <span class="lp-n num">{s.n}</span>
              <p class="lp-t">{s.t}</p>
              <p class="lp-s" set:html={s.s} />
            </div>
          ))}
        </div>
        <p class="loop-back" aria-hidden="true">↻ 回到 ①，下一塊肌肉</p>
      </div>

      <!-- 這四件事排成規格列，不排成 2×2 卡片：正上方的一週迴路已經是一個帶框的
           四格圖，底下再來一組帶框的四格，兩塊會長得像同一件事重講一次。
           這四條其實是課的規格（怎麼上、多少人、課間做什麼、怎麼驗收），
