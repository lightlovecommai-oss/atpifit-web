            <g transform="translate(24,73)">
              <circle r="13" fill="var(--card-warm)" stroke="var(--i)" stroke-width="2" />
              <circle cy="-3.6" r="3.7" fill="var(--i)" />
              <path d="M-6.4 7.2a6.4 6.4 0 0 1 12.8 0z" fill="var(--i)" />
            </g>

            <!-- 中心＝你。外圈四段弧＝場是這四塊肌肉撐出來的 -->
            <path d="M155.4 155.7 A36 36 0 0 1 204.6 155.7" fill="none" stroke="var(--a)" stroke-width="3" stroke-linecap="round" />
            <path d="M206.3 157.4 A36 36 0 0 1 206.3 206.6" fill="none" stroke="var(--t)" stroke-width="3" stroke-linecap="round" />
            <path d="M204.6 208.3 A36 36 0 0 1 155.4 208.3" fill="none" stroke="var(--p)" stroke-width="3" stroke-linecap="round" />
            <path d="M153.7 206.6 A36 36 0 0 1 153.7 157.4" fill="none" stroke="var(--i)" stroke-width="3" stroke-linecap="round" />
            <circle cx="180" cy="182" r="29" fill="var(--card-warm)" />
            <text x="180" y="178" font-size="14" font-weight="700" fill="var(--ink)" text-anchor="middle">你</text>
            <text x="180" y="195" font-size="9" font-weight="700" fill="var(--i-deep)" text-anchor="middle">YOU</text>
          </svg>
        </div>
        <p class="field-note">引力是結果，不是方法。四塊肌肉一塊一塊練強，場就成形——對的人會自己一圈一圈繞近，你不用追著跑。</p>
        <div class="rule4" role="presentation"></div>
      </aside>
    </div>
  </section>

  {RETRAIN_OPEN && (
    <!-- ═══ 舊生專屬橫幅（CTA_MODE 開關）：只給已上過課的人，倒數是事實不是話術 ═══ -->
    <section class="section alum-wrap">
      <div class="wrap">
        <aside class="alum" data-deadline={RETRAIN_DEADLINE}>
          <div>
            <p class="alum-k">已經上過光頭的課？</p>
            <p class="alum-t">你已經會做了。這一梯是把它變成<b>可以帶人</b>。</p>
            <p class="alum-s">12 月起這套課會系統化：乾貨全部錄播，每週只留 1.5 小時演練課。光頭從頭帶到尾的完整直播梯次，剩下最後兩梯——B 班 10/12 開課。</p>
          </div>
          <div class="alum-act">
            <a class="btn btn-main" href="/courses/retrain" data-cta="retrain" data-cta-position="lp-alumni">
              舊生複訓手刀・看梯次與報名
            </a>
          </div>
        </aside>
      </div>
    </section>
  )}

  <!-- ═══ 02 圖②：一場對話會斷在哪四個地方（流程圖）═══ -->
  <section class="section section-alt">
    <div class="wrap">
      <p class="kicker">先看結構</p>
      <h2>一場對話，<span class="hl">會斷在四個地方</span></h2>
      <p class="lead sec-lead">而且每一次斷掉的地方都不一樣。所以你把同一套方法再練一次，結果還是不穩。</p>

      <!-- 橫向鏈：五個狀態、四段推力。每段推力＝一塊肌肉，斷掉會怎樣寫在下面。 -->
      <div class="chain" role="img" aria-label="對話從你開口到他真的做，中間由吸引、信任、專業、推進四塊肌肉推動">
        {chain.map((c, i) => (
          <div class="ch" data-dim={c.dim}>
            <span class="ch-from">{c.from}</span>
            {/* 終點籤：桌機絕對定位到最右，手機退成靜態，所以要緊跟在起點籤後面才讀得出 from→to */}
            {i === chain.length - 1 && <span class="ch-to">{c.to}</span>}
            <span class="ch-arrow" aria-hidden="true">
              <i class="ch-slice"></i>
              <b class="ch-m">{c.dim} · {c.muscle}</b>
            </span>
            <span class="ch-broke">斷在這裡：{c.broke}</span>
          </div>
        ))}
      </div>

      <p class="chain-note">四塊不是加起來，是<b>相乘</b>。任何一塊趨近於零，另外三塊再高，整條鏈都會停在那裡。</p>
    </div>
  </section>

  <!-- ═══ 03 為什麼話術沒用（骨層） ═══ -->
  <section class="section">
    <div class="wrap-text">
      <p class="kicker">先講一件事</p>
      <h2>話術像打氣打出來的肌肉，<span class="hl">一鬆手就消</span></h2>
      <p class="lead">卡住的時候，多數人會去找更厲害的一句話。學回來當下有用，過兩週又打回原形，因為換掉的是話，沒有換掉底下的能力。</p>
      <p class="body-p">影響力不是天生的個性，也不是話術的天分。它是可以量、可以練、可以驗收的能力。能拆解，就能練；能練，就能量出進步。</p>
      <p class="body-p">這也是為什麼我們不給你腳本。腳本是別人的身體，穿不上你的。</p>
    </div>
  </section>

  <!-- ═══ 04 圖③：12 小肌群牆（拆到可以量的顆粒）═══ -->
  <section class="section section-alt">
    <div class="wrap">
      <p class="kicker">ATPI 四塊影響力肌肉</p>
      <h2>拆到<span class="hl">量得出來</span>為止</h2>
      <p class="lead sec-lead">四塊大肌肉，底下各三條小肌群，一共十二條。鍛鍊段的四堂課，就是這四塊。</p>

      <div class="wall" role="img" aria-label="四塊影響力肌肉各有三條小肌群，共十二條">
        {wall.map((m) => (
          <div class="wg" data-dim={m.dim}>
            <div class="wg-bars">
              {m.minis.map((mi) => (
                <span class="wg-bar"><i style={`height:${mi.v}%`}></i></span>
              ))}
            </div>
            <div class="wg-names">
              {m.minis.map((mi) => <span>{mi.n}</span>)}
            </div>
            <p class="wg-t"><b>{m.dim}</b> {m.name}</p>
            <p class="wg-r">{m.result}</p>
          </div>
        ))}
      </div>
      <p class="wall-note">上面是示意。你自己那面牆，健檢三分鐘就量得出來。</p>

      <div class="grid muscles">
        {wall.map((m) => (
          <article class="card muscle" data-dim={m.dim}>
            <span class="m-slices" role="presentation"><i></i><i></i><i></i></span>
            <span class="m-en">{m.dim} · {m.en}<b class="m-les">{m.lesson}</b></span>
            <h3>{m.name}</h3>
            <p class="muscle-result">{m.result}</p>
            <p class="m-body">{m.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 05 圖④：L1–L13 全貌（全圖露出、現在位置亮、未解鎖描虛線）═══ -->
  <section class="section">
    <div class="wrap-wide">
      <p class="kicker">這條路長什麼樣</p>
      <h2>十三個模組，<span class="hl">全部先給你看</span></h2>
      <p class="lead sec-lead">一個模組等於一週。包括你現在還沒走到的地方，先看全圖再決定要走多遠。</p>

      <div class="road">
        {road.map((seg) => (
          <div class:list={['seg', { open: seg.open }]} data-dim={seg.dim}>
            <p class="seg-h"><span class="seg-code">{seg.code}</span><b>{seg.name}</b></p>
            <div class="mods">
              {seg.mods.map((m) => (
                <span class:list={['mod', { locked: !seg.open }]}>
                  <b class="mod-id num">{m.id}</b>
                  {m.name ? <i class="mod-n">{m.name}</i> : <i class="mod-n mod-lock">還沒解鎖</i>}
                </span>
              ))}
            </div>
            <p class="seg-s">{seg.body}</p>
            {seg.open && <span class="seg-here">你從這裡開始</span>}
          </div>
        ))}
      </div>

      <!-- 兩個 SKU 各自涵蓋到哪：長度＝實際涵蓋範圍，對齊上面 4+4+5 的格子 -->
      <div class="sku">
        <p class="sku-k">兩個課各自涵蓋到哪</p>
        {courses.map((c) => (
          <div class="sku-row">
            <span class="sku-bar" data-dim={c.dim} style={`grid-column:1/span ${c.span}`}>
              <b>{c.name}</b><i>{c.range}</i>
            </span>
          </div>
        ))}
        <p class="sku-note">中間的段落不單獨販售。走到最後，不是你變成一個很會講話的人，而是<b>你說的話，開始有人願意照著做</b>。他們相信的是你這個人。</p>
      </div>

      {RETRAIN_OPEN && (
        <aside class="alum-slim" data-deadline={RETRAIN_DEADLINE}>
          <p>看完全圖，<b>你已經走過前面那幾格了？</b><span class="nb">B 班 10/12 開課，L5–L8 接著往下。</span></p>
          <a class="btn btn-main" href="/courses/retrain" data-cta="retrain" data-cta-position="lp-road">
            舊生複訓手刀・看梯次與報名
          </a>
        </aside>
      )}
    </div>
  </section>

  <!-- ═══ 06 圖⑤：一週迴路（流程圖）═══ -->
  <section class="section section-alt">
    <div class="wrap">
      <p class="kicker">課是怎麼上的</p>
      <h2>一週一個迴路，<span class="hl">時間全部留給練</span></h2>

      <div class="loop" role="img" aria-label="一週迴路：看錄播、進健身房打卡、討論課對練、帶回真實現場，然後回到下一週">
        <div class="loop-row">
          {loop.map((s) => (
            <div class="lp" data-dim={s.dim}>
              <span class="lp-n num">{s.n}</span>
              <p class="lp-t">{s.t}</p>
              <p class="lp-s">{s.s}</p>
            </div>
          ))}
        </div>
        <p class="loop-back" aria-hidden="true">↻ 回到 ①，下一塊肌肉</p>
