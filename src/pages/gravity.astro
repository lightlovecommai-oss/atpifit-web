      <div class="grid grid-2 designs">
        {designs.map((d, i) => (
          <div class="design card">
            <span class="dnum num">{String(i + 1).padStart(2, '0')}</span>
            <h3>{d.t}</h3>
            <p>{d.s}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 07 圖⑥：入場到結業（旅程圖）═══ -->
  <section class="section">
    <div class="wrap-text">
      <p class="kicker">你會怎麼進來</p>
      <h2>從量一次開始，<span class="hl">到量第二次結束</span></h2>

      <div class="map">
        {journey.map((j) => (
          <div class:list={['stn', `n${j.n}`, { here: j.here }]}>
            <p class="stn-t">第 {j.n} 站・{j.name}{j.here && <span class="you">你在這</span>}</p>
            <p class="stn-s">{j.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 08 兩個課 ═══ -->
  <section class="section section-alt">
    <div class="wrap">
      <p class="kicker">對外只有兩個課</p>
      <h2>怎麼選，<span class="hl">諮詢現場才決定</span></h2>
      <div class="grid grid-2 courses">
        {courses.map((c) => (
          <article class="card muscle" data-dim={c.dim}>
            <span class="muscle-tag">{c.range}</span>
