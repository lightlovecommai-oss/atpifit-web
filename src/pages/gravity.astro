                <circle cy="-3.6" r="3.7" fill="var(--t)" />
                <path d="M-6.4 7.2a6.4 6.4 0 0 1 12.8 0z" fill="var(--t)" />
              </g></g>
              <g transform="translate(287,120)"><g class="tok">
                <circle r="13" fill="var(--card-warm)" stroke="var(--t)" stroke-width="1.5" />
                <circle cy="-3.6" r="3.7" fill="var(--t)" />
                <path d="M-6.4 7.2a6.4 6.4 0 0 1 12.8 0z" fill="var(--t)" />
              </g></g>
              <g transform="translate(113,115)"><g class="tok">
                <circle r="13" fill="var(--card-warm)" stroke="var(--p)" stroke-width="1.5" />
