---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, LINKS, FOUNDER_PHOTO } from '../consts';

/* 「超引力成交學」方法論長頁（LP），取代舊的 lp.atpifit.com 系列。
   分工：這頁負責說服（公開、給陌生人看），/courses/retrain 負責收單（noindex、舊生專用）。

   ⚠️ 視覺＝科技版深色底（bodyClass="theme-dark"），這不是門面破例，是產品線區隔：
   影響力健身房＝館，暖版；超引力成交學＝實戰私教，科技版。色值真相＝
   consult-workshop/pro.html，變數層在 brand.css 的 body.theme-dark。

   ⚠️ 圖比字重要（全貌感規則）：能用圖講的就不要用段落講。這頁六張圖＝
   引力場／四個斷點流程／12 小肌群牆／L1–L13 全貌／一週迴路／入場到結業旅程。

   ⚠️ 作廢詞：一階／二階／三階／Level 1-3／引力式系列／8週·12週／1+1 系統／「〇〇力」／收割。
   ⚠️ 價值堆疊與定價話術是諮詢現場用的，不上 LP（03-產品體系總覽 §C）。
   ⚠️ L5–L13 沒有對外定案的模組名稱，不可自己編——全貌圖那幾格只露編號。 */

const title = '超引力成交學｜把成交練成四塊肌肉的教練課';
const description =
  '超引力成交學是影響力健身房的實戰私教課。它把成交拆成 ATPI 四塊影響力肌肉——吸引、信任、專業、推進，一課一塊，練到在真實對話裡走得通。對外兩個課：超引力顧問課 L1–L8、超引力公眾演說課 L1–L13。';

/* ═══ CTA 單一開關 ═══
   'retrain'：10/12 B 班開課前的舊生回訓期，hero 下方多一條舊生專屬橫幅（帶倒數）。
   'consult'：開課後改成這個值，橫幅整條消失，全頁只剩「預約 1v1 諮詢」。
   主行動鈕在兩種模式下都是諮詢——這頁寫給陌生人，不能把陌生人丟進舊生專用頁。 */
const CTA_MODE: 'retrain' | 'consult' = 'retrain';
const RETRAIN_OPEN = CTA_MODE === 'retrain';
const RETRAIN_DEADLINE = '2026-10-12'; // B 班（舊生回訓班）L5–L8 開課日

/* 四個斷點流程圖：一場對話會斷在哪四個地方。結果句鎖字典 01:58–61。 */
const chain = [
  { dim: 'A', en: 'ATTRACT', muscle: '吸引肌肉', from: '你開口', to: '他想聽', broke: '他沒有一個非聽不可的理由' },
  { dim: 'T', en: 'TRUST', muscle: '信任肌肉', from: '他想聽', to: '他說真話', broke: '他給你客套，你只能自己猜' },
  { dim: 'P', en: 'PROFESSIONAL', muscle: '專業肌肉', from: '他說真話', to: '他認定你', broke: '他聽懂了，但去找了別人' },
  { dim: 'I', en: 'IMPACT', muscle: '推進肌肉', from: '他認定你', to: '他真的做', broke: '氣氛很熱，散場之後什麼都沒發生' },
];

/* 12 小肌群：名稱原文＝quiz 題庫 label，不可自創。
   示意高度照「肌肉牆預設 T>A>P>I」：信任最高、推進最矮（裝飾用預設態）。 */
const wall = [
  { dim: 'A', en: 'ATTRACT', name: '吸引肌肉', result: '讓他想靠近', lesson: 'L1',
    minis: [{ n: '讓他開口', v: 70 }, { n: '讓他追問', v: 62 }, { n: '讓他記得', v: 74 }],
    body: '在對方還沒有義務聽你說話的時候，讓他願意多聽一句。練的不是開場白，是你有沒有站在他要的東西那一邊。' },
  { dim: 'T', en: 'TRUST', name: '信任肌肉', result: '讓他願意說', lesson: 'L2',
    minis: [{ n: '讓他敢說', v: 82 }, { n: '讓他交心', v: 76 }, { n: '讓他當真', v: 88 }],
    body: '把對方心裡那句沒講出來的話問出來。你拿到真話才有東西可以解，拿到客套，你解的是空氣。' },
  { dim: 'P', en: 'PROFESSIONAL', name: '專業肌肉', result: '讓他要找你', lesson: 'L3',
    minis: [{ n: '讓他釐清', v: 58 }, { n: '讓他有感', v: 66 }, { n: '讓他放心', v: 54 }],
    body: '專業不是你懂多少，是他聽完之後認定你就是那個人。練的是怎麼把你會的東西，變成他聽得懂的一條路。' },
  { dim: 'I', en: 'IMPACT', name: '推進肌肉', result: '讓他願意動', lesson: 'L4',
    minis: [{ n: '讓他想要', v: 44 }, { n: '讓他敢要', v: 50 }, { n: '讓他答應', v: 40 }],
    body: '把好感變成今天就會發生的下一步。不是逼單，是把那個他本來就想做的決定，變得容易做出來。' },
];

/* L1–L13 全貌。⚠️ 只有 L1–L4 有對外定案的名稱（＝四塊肌肉，courses.astro 同一份真相）；
   L5 之後沒有公開模組名，格子只露編號，不編故事。 */
const road = [
  {
    code: 'L1–L4', name: '鍛鍊段', dim: 'A', open: true,
    body: '一課一塊肌肉，四堂涵蓋十二條小肌群。這一段練單點零件，目的是先讓每一塊都動得起來。',
    mods: [
      { id: 'L1', name: '吸引肌肉' }, { id: 'L2', name: '信任肌肉' },
      { id: 'L3', name: '專業肌肉' }, { id: 'L4', name: '推進肌肉' },
    ],
  },
  {
    code: 'L5–L8', name: '放大段', dim: 'T', open: false,
    body: '把四塊肌肉串成你自己的一對一路徑。同樣是那四塊，這裡練的是怎麼在一場真實的對話裡把它們接起來。',
    mods: [{ id: 'L5' }, { id: 'L6' }, { id: 'L7' }, { id: 'L8' }],
  },
  {
    code: 'L9–L13', name: '演說段', dim: 'I', open: false,
    body: '把同一條路搬上舞台。從一對一換到一對多，肌肉沒變，動作變了。',
    mods: [{ id: 'L9' }, { id: 'L10' }, { id: 'L11' }, { id: 'L12' }, { id: 'L13' }],
  },
];

/* ⚠️ 不放價格：定價是諮詢現場攤開狀況之後才講的事，不在 LP 上比價（03-產品體系總覽 §C）。 */
const courses = [
  { name: '超引力顧問課', range: 'L1–L8', span: 8, dim: 'T',
    stages: '鍛鍊段＋放大段', who: '一對一還沒跑順，講完之後對方沒有下一步。' },
  { name: '超引力公眾演說課', range: 'L1–L13', span: 13, dim: 'I',
    stages: '鍛鍊段＋放大段＋演說段', who: '一對一已經會了，卡在一次只能面對一個人。' },
];

/* 一週迴路（流程圖）：乾貨自己看、時間全部拿去練。 */
const loop = [
  { dim: 'A', n: '①', t: '看錄播乾貨', s: '這週那塊肌肉的結構，自己安排時間看完。' },
  { dim: 'T', n: '②', t: '進健身房打卡', s: '一天一個小動作，一週練 2 到 3 天，記下今天動到哪塊。' },
  { dim: 'P', n: '③', t: '討論課對練', s: '4 到 5 人小組 Hot Seat 輪流，顧問當場校正。' },
  { dim: 'I', n: '④', t: '帶回真實現場', s: '拿去用在這週真的要談的那一場，結果再帶回下一堂。' },
];

/* 入場到結業（旅程圖）。體測不佔模組編號＝courses.astro 同一份真相。 */
const journey = [
  { n: 1, name: '免費影響力健檢', here: true, body: '12 題，大約三分鐘。量出四塊肌肉現在的樣子，先練哪塊最有感。' },
  { n: 2, name: '1v1 諮詢', here: false, body: '線上 60 分鐘。先聽你的現況，不適合會直接說——我們不預設賣哪一個課。' },
  { n: 3, name: '入學體測', here: false, body: '開課前量一次當起點數據。體測不佔模組編號。' },
  { n: 4, name: '一週一個模組', here: false, body: '錄播、打卡、討論課對練，一週一迴路。班級 20 人以內。' },
  { n: 5, name: '結業複測', here: false, body: '再量一次做前後對照。進步不靠感覺，看得到數字。' },
  { n: 6, name: '回放與討論會籍一年', here: false, body: '一年內都可以回來重看、回來參加討論課。' },
];

/* 學員見證卡：productkit/產品kit/見證素材/見證卡/輸出 出的原圖，這裡只是放。
   要換人或改數字＝回去改那邊再重出，不要在這頁動。 */
const proof = [
  { src: '/assets/cases/card-weixiang.png',
    alt: '學員見證・王偉翔（到府按摩師、負債 100 萬轉行）：轉行後單月總收入 13.5 萬，卡片附原始對話截圖。維度標籤 T 信任肌肉。' },
  { src: '/assets/cases/card-linjiaxuan.png',
    alt: '學員見證・林珈鉉（企管顧問＋身心靈工作者）：上完課後的第一次實體銷講，15 人到場、9 位有效聽眾、8 位申請 1v1、3 位全數成交，過去同類型銷講成交率 6–9%。維度標籤 P 專業肌肉。' },
  { src: '/assets/cases/card-liumuyang.png',
    alt: '學員見證・劉沐洋（艾斯，家族辦公室主理人）：FB 公開發文寫「他只講了幾句話，就把我成交了。」，卡片附原始貼文截圖。維度標籤 A 吸引肌肉、T 信任肌肉、P 專業肌肉。' },
];

const designs = [
  { t: '乾貨錄播，直播只拿來對練',
    s: '知識自己看就會，能力要有人看著你做。所以直播時間全部留給對練與當場校正，不拿來重講一次投影片。' },
  { t: '班級 20 人以內，課中拆成 4 到 5 人小組',
    s: 'Hot Seat 輪流上場。人少不是為了精緻，是為了每個人都真的輪得到。' },
  { t: '課與課之間有地方練',
    s: '影響力健身房是每天打卡的地方：一天一個小動作、記一塊肌肉。課不是一週一次的事件，是一條連續的線。' },
  { t: '前後各量一次',
    s: '開課前做入學體測，結業後複測做前後對照。進步不靠感覺，看得到數字。' },
];

/* 原文＝03-產品體系總覽 §A 誰不是我們的人（諮詢過濾用），語氣不改。 */
const notFor = [
  '想找「速成話術腳本」背了就用的人——我們教結構，不教背稿。',
  '產品或服務本身有問題、想靠說話掩蓋的人。',
  '不願意在生活中實際練習的人——課程設計就是每週學一個核心、馬上練。',
];

const forWhom = [
  { dim: 'A', t: '顧問・教練・專業服務者', s: '你的專業沒問題，卡在怎麼讓對方在第一次談完就知道要找你。' },
  { dim: 'P', t: '業務・接案者・一人公司', s: '你不想推銷，但你需要案子穩定進來。' },
  { dim: 'I', t: '講師・帶團隊的人', s: '你一次要面對一群人，而且需要他們聽完真的去做。' },
];

const faq = [
  { q: '超引力成交學跟影響力健身房是什麼關係？',
    a: '影響力健身房是館名，也是母品牌；超引力成交學是這間館裡的教練課系列。就像健身房本身跟教練課的關係。日後還會有別的教練課掛在同一個館名下。' },
  { q: '超引力成交學有幾種課？',
    a: '對外只有兩個：超引力顧問課，內容是 L1 到 L8，包含鍛鍊段與放大段；超引力公眾演說課，內容是 L1 到 L13，也就是前面全部再加上演說段。中間的段落不單獨販售。' },
  { q: '為什麼不能只買演說的部分？',
    a: '因為你在台上做的每一件事，都是一對一的放大版。一對一走不通的路，人一多只會斷得更快。演說段建立在前面八個模組的基礎上，抽掉地基單獨學，學到的會是形式而不是能力。' },
  { q: '我要怎麼知道自己適合哪一個？',
    a: '這個選擇不會由你自己在網頁上決定。它會在諮詢現場，把你的狀況攤開來看過之後才決定，我們不預設賣哪一個。開始的方式是先做一次免費的影響力健檢。' },
  { q: '我不是業務，這套課對我有用嗎？',
    a: '有用。ATPI 四塊肌肉練的是讓別人理解你、願意跟你一起做，這件事在提案、面試、帶團隊、家庭對話裡都在發生。成交在這裡的意思是讓人願意行動，不限於買賣。' },
  { q: '「成交」這個詞會不會太業務導向？',
    a: '成交在這裡的意思是讓人願意行動，不是話術與施壓。這套課從頭到尾的立場是：先有真實與信任，行動才會發生。技巧是工具，真實才是地基。' },
  { q: '上課要花多少時間？',
    a: '一個模組等於一週。乾貨錄播自己安排時間看，直播討論課固定時段，課間在影響力健身房打卡練 2 到 3 天。回放一年，討論會籍一年，一年內都可以回來參加討論課。' },
  { q: '報名之後可以退嗎？', a: '報名後 7 天內可退款。' },
];

const url = `${SITE.url}/gravity/`;
const schema = [
  {
    '@type': 'WebPage', '@id': `${url}#webpage`, url, name: title, description,
    inLanguage: 'zh-Hant-TW',
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: { '@id': `${SITE.url}/#organization` },
  },
  ...courses.map((c) => ({
    '@type': 'Course',
    '@id': `${url}#${c.range.toLowerCase().replace(/[^a-z0-9]/g, '')}`,
    name: c.name,
    description: `${c.stages}，內容涵蓋 ${c.range}。適合的情況：${c.who}`,
    inLanguage: 'zh-Hant-TW',
    provider: { '@id': `${SITE.url}/#organization` },
    url,
  })),
  {
    '@type': 'FAQPage', '@id': `${url}#faq`,
    mainEntity: faq.map((f) => ({
      '@type': 'Question', name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout
  title={title}
  description={description}
  schema={schema}
  bodyClass="theme-dark"
  themeColor="#0c131e"
>
  <!-- ═══ 01 Hero ═══ -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="prokick"><span>SUPER ATTRACTION · 實戰私教</span></p>
        <h1>你講的是對的，<br /><span class="hl">只是對方沒有動</span></h1>
        <!-- ⚠️ 中文段落一律寫成單行：原始碼換行會變成一個空白，在中文裡會看成排版破洞。 -->
        <p class="lead hero-lead">問題通常不在內容，在那四塊看不見的肌肉。超引力成交學把成交拆成吸引、信任、專業、推進四塊，一課練一塊，練到在真實的對話裡走得通。</p>

        <div class="btn-row hero-cta">
          <a class="btn btn-main" href={LINKS.booking} data-cta="booking" data-cta-position="lp-hero">
            預約 1v1 諮詢
          </a>
          <a class="btn btn-sub" href={LINKS.quiz} data-cta="quiz" data-cta-position="lp-hero">
            先做免費影響力健檢
          </a>
        </div>
        <p class="hero-meta"><span>🎯 <b>ATPI</b> 四塊影響力肌肉</span><span>👥 班級 20 人以內</span><span>📈 課前課後各量一次</span></p>
      </div>

      <!-- 圖①超引力場：中心是你，客戶在外圈繞，每跨進一道軌就是一塊肌肉在作用。
           四道軌由外而內＝A→T→P→I，結果句鎖字典（想靠近／願意說／要找你／願意動）。
           軌的缺口一律開在正上方，缺口就是標籤的位置——由上往下讀就是客戶走近的順序。
           ⚠️ 方向只靠「箭頭＋漸層」那個頻道講（24 §3.9 三頻道）；軌線本身不做虛線，
              虛線在這套語言裡已經被「還沒到」佔走了。 -->
      <aside class="field card" aria-label="超引力場示意：客戶在外圈繞著你走，每跨進一道軌就更近一步，由外而內是吸引、信任、專業、推進四塊肌肉">
        <p class="sec">GRAVITY FIELD · <b>超引力場</b></p>
        <div class="field-fig" aria-hidden="true">
          <svg viewBox="0 0 360 360" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="pull" x1="0" y1="0" x2="1" y2="0">
                <stop offset="0" stop-color="var(--i)" stop-opacity=".14" />
                <stop offset="1" stop-color="var(--i)" stop-opacity=".9" />
              </linearGradient>
            </defs>

            <!-- 四道軌（上方留缺口給標籤） -->
            <path d="M218 32.8 A154 154 0 1 1 142 32.8" fill="none" stroke="var(--a)" stroke-width="1.5" opacity=".38" />
            <path d="M218 64 A124 124 0 1 1 142 64" fill="none" stroke="var(--t)" stroke-width="1.5" opacity=".38" />
            <path d="M218 96 A94 94 0 1 1 142 96" fill="none" stroke="var(--p)" stroke-width="1.5" opacity=".38" />
            <path d="M218 130.5 A64 64 0 1 1 142 130.5" fill="none" stroke="var(--i)" stroke-width="1.5" opacity=".38" />

            <!-- 繞著你走的人：一個人一枚，顏色＝他現在停在哪一圈（pro 引力場同款讀法） -->
            <g class="orbit">
              <g transform="translate(298,281)"><g class="tok">
                <circle r="13" fill="var(--card-warm)" stroke="var(--a)" stroke-width="1.5" />
                <circle cy="-3.6" r="3.7" fill="var(--a)" />
                <path d="M-6.4 7.2a6.4 6.4 0 0 1 12.8 0z" fill="var(--a)" />
              </g></g>
              <g transform="translate(35,129)"><g class="tok">
                <circle r="13" fill="var(--card-warm)" stroke="var(--a)" stroke-width="1.5" />
                <circle cy="-3.6" r="3.7" fill="var(--a)" />
                <path d="M-6.4 7.2a6.4 6.4 0 0 1 12.8 0z" fill="var(--a)" />
              </g></g>
              <g transform="translate(325,129)"><g class="tok">
                <circle r="13" fill="var(--card-warm)" stroke="var(--a)" stroke-width="1.5" />
                <circle cy="-3.6" r="3.7" fill="var(--a)" />
