  <!-- ═══ 09 誰適合／誰不適合 ═══
       兩欄並排，不把「不適合」藏在最底下。先說清楚比較公平，也是在篩掉諮詢現場會尷尬的人。 -->
  <section class="section section-skew" id="g-fit">
    <div class="wrap">
      <header class="shead">
        <span class="snum num" aria-hidden="true">{no('g-fit')}</span>
        <p class="kicker">誰適合來</p>
        <h2 class="reveal">我們也會<span class="hl">直接說誰不適合</span></h2>
        <p class="lead sec-lead reveal" style="--rd:.06s">兩邊都列出來。<span class="nb">諮詢的時候如果我們覺得你不適合，</span><span class="nb">會當場講，</span><span class="nb">不會硬把課賣給你。</span></p>
      </header>

      <div class="fit">
        <div class="fitcol fit-yes">
          <h3><span class="fit-mk" aria-hidden="true">✓</span>適合來</h3>
          <ul>{fitYes.map((f) => <li set:html={f} />)}</ul>
        </div>
        <div class="fitcol fit-no">
          <h3><span class="fit-mk" aria-hidden="true">✕</span>不適合來</h3>
          <ul>{fitNo.map((f) => <li set:html={f} />)}</ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 10 怎麼進來 ═══
       三站，前兩站都免費而且明講。不講的話這兩步看起來像兩道要付錢的門檻。 -->
  <section class="section" id="g-how">
    <div class="wrap-text">
      <header class="shead narrow">
        <span class="snum num" aria-hidden="true">{no('g-how')}</span>
        <p class="kicker">怎麼進來</p>
        <h2 class="reveal">前面兩步<span class="hl">都不用付錢</span></h2>
      </header>

      <div class="map">
        {how.map((j) => (
          <div class:list={['stn', `n${j.n}`, { here: j.here }]}>
            <p class="stn-t">第 {j.n} 步・{j.name}{j.here && <span class="you">從這裡開始</span>}</p>
            <p class="stn-s" set:html={j.body} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 11 FAQ ═══ -->
  <section class="section section-skew" id="g-faq">
    <div class="wrap-text">
      <header class="shead narrow">
        <span class="snum num" aria-hidden="true">{no('g-faq')}</span>
        <p class="kicker">常見問題</p>
        <h2 class="reveal">先回答<span class="hl">你可能會問的</span></h2>
      </header>
      <div class="faq reveal">
        {faq.map((f, i) => (
          <details class="qa" open={i === 0}>
            <summary>{f.q}</summary>
            <p>{f.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 骨層句 ═══ -->
  <section class="section">
    <div class="wrap-text">
      <blockquote class="quote">
        <p>影響力的盡頭不是成交，是有人因為你變好。</p>
        <cite>平凡人光頭</cite>
      </blockquote>
      <p class="body-p">影響力這種東西，用來拿下別人也可以，用來讓別人變好也可以，我們選後面那條。<span class="nb">練得強不是為了壓過誰，</span><span class="nb">是為了有能力</span><span class="nb">把你想給的東西，</span><span class="nb">真的給出去。</span></p>
    </div>
  </section>

  <!-- ═══ 主 CTA ═══
       這塊刻意不套站頭：它是終點不是站，長得跟前面十個一樣就變成「還有一段要讀」。 -->
  <section class="section" id="g-cta">
    <div class="wrap-text">
      <aside class="cta reveal">
        <p class="kicker">怎麼開始</p>
        <h2>你的專業沒有問題</h2>
        {/* 這段是置中窄欄，斷點落在哪很敏感：引號裡那兩句被拆開就讀成兩件事，所以用 .nb 綁住。 */}
        <p class="lead reveal" style="--rd:.06s">有問題的是——從<span class="nb">「他覺得你很厲害」</span>到<span class="nb">「他決定跟你買」</span>，<span class="nb">中間那一段，</span><span class="nb">沒有人教過你。</span></p>
        <a class="btn btn-main" href={LINKS.booking} data-cta="booking" data-cta-position="lp-bottom">
          預約免費 1v1 諮詢
        </a>
        <p class="cta-sub">線上 60 分鐘、不收費、不適合會直接說。還沒準備好聊？<a href={LINKS.quiz} data-cta="quiz" data-cta-position="lp-bottom-sub">先做 3 分鐘免費影響力健檢</a>。</p>
      </aside>
    </div>
  </section>

  <!-- ═══ 收尾 ═══
       這裡刻意不再放一顆鈕。上面那塊已經問過一次了，隔 160px 再問一次同一句話，
       讀起來不是「再提醒你」是「還在推你」。整頁的順序是信念→開口問→信念，
       最後一拍留給信念，不留給要求。 -->
  <section class="section">
    <div class="wrap-text center">
      <p class="closing">你不用變成另一個人，<br />只要讓真實的你呈現出來。</p>
    </div>
  </section>
</BaseLayout>

<script>
  const soft = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ═══ 場的進度 ═══
     --gy＝整頁捲動進度 0→1，寫在 <html> 上給 .gfield 用。
     BaseLayout 的 [data-px] 那套量的是「元素自己穿過視窗多少」，fixed 元素的 rect 不會動，
     套在場上會永遠算出同一個值，所以這裡自己起一個 rAF 迴圈。 */
  if (!soft) {
    const root = document.documentElement;
    let queued = false;
    /* max 要快取：scrollHeight 每讀一次就逼瀏覽器重算版面，放進每一幀的 rAF 裡
       等於自己製造掉幀。頁高只有在尺寸變、或圖片與 FAQ 展開後才會變。 */
    let max = 0;
    const measure = () => { max = root.scrollHeight - innerHeight; };
    const paint = () => {
      queued = false;
      root.style.setProperty('--gy', max > 0 ? (scrollY / max).toFixed(4) : '0');
    };
    const remeasure = () => { measure(); paint(); };
    addEventListener('scroll', () => {
      if (!queued) { queued = true; requestAnimationFrame(paint); }
    }, { passive: true });
    addEventListener('resize', remeasure, { passive: true });
    addEventListener('load', remeasure);
    if ('ResizeObserver' in window) new ResizeObserver(remeasure).observe(document.body);
    remeasure();
  }

  /* ═══ 軌上的站標 ═══
     觸發線壓在視窗上緣往下 25%：用正中會讓亮著的那一站落後於眼睛實際在讀的位置。 */
  const dots = document.querySelectorAll<HTMLAnchorElement>('[data-stop]');
  if (dots.length && 'IntersectionObserver' in window) {
    const byId = new Map([...dots].map((a) => [a.dataset.stop!, a]));
    let cur: HTMLAnchorElement | null = null;
    const io = new IntersectionObserver(
      (rows) => {
        for (const r of rows) {
          if (!r.isIntersecting) continue;
          const next = byId.get(r.target.id);
          if (!next || next === cur) continue;
          cur?.classList.remove('on');
          next.classList.add('on');
          cur = next;
        }
      },
      { rootMargin: '-25% 0px -60% 0px' }
    );
    byId.forEach((_, id) => {
      const el = document.getElementById(id);
      if (el) io.observe(el);
    });
  }

  /* ═══ 首屏引力場跟著游標轉一點點 ═══
     只有 4 度，而且只在真有指標裝置時掛。要的是「這塊是立體的」，不是要它晃。
     ⚠️ 只寫 --mx／--my，位移量交給 CSS——觸控裝置上整段不掛，也就不會有殘留的角度。 */
  const hg = document.querySelector<HTMLElement>('.hero-grid');
  if (hg && !soft && matchMedia('(hover: hover) and (pointer: fine)').matches) {
    let tilting = false;
    hg.addEventListener('pointermove', (e) => {
      if (tilting) return;
      tilting = true;
      requestAnimationFrame(() => {
        tilting = false;
        const r = hg.getBoundingClientRect();
        hg.style.setProperty('--mx', ((e.clientX - r.left) / r.width * 2 - 1).toFixed(3));
        hg.style.setProperty('--my', ((e.clientY - r.top) / r.height * 2 - 1).toFixed(3));
      });
    });
    hg.addEventListener('pointerleave', () => {
      hg.style.setProperty('--mx', '0');
      hg.style.setProperty('--my', '0');
    });
  }
</script>

<style>
  /* 四色簽名線（pro .rule4 同款：科技底要帶一點發光才立得起來） */
  .rule4 {
    height: 2px; border-radius: 2px; margin-top: 16px;
    background: linear-gradient(90deg, var(--a), var(--t), var(--p), var(--i));
    box-shadow: 0 0 8px rgba(232, 115, 74, .35);
  }
  .sec { font-size: 11px; font-weight: 700; letter-spacing: 2px; color: var(--ink-soft); margin-bottom: 10px; }
  .sec b { color: var(--ink); font-size: 13px; letter-spacing: 1px; }
  .sec-lead { max-width: 50ch; margin-top: 14px; }
  .body-p { margin-top: 18px; color: var(--ink-soft); max-width: 64ch; }
  .body-p b { color: var(--ink); }
  /* 中文短句禁拆：斷在詞中間（「才決／定」）比多留一點白更難讀 */
  .nb { white-space: nowrap; }

  /* 維度變數：非 .muscle 的元素自己帶一份 */
  [data-dim="A"] { --dim: var(--a); --dim-deep: var(--a-deep); --dim-tint: var(--a-tint); }
  [data-dim="T"] { --dim: var(--t); --dim-deep: var(--t-deep); --dim-tint: var(--t-tint); }
  [data-dim="P"] { --dim: var(--p); --dim-deep: var(--p-deep); --dim-tint: var(--p-tint); }
  [data-dim="I"] { --dim: var(--i); --dim-deep: var(--i-deep); --dim-tint: var(--i-tint); }

  /* ═══════════════════════════════════════════════════════════
     場：整頁的底
     ⚠️ z-index -2，要低於 .section-skew::before 的 -1，否則斜切帶會被場壓掉。
     負 z-index 之所以看得到，是因為 body 的底色被提升成畫布底色（先畫），
     負層在那之後才畫——所以它在底色之上、在所有一般內容之下。
     ═══════════════════════════════════════════════════════════ */
  .gfield { position: fixed; inset: 0; z-index: -2; pointer-events: none; overflow: hidden; }
  /* 落到頁尾要暗下來：一個場有中心就有邊緣，邊緣不暗它就只是一張貼滿的壁紙 */
  .gfield::after {
    content: ""; position: absolute; inset: auto 0 0; height: 45vh;
    background: linear-gradient(180deg, transparent, rgba(2, 6, 12, .55));
  }
  .gglow {
    position: absolute; inset: 0;
    background:
      radial-gradient(760px 620px at 78% 4%, rgba(232, 200, 154, .10), transparent 70%),
      radial-gradient(900px 760px at 50% 50%, rgba(230, 169, 58, .05), transparent 72%);
  }
  /* 往下捲＝環放大、刻度轉：捲動因此是「往場裡落」，不只是換段落。
     ⚠️ 放大掛在 <svg> 這個元素上，不掛在裡面的 <g>：元素層級的 transform 瀏覽器有機會
        自己合成，SVG 內部的群組一律只能重畫。元素是正方形、viewBox 也是正方形，
        所以縮放中心就是 200,200，畫面跟原本一樣。
     ⚠️ 不加 will-change：這塊有 175vmax 見方，等於視窗面積的三倍，
        強制提升成合成層會先吃掉幾十 MB 的顯示記憶體，代價比它省下的重畫還大。 */
  .grings {
    position: absolute; left: 50%; top: 50%; width: 175vmax; height: 175vmax;
    translate: -50% -50%; opacity: .085;
    transform: scale(calc(1 + var(--gy, 0) * .5));
  }
  /* 刻度只有十二條細線，留在 SVG 內部轉。transform-box: view-box 是必要的——
     預設的 fill-box 會讓原點落在圖形自己的邊界框上，轉起來中心會漂掉。 */
  .gticks { transform: rotate(calc(var(--gy, 0) * 42deg)); transform-origin: 200px 200px; transform-box: view-box; }

  /* 斜切帶改半透明：底下有一層會動的場，帶子若是實色就把場切成一段一段。
     原本的 #101b28 疊在 #0c131e 上只差一級亮度，換成同亮度的半透明白，看起來一樣。 */
  .section-skew::before { background: rgba(234, 241, 250, .035); }

  /* ═══════════════════════════════════════════════════════════
     軌：十站的里程尺
     頁首那條 .readbar 只講「還剩多少」，講不出「總共幾站、我在第幾站」。
     1280px 以下不出現——再窄就會擠到內容。
     ═══════════════════════════════════════════════════════════ */
  .spine { display: none; }
  @media (min-width: 1280px) {
    .spine {
      display: block; position: fixed; left: 14px; top: 50%; translate: 0 -50%; z-index: 40;
    }
    /* 串起所有站的那條線：畫在 ul 上而不是每個 li 之間，線才不會在 hover 放大時斷開 */
    .spine ul { list-style: none; margin: 0; padding: 0; position: relative; }
    .spine ul::before {
      content: ""; position: absolute; left: 7px; top: 9px; bottom: 9px; width: 1px;
      background: var(--line-soft);
    }
    /* ⚠️ 這個 a 要維持只有一枚點那麼寬。名字若留在流內，即使 opacity 0 也照樣佔位，
       整條軌會變成一道 110px 寬的隱形柱子，蓋在內容左緣上吃掉點擊。 */
    .spine a {
      position: relative; display: block; width: 15px; padding: 5px 0;
      text-decoration: none; color: var(--ink-soft);
    }
    .spine i {
      display: block; position: relative; z-index: 1; margin: 0 auto;
      width: 7px; height: 7px; border-radius: 50%;
      background: rgba(142, 161, 182, .55); box-shadow: 0 0 0 4px var(--bg);
      transition: background .2s ease, scale .2s var(--ease-out);
    }
    /* 終點不是站：金色空心環，形狀就跟站不一樣，不必靠文字解釋 */
    .sp-end i {
      width: 11px; height: 11px;
      background: transparent; border: 2px solid var(--i-deep);
    }
    .spine a:hover i, .spine a:focus-visible i { background: var(--i); scale: 1.3; }
    .sp-end a:hover i, .sp-end a:focus-visible i { background: transparent; border-color: var(--i); }
    .spine a.on i { background: var(--i); scale: 1.4; box-shadow: 0 0 0 4px var(--bg), 0 0 10px rgba(230, 169, 58, .55); }
    .sp-end a.on i { background: rgba(230, 169, 58, .3); border-color: var(--i); }
    /* 名字收在 hover 才出來：常駐的名字欄在 1280px 上會壓到內容，
       而且十個名字一直掛在那裡會跟頁面本身的眉標打架。 */
    .sp-l {
      position: absolute; left: 100%; top: 50%; margin-left: 8px;
      font-size: 12.5px; font-weight: 700; white-space: nowrap; color: var(--ink-3);
      background: var(--bg-blur); border: 1px solid var(--line-soft);
      border-radius: 999px; padding: 3px 11px;
      opacity: 0; translate: -6px -50%; pointer-events: none;
      transition: opacity .2s ease, translate .2s var(--ease-out);
    }
    .spine:hover .sp-l, .spine a:focus-visible .sp-l { opacity: 1; translate: 0 -50%; }
    .spine:hover a.on .sp-l, .spine a:hover .sp-l { color: var(--ink); border-color: var(--i-deep); }
  }

  /* ═══════════════════════════════════════════════════════════
     站頭：一條線、一個站號、左標右釋
     一條橫跨滿寬的細線起頭（節拍）、站號跨在線上（里程）、大標與導言左右並排
     （頭只佔一段高度，圖才有位置）。窄欄的段落（wrap-text）用 .narrow 退回單欄。
     ═══════════════════════════════════════════════════════════ */
  .shead { position: relative; padding-top: 26px; border-top: 1px solid var(--line); }
  .shead .lead { margin-top: 14px; max-width: 50ch; }
  /* 站號是描邊字：實心的話它會比大標還搶，而里程只是背景資訊。
     刻意讓細線從字中間穿過去——那是刻度尺該有的樣子，不是沒對齊。 */
  .snum {
    position: absolute; right: 0; top: 0; translate: 0 -50%;
    font-size: clamp(30px, 4.4vw, 48px); font-weight: 900; line-height: 1;
    letter-spacing: -.02em; color: transparent;
    -webkit-text-stroke: 1.2px rgba(142, 161, 182, .38);
  }
  @media (min-width: 900px) {
    /* 只有「真的有導言」的那幾段才分兩欄。沒有導言還分欄的話，大標會被壓在
       左邊 55% 裡提早斷行，右邊留一塊空白——看起來像少放了一段字。 */
    .shead:not(.narrow):has(.lead) {
      display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, .9fr);
      gap: 0 clamp(28px, 4vw, 64px); align-items: end;
    }
    .shead:not(.narrow) .kicker, .shead:not(.narrow) h2 { grid-column: 1; }
    .shead:not(.narrow) .lead { grid-column: 2; grid-row: 1 / span 2; margin: 0; align-self: end; }
  }
  @media (max-width: 560px) {
    /* 描邊大字在手機上會跟眉標疊在一起，退成一枚小號碼 */
    .snum { font-size: 12px; font-weight: 800; letter-spacing: .18em;
            color: var(--i-deep); -webkit-text-stroke: 0; translate: 0 -160%; }
  }

  /* ═══ Hero ═══ */
  .hero { padding: clamp(36px, 6vw, 72px) 0 clamp(28px, 4vw, 48px); }
  .hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: clamp(28px, 4vw, 56px); align-items: center; }
  .hero-lead { max-width: 44ch; margin-top: 18px; }
  .hero-cta { margin-top: 30px; }
  .hero-meta { display: flex; flex-wrap: wrap; gap: 10px 18px; margin-top: 18px; font-size: 13px; color: var(--ink-soft); }
  .hero-meta b { color: var(--i-deep); }
  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .field { max-width: 460px; }
  }

  /* 私教席眉標＝咖啡金橫條＋掃描線（pro .tb 的縮小版，這頁的身分識別） */
  .prokick {
    display: inline-block; position: relative; overflow: hidden;
    background: linear-gradient(135deg, #4A1B0C, #6B3018);
    border-radius: 999px; padding: 5px 16px; margin-bottom: 16px;
  }
  .prokick span { font-size: 11.5px; font-weight: 700; letter-spacing: .2em; color: #E8C89A; }
  /* 英文要 .2em 才撐得起眉標的味道，中文吃到同一個值會被拉散成一個字一個字。
     所以中文那半自己一個 <b>，字距收回來，整條唸起來才是「ENGLISH · 中文」。 */
  .prokick b { font-weight: 700; letter-spacing: .02em; }
  .prokick i { font-style: normal; opacity: .55; margin: 0 .5em 0 .15em; }
  .prokick::after {
    content: ""; position: absolute; left: 0; right: 0; top: 0; height: 1.5px;
    background: linear-gradient(90deg, transparent, #E8C89A, transparent);
    animation: scan 3.2s ease-in-out infinite;
  }
  @keyframes scan {
    0% { top: 0; opacity: 0; } 15% { opacity: 1; } 85% { opacity: 1; } 100% { top: 100%; opacity: 0; }
  }

  /* ═══ 圖①引力場 ═══ */
  .field { padding: 18px 18px 16px; }
  /* 跟著游標傾一點點。只有 4 度：要的是「這塊是立體的」，不是要它晃。
     --mx／--my 由 JS 寫（只在有指標裝置時掛），沒掛就是 0，角度歸零。 */
  @media (min-width: 861px) and (hover: hover) and (pointer: fine) {
    .field {
      transform: perspective(1000px)
                 rotateY(calc(var(--mx, 0) * 4deg))
                 rotateX(calc(var(--my, 0) * -4deg));
      transition: transform .55s var(--ease-out);
      will-change: transform;
    }
    .hero-grid:hover .field { transition: transform .1s linear; }
  }
  .field-fig { margin: 4px 0; }
  .field-fig svg { width: 100%; height: auto; }
  /* 星系慢轉，人反向自轉保持站正（pro .gorbit／.gdot 同一招）。
     ⚠️ .tok 外面一定要再包一層帶 translate 的 g——CSS transform 會整個蓋掉
     SVG 的 transform 屬性，位置和自轉寫在同一個元素上，位置就沒了。 */
  .orbit { animation: gspin 110s linear infinite; transform-box: view-box; transform-origin: 180px 182px; }
  .tok { animation: gspinrev 110s linear infinite; transform-box: fill-box; transform-origin: center; }
  @keyframes gspin { to { transform: rotate(360deg); } }
  @keyframes gspinrev { to { transform: rotate(-360deg); } }
  @media (prefers-reduced-motion: reduce) {
    .orbit, .tok { animation: none; }
  }
  .field-note { font-size: 12.5px; color: var(--ink-soft); line-height: 1.75; }

  /* ═══ 01 客戶那一句 ═══
     「我再想想。」是整頁的起點，所以它不當段落的一部分。左邊是鋪陳、右邊是那句話，
     中間用一條斜切短線接起來——視覺上就是「講了半天，換來這個」。 */
  .client-line {
    display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px 16px;
    margin-top: 30px; padding: 18px 20px;
    background: var(--card); border: 1px solid var(--line);
    border-left: 4px solid var(--line-soft); border-radius: 0 14px 14px 0;
  }
  .client-line span { font-size: 15px; color: var(--ink-soft); }
  .client-line b {
    font-size: clamp(19px, 2.6vw, 25px); font-weight: 800; color: var(--ink); letter-spacing: -.01em;
  }

  .asks-k { margin-top: 36px; font-size: 15px; color: var(--ink-soft); }
  .asks-k b { display: block; margin-top: 6px; font-size: clamp(18px, 2.4vw, 22px); color: var(--ink); }

  /* 四個問號：一格一句你問過自己的話。問號用描邊字當底，所以它不會跟句子搶。
     ⚠️ 問號絕對定位，不佔流——它是背景紋理，不是圖示。 */
  .asks { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; margin-top: 18px; }
  @media (max-width: 680px) { .asks { grid-template-columns: 1fr; } }
  .ask {
    position: relative; overflow: hidden;
    padding: 20px 22px 20px 20px; border-radius: 14px;
    background: var(--card); border: 1px solid var(--line);
    border-left: 3px solid var(--dim);
  }
  .ask-mark {
    position: absolute; right: 10px; bottom: -14px; line-height: 1;
    font-size: 72px; font-weight: 900; color: transparent;
    -webkit-text-stroke: 1.5px var(--dim); opacity: .3;
  }
  .ask-q {
    position: relative; font-size: clamp(16px, 2vw, 18.5px); font-weight: 700;
    line-height: 1.7; color: var(--ink-3); max-width: 24ch;
  }

  /* 都不是。——整頁第一個轉折，所以給它一塊自己的地。
     大字置中、底下一條四色線、再接一句打點句：讀起來是一個下落再抬起的節拍。 */
  .verdict {
    margin-top: 34px; padding: clamp(26px, 4.5vw, 44px) clamp(20px, 4vw, 40px);
    text-align: center; border-radius: 20px;
    background: linear-gradient(160deg, var(--card) 0%, var(--card-warm) 100%);
    border: 1px solid rgba(232, 200, 154, .3);
  }
  .verdict-k { font-size: 12px; font-weight: 700; letter-spacing: .16em; color: var(--ink-soft); }
  .verdict-big {
    margin-top: 8px; font-size: clamp(42px, 8vw, 78px); font-weight: 900; line-height: 1;
    letter-spacing: -.03em; color: var(--i);
    text-shadow: 0 0 28px rgba(230, 169, 58, .35);
  }
  /* 全形句號在 78px 下會脹成一顆懸在半空的圈，看起來像度數符號不像句點，
     而且它的字框左右各空半個字，置中的字串會被整排推左。
     縮到 .42em 讓它回到標點的體積，再把兩邊空出來的字框收掉。 */
  .verdict-big .jp { font-size: .42em; margin-left: -.1em; margin-right: -.18em; }
  .verdict .rule4 { max-width: 220px; margin: 22px auto 0; }
  /* 兩行是「否定→肯定」的節拍，所以第一行壓暗：兩行同亮度時眼睛會
     平均分配注意力，那句要被記住的「是專業不會自己開口」就浮不起來。 */
  .punch {
    margin-top: 22px; font-size: clamp(21px, 3.6vw, 34px); font-weight: 800;
    line-height: 1.55; letter-spacing: -.01em; color: var(--ink-soft);
  }
  .punch .hl { color: var(--ink); }

  /* ═══ 02 四種人 ═══
     2×2。每格是「身分 → 他會講的那句話 → 他是什麼樣的人」三層，
     那句話是主角所以字最大；身分籤只是索引，掃的時候用來對號入座。 */
  .pains { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px; margin-top: 34px; }
  @media (max-width: 720px) { .pains { grid-template-columns: 1fr; } }
  .pain {
    padding: 20px 22px; border-radius: 0 16px 16px 0;
    background: var(--card); border: 1px solid var(--line); border-left: 4px solid var(--dim);
    transition: border-color .2s ease, transform .2s var(--ease-out);
  }
  .pain:hover { transform: translateY(-2px); border-color: var(--dim-deep); }
  .pain-role {
    display: inline-block; font-size: 11.5px; font-weight: 800; letter-spacing: .1em;
    color: var(--dim-deep); background: var(--dim-tint); border-radius: 999px; padding: 3px 11px;
  }
  .pain-q {
    margin-top: 12px; font-size: clamp(22px, 3vw, 29px); font-weight: 800;
    line-height: 1.45; letter-spacing: -.02em; color: var(--ink);
  }
  .pain-who {
    margin-top: 10px; padding-top: 10px; border-top: 1px solid var(--line-soft);
    font-size: 14px; color: var(--ink-soft); line-height: 1.8; text-wrap: pretty;
  }
  .pains-note { margin-top: 28px; font-size: 16px; color: var(--ink-soft); line-height: 1.9; max-width: 62ch; }
  .pains-note b { color: var(--ink); }

  /* ═══ 03 教你的人是誰 ═══ */
  .coach { margin-top: 30px; }
  /* 照片比舊版窄一欄：這一站的主角換成那段故事，照片是佐證不是版面主體。
     align-items 用 start 不用 center——故事有八段，置中會讓照片浮在中間一塊空地上。 */
  .coach.has-photo {
    display: grid; grid-template-columns: .62fr 1.38fr;
    gap: clamp(26px, 4vw, 52px); align-items: start;
  }
  @media (max-width: 860px) { .coach.has-photo { grid-template-columns: 1fr; } }
  .coach-photo { margin: 0; max-width: 340px; position: sticky; top: 104px; }
  /* sticky 只在照片真的比故事短的時候才有意義；窄螢幕是上下疊，黏著會擋住故事 */
  @media (max-width: 860px) { .coach-photo { position: static; } }
  .coach-photo img { display: block; width: 100%; height: auto; border-radius: 18px; }
  .coach-lead { margin-top: 14px; max-width: 52ch; }

  .story { max-width: 58ch; }
  .story p { font-size: 16px; line-height: 1.95; color: var(--ink-soft); text-wrap: pretty; }
  .story p + p { margin-top: 16px; }
  .story b { color: var(--ink); font-weight: 700; }
  /* 第一句放大：故事的第一句話要能自己把人攔下來 */
  .story-open {
    font-size: clamp(19px, 2.4vw, 23px) !important; font-weight: 700;
    line-height: 1.7 !important; color: var(--ink) !important; letter-spacing: -.01em;
  }
  /* 「這不是天賦，這有公式。」——品牌金句層，所以給金色的側規。
     ⚠️ 不用大金 ❝：這頁底部的 .quote 已經有一個，兩個會互相減弱。 */
  .story-q {
    margin-top: 20px !important; padding: 14px 0 14px 18px;
    border-left: 3px solid var(--i);
    font-size: clamp(17px, 2.2vw, 20px) !important; line-height: 1.75 !important;
    color: var(--ink-3) !important;
  }
  .story-q b { color: var(--i-deep); }

  /* 六條驗證：規格列。左邊是場景（固定欄寬，六條才對得起來），右邊是那場的結果。 */
  .feats-k {
    margin-top: clamp(34px, 5vw, 52px); font-size: 12px; font-weight: 700;
    letter-spacing: .16em; color: var(--ink-soft);
  }
  .feats { list-style: none; padding: 0; margin: 12px 0 0; }
  .feats li {
    display: grid; grid-template-columns: minmax(0, 11ch) minmax(0, 1fr);
    gap: 4px clamp(16px, 3vw, 40px); align-items: baseline;
    padding: 15px 0; border-top: 1px solid var(--line);
  }
  .feats li:last-child { border-bottom: 1px solid var(--line); }
  .feat-l {
    font-size: 15px; font-weight: 800; color: var(--dim-deep); letter-spacing: .02em;
    position: relative; padding-left: 13px;
  }
  /* 場景前面一枚斜切小片：六條各自是哪塊肌肉在作用，用顏色講不用字講 */
  .feat-l::before {
    content: ""; position: absolute; left: 0; top: .42em; width: 6px; height: 6px;
    border-radius: 2px; background: var(--dim); transform: skewX(var(--skew));
  }
  .feat-s { font-size: 15px; color: var(--ink-soft); line-height: 1.85; text-wrap: pretty; }
  .feat-s b { color: var(--ink); font-weight: 700; }
  @media (max-width: 620px) {
    .feats li { grid-template-columns: minmax(0, 1fr); gap: 6px; }
  }

  .coach-belief { margin-top: 26px; font-size: 16px; color: var(--ink-soft); line-height: 1.95; max-width: 62ch; }
  .coach-belief b { color: var(--i-deep); }
  .coach-more { display: inline-block; margin-top: 22px; font-weight: 700; }

  /* ═══ 04 四個斷點：橫向鏈 ═══ */
  .chain { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; margin-top: 34px; }
  @media (max-width: 860px) { .chain { grid-template-columns: 1fr; gap: 18px; } }
  .ch { position: relative; padding-right: 10px; }
  .ch-from, .ch-to {
    display: inline-block; font-size: 14px; font-weight: 700; color: var(--ink);
    background: var(--card); border: 1px solid var(--line); border-radius: 999px; padding: 5px 13px;
  }
  .ch-to { position: absolute; right: 0; top: 0; }
  @media (max-width: 860px) { .ch-to { position: static; margin-left: 10px; } }
  /* 推力＝一片斜切薄片＋箭頭，顏色就是那塊肌肉 */
  .ch-arrow { display: block; margin: 14px 0 10px; }
  .ch-slice {
    display: block; height: 10px; border-radius: 3px; background: var(--dim);
    transform: skewX(var(--skew)); box-shadow: 0 0 10px var(--dim-tint);
    margin-right: 14px; position: relative; opacity: var(--slice-done);
  }
  /* 箭頭要跟片同一個斜切群組（§3.9 第 7 條），所以反向 skew 回來對齊片尾 */
  .ch-slice::after {
    content: ""; position: absolute; right: -14px; top: 50%;
    transform: translateY(-50%) skewX(calc(var(--skew) * -1));
    border-left: 10px solid var(--dim); border-top: 7px solid transparent; border-bottom: 7px solid transparent;
  }
  .ch-m { display: block; margin-top: 9px; font-size: 13px; font-weight: 800; letter-spacing: .04em; color: var(--dim-deep); }
  .ch-broke { display: block; margin-top: 6px; font-size: 13.5px; color: var(--ink-soft); line-height: 1.75; padding-right: 14px; }
  .chain-note { margin-top: 28px; font-size: 16px; color: var(--ink-soft); line-height: 1.9; max-width: 62ch; }
  .chain-note b { color: var(--ink); }

  /* ═══ 04 對照表 ═══
     三欄：他看到的事實 → 他自己下的錯誤診斷 → 我們的說法。
     表頭只在桌機出現；窄螢幕退成一欄之後，欄名改掛在每一格自己前面
     （橫捲的表在手機上等於沒有這張表）。 */
  .diag-k {
    margin-top: clamp(34px, 5vw, 52px); font-size: 12px; font-weight: 700;
    letter-spacing: .16em; color: var(--ink-soft);
  }
  .diag { margin-top: 12px; }
  .diag-h, .diag-r {
    display: grid; grid-template-columns: 1.1fr .8fr 1fr;
    gap: 8px clamp(14px, 2.6vw, 34px);
  }
  .diag-h { padding-bottom: 9px; border-bottom: 1px solid var(--line-soft); }
  .diag-h span { font-size: 11px; font-weight: 800; letter-spacing: .14em; color: var(--ink-soft); }
  .diag-r { padding: 16px 0; border-bottom: 1px solid var(--line); align-items: start; }
  /* 維度色掛在第一欄的側規上，不另外開一欄：四列各自是哪一關斷掉，顏色就說完了 */
  .d-see {
    font-size: 15.5px; font-weight: 700; color: var(--ink); line-height: 1.7;
    padding-left: 13px; border-left: 3px solid var(--dim);
  }
  .d-think { font-size: 14.5px; color: var(--ink-soft); line-height: 1.75; }
  .d-need { font-size: 15px; color: var(--ink-3); line-height: 1.75; }
  .d-need b { color: var(--dim-deep); font-weight: 800; }
  @media (max-width: 760px) {
    .diag-h { display: none; }
    .diag-r { grid-template-columns: minmax(0, 1fr); gap: 10px; padding: 18px 0; }
    /* 退成一欄之後中間那欄會變成一句沒頭沒尾的引號話，所以補上欄名 */
    .d-think::before, .d-need::before {
      display: block; margin-bottom: 2px;
      font-size: 10.5px; font-weight: 800; letter-spacing: .14em; color: var(--ink-soft);
    }
    .d-think::before { content: "你以為的原因"; }
    .d-need::before { content: "真正該練的"; }
  }
  .diag-note { margin-top: 26px; font-size: 16px; color: var(--ink-soft); line-height: 1.9; max-width: 62ch; }
  .diag-note b { color: var(--ink); }

  /* ═══ 05 你手上會多什麼 ═══
     這一段是整頁的好處欄，可是它夾在 04 的對照表跟 06 的見證圖之間——
     兩邊都很重，排成一般的兩欄清單就會被壓扁。所以把編號放大成左邊一條
     自己的數字柱：標題跟說明都往右靠成一欄，數字本身變成這段的視覺節拍。
     ⚠️ 數字是實心的，不描邊——站頭那枚 .snum 已經是描邊字，同一段裡
        出現兩種描邊數字會讀成同一個東西印了兩次。 */
  /* 收到 900px：說明段本來就只排到 54ch，分隔線再拉到滿寬的話，
     每一條線的右半截底下都是空的，四條疊起來就變成四條指向空白的橫線。 */
  .designs { margin-top: 30px; max-width: 900px; list-style: none; padding: 0; }
  .design {
    display: grid;
    grid-template-columns: clamp(54px, 6.5vw, 86px) minmax(0, 1fr);
    column-gap: clamp(16px, 2.6vw, 34px);
    padding: clamp(20px, 2.8vw, 32px) 0; border-top: 1px solid var(--line);
  }
  .design:last-child { border-bottom: 1px solid var(--line); }
  .dnum {
    grid-row: 1 / 3; align-self: start;
    font-size: clamp(30px, 4.4vw, 50px); font-weight: 900; line-height: .85;
    letter-spacing: -.045em; color: var(--i-deep); opacity: .32;
    transition: opacity .28s var(--ease-out);
  }
  /* 底下那一撇平常只有一截，滑過才拉滿：四條並排時它就是「現在讀到這條」的指針。
     拉長走 scaleX 不走 width——width 每一幀都會重算版面，scaleX 只動合成層。
     所以撇本身鋪滿整欄、平常壓到 .3，長度因此跟著數字欄一起縮放。 */
  .dnum::after {
    content: ""; display: block; width: 100%; height: 3px; margin-top: 10px;
    background: var(--i-deep); opacity: .45;
    transform: skewX(var(--skew)) scaleX(.3); transform-origin: 0 50%;
    transition: transform .32s var(--ease-out), opacity .28s var(--ease-out);
  }
  .design:hover .dnum { opacity: .9; }
  .design:hover .dnum::after { transform: skewX(var(--skew)) scaleX(1); opacity: 1; }
  .d-t {
    font-size: clamp(19px, 2.2vw, 24px); font-weight: 800; color: var(--ink);
    line-height: 1.45; letter-spacing: -.01em;
  }
  .d-s {
    margin: 8px 0 0; max-width: 54ch;
    font-size: 16px; color: var(--ink-soft); line-height: 1.9; text-wrap: pretty;
  }
  @media (max-width: 560px) {
    /* 再窄就留不住數字柱：改成數字在上、整段往左靠齊 */
    .design { grid-template-columns: minmax(0, 1fr); }
    .dnum { grid-row: auto; font-size: 26px; margin-bottom: 10px; }
    /* 數字欄這時候是滿寬，撇照 .3 縮會變成半條橫線；手機沒有 hover，給固定長度就好 */
    .dnum::after { width: 38px; margin-top: 6px; transform: skewX(var(--skew)); }
  }
  .gets-note { margin-top: 24px; font-size: 15px; color: var(--ink-soft); line-height: 1.9; max-width: 62ch; }

  /* ═══ 06 課程結構：三段 L1–L13 階梯 ═══
     搬自 /courses/，科技底下的三個調整：
     ① 薄片的 --act 在亮底是磚橘（錢鈕色），深底上拿它鋪 13 片會跟 .btn-main 搶注意力——
        所以改用 --act-deep 的亮金，加 .3→.86 的透明度梯度把 L1→L13 的強度差拉開。
     ② 段分界線 ::before 深底幾乎看不到，用 --line-soft 加 .55 透明度。
     ③ .cov 底色若用 var(--ink)（深底是亮白）透明度 .09 直接消失，改白加 .08 疊得起來。 */
  .ladder {
    list-style: none; padding: 0; margin-top: 36px;
    display: grid; grid-template-columns: 4fr 4fr 5fr;
    gap: clamp(18px, 2.6vw, 38px);
    /* 從頂端對齊，不是底部：三段的說明字數不一樣，底部對齊會把字少的那段整個往下推，
       薄片的底線跟著錯開——那條底線一斷，三段就不再是同一道往上爬的階梯。 */
    align-items: start;
  }
  .lstage { position: relative; }
  /* 段與段之間的分界線，用斜的（跟全站薄片同角度） */
  .lstage + .lstage::before {
    content: ""; position: absolute;
    left: calc(clamp(18px, 2.6vw, 38px) / -2); bottom: 0;
    width: 1px; height: 100%;
    background: var(--line-soft);
    transform: skewX(var(--skew)); opacity: .55;
  }
  /* 固定高度＝最高那片（L13）＋標籤的高度。沒有它，三段的薄片各自貼著自己的底，
     下面的文字就會跟著階梯一路往下錯開。 */
  .lmods {
    list-style: none; padding: 0; margin: 0;
    display: flex; align-items: flex-end; gap: 5px;
    height: 128px;
  }
  .lmods > li { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 6px; }
  .lmods i {
    display: block; width: 100%; height: var(--h);
    background: var(--act-deep); opacity: var(--lo);
    border-radius: var(--slice-r);
    transform: skewX(var(--skew));
    box-shadow: 0 0 10px rgba(232, 200, 154, .18);
  }
  .lmods b { font-size: 11px; font-weight: 700; color: var(--ink-soft); letter-spacing: .02em; }

  .lstage-code {
    margin-top: 18px; font-size: 12px; font-weight: 700;
    letter-spacing: .08em; color: var(--i-deep);
  }
  .lstage-name { margin-top: 4px; font-size: clamp(19px, 2.2vw, 23px); color: var(--ink); }
  .lstage-body { margin-top: 8px; font-size: 15.5px; color: var(--ink-soft); line-height: 1.85; text-wrap: pretty; }

  /* 每一段底下的課表。上緣那條細線把「段的說明」跟「段的課表」切開，
     不然 13 列課名接在說明段後面會讀成同一段文字。 */
  .llist {
    list-style: none; padding: 16px 0 0; margin: 16px 0 0;
    border-top: 1px solid var(--line-soft);
  }
  .lrow {
    display: grid;
    grid-template-columns: 2.4em 2.9em 1fr;
    align-items: baseline; gap: 8px;
    padding: 7px 0;
  }
