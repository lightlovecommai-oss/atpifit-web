---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SHEET_API } from '../../consts';

/* 複訓報名表（只給舊生，不對外招生）。
   ⚠️ noindex：這頁是電話邀請時貼的連結，不進搜尋、不進 sitemap。
   ⚠️ 沒串金流——保證金人工對帳，所以匯款資訊只在送出成功後才露出。
   ⚠️ 命名對齊字典（2026-09-01）：鍛鍊段 L1–L4／放大段 L5–L8。
      作廢：一階／二階／三階／Level 1-3／1+1 系統／溝通變現塾。 */

const title = '超引力顧問課・複訓報名';
const description = '舊生複訓專用報名表。課程架構已改版，回來上的不是複習。免學費，只收一筆結業當天全額退還的學習態度保證金。';

const DEPOSIT = '5,000';

const cohorts = [
  {
    id: 'L1-L4-1109',
    range: 'L1–L4',
    stage: '鍛鍊段',
    dim: 'A',
    month: '9 月開課',
    rhythm: '每週二、四　09:00–11:00',
    dates: ['9/29・10/1', '10/6・10/8', '10/13・10/15', '10/20・10/22'],
    who: '想把四塊肌肉一塊一塊重新拆開練。',
  },
  {
    id: 'L5-L8-1012',
    range: 'L5–L8',
    stage: '放大段',
    dim: 'T',
    month: '10 月開課',
    rhythm: '每週一、五　09:30–11:30',
    dates: ['10/12・10/16', '10/19・10/23', '10/26・10/30', '11/2・11/6'],
    who: '單塊都練得動了，卡在一整場對話串不起來。',
  },
  {
    id: 'L5-L8-1110',
    range: 'L5–L8',
    stage: '放大段',
    dim: 'I',
    month: '11 月開課',
    rhythm: '每週二、四　09:00–11:00',
    dates: ['11/10・11/12', '11/17・11/19', '11/24・11/26', '12/1・12/3'],
    who: '同上，但 10 月的時段排不進來。',
  },
];

/* 給 Sheet 存的梯次字串：光頭對帳時要一眼看得出是哪一梯，所以帶上開課日 */
const cohortLabel = (c: typeof cohorts[number]) =>
  `${c.range} ${c.stage}｜${c.month}｜${c.rhythm.replace(/　/g, ' ')}`;

const upgrades = [
  {
    k: '架構重寫',
    t: '「階」沒有了，改成「段」',
    b: '以前是一階、二階分開賣。現在是一條路分兩段：鍛鍊段 L1–L4 練單塊肌肉，放大段 L5–L8 把它們串成一場走得通的對話。你當初學的東西還在，但位置全部重排過。',
  },
  {
    k: '解析度變高',
    t: '四塊肌肉，拆成十二塊',
    b: '吸引、信任、專業、推進各自再拆三塊小肌群。以前只能說「你信任感不夠」，現在指得出是哪一塊、該練哪個動作。體測也跟著換成十二格。',
  },
  {
    k: '順序改了',
    t: '推進提前到 L4',
    b: '推進以前排在後段，等於前面練完還不知道怎麼收。現在四塊在鍛鍊段就到齊——一開始你就有完整的一套，不是半套。',
  },
  {
    k: '上法改了',
    t: '乾貨錄播先看，直播只做對練',
    b: '課堂時間不再拿來聽講。乾貨你自己先看完，進教室就直接進對練、Hot Seat、顧問校正。同樣兩小時，動手的比例完全不一樣。',
  },
];

const rules = [
  '八堂課，缺席 <b>2 堂（含）以內</b>，保證金<span class="nb">結業當天全額退還</span>。',
  '缺席 <b>3 堂（含）以上</b>，保證金不退。這條先講清楚，不等到最後再解釋。',
  '要請假請事先說，不要當天消失——課中是分組對練，你沒到，你那組就少一個人。',
  '課堂內容與同學講的案例都不外流。',
];
---

<BaseLayout title={title} description={description} noindex={true} bodyClass="no-sticky">
  <section class="section">
    <div class="wrap-text">
      <p class="kicker">複訓梯・只給舊生</p>
      <h1>你學過的那套課，<br />已經<span class="hl">重寫過一遍</span></h1>
      <p class="lead head-lead">所以這不是回來複習。架構改了、順序改了、四塊肌肉拆成十二塊，連上課的方式都換掉了。複訓<span class="nb">免學費</span>，只收一筆<span class="nb">結業當天退還</span>的保證金。</p>
      <div class="atpi-rule sig"><i></i><i></i><i></i><i></i></div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap-text">
      <h2>改了什麼</h2>
      <p class="lead">四件事，每一件都會改變你在課堂上聽到的內容。</p>
      <ol class="ups">
        {upgrades.map((u) => (
          <li class="card">
            <span class="up-k">{u.k}</span>
            <h3>{u.t}</h3>
            <p>{u.b}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section" id="pick-top">
    <div class="wrap-text">
      <h2>三梯，挑一個時段</h2>
      <p class="lead">每一梯都是八堂、四週。內容照上面那套新版走。</p>

      <div class="picks">
        {cohorts.map((c, i) => (
          <label class="pick card muscle" data-dim={c.dim}>
            <input type="radio" name="cohort" value={cohortLabel(c)} checked={i === 0} />
            <span class="pick-body">
              <span class="muscle-tag">{c.range}　{c.stage}</span>
              <span class="pick-h">{c.month}</span>
              <span class="pick-r">{c.rhythm}</span>
              <span class="pick-d">{c.dates.map((d) => <span class="wk">{d}</span>)}</span>
              <span class="pick-w">{c.who}</span>
            </span>
            <span class="tick" aria-hidden="true"></span>
          </label>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap-text">
      <h2>費用與課程守則</h2>

      <div class="money">
        <p class="money-big">複訓不收學費。</p>
        <p>報名時繳 <b>{DEPOSIT} 元</b>學習態度保證金，<br /><b>結業當天全額退還</b>。</p>
        <p class="money-why">保證金不是營收，是為了讓這八堂課真的有人坐在裡面。課中是分組對練，少一個人，剩下的人就少一個對練的對象。</p>
      </div>

      <ul class="rules">
        {rules.map((r) => <li set:html={r} />)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap-text">
      <div class="quote">
        <p>力量練起來，是為了給出去，<br />不是為了贏誰。</p>
        <cite>— 光頭</cite>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="signup">
    <div class="wrap-text">
      <h2>填一下，我們就把你排進去</h2>
      <p class="lead">送出之後這一頁會給你匯款帳號。<span class="nb">保證金入帳，報名才算完成。</span></p>

      <form class="signup card" id="signup-form" data-endpoint={SHEET_API} novalidate>
        <div class="f">
          <label for="su-name">姓名（或你在課堂上的綽號）<em>＊</em></label>
          <input id="su-name" name="name" type="text" autocomplete="name" required placeholder="我們點名會叫這個" />
        </div>

        <div class="f">
          <label for="su-line">LINE ID<em>＊</em></label>
          <input id="su-line" name="lineIdText" type="text" required placeholder="方便把你加進課程群組" />
        </div>

        <div class="f">
          <label for="su-email">Email<em>＊</em></label>
          <input id="su-email" name="email" type="email" autocomplete="email" required placeholder="課前通知與錄播連結寄這裡" />
        </div>

        <div class="f">
          <label for="su-phone">電話<span class="opt">選填</span></label>
          <input id="su-phone" name="phone" type="tel" autocomplete="tel" placeholder="突然的急事也許會用到" />
        </div>

        <div class="f f-pick">
          <span class="lab">你選的梯次</span>
          <p class="chosen" id="su-chosen"></p>
          <a class="relink" href="#pick-top">要換一梯？回上面重選</a>
        </div>

        <label class="agree">
          <input type="checkbox" id="su-agree" name="agree" required />
          <span>我是舊生，我看過上面的課程守則，願意遵守——包含缺席 3 堂以上保證金不退。</span>
        </label>

        <button class="btn btn-main" type="submit">送出報名</button>
        <p class="msg" id="su-msg" role="status" aria-live="polite"></p>
      </form>

      <div class="done card" id="signup-done" hidden>
        <div class="atpi-rule"><i></i><i></i><i></i><i></i></div>
        <h3>收到了，名字已經在名單上。</h3>
        <p class="done-p">最後一步是保證金。<b>{DEPOSIT} 元</b>匯到下面這個帳戶。<br /><span class="nb">沒有線上金流，光頭是人工對帳</span>，所以匯完麻煩<b class="nb">把後五碼用 LINE 傳給他</b>，這樣對得比較快。</p>

        <dl class="bank">
          <div><dt>銀行</dt><dd>星展銀行（810）</dd></div>
          <div><dt>帳號</dt><dd class="acct num">60604709488</dd></div>
          <div><dt>戶名</dt><dd>徐哲彥</dd></div>
          <div><dt>金額</dt><dd class="num">NT$ {DEPOSIT}</dd></div>
        </dl>

        <button class="btn btn-sub" type="button" id="copy-acct">複製帳號</button>
        <p class="done-note">這筆錢結業當天原數退還。它不是學費，是位子。</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('signup-form') as HTMLFormElement;
  const done = document.getElementById('signup-done') as HTMLElement;
  const chosen = document.getElementById('su-chosen') as HTMLElement;
  const msg = document.getElementById('su-msg') as HTMLElement;
  const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const radios = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="cohort"]'));

  const pickedValue = () => radios.find((r) => r.checked)?.value || '';
  const syncChosen = () => { chosen.textContent = pickedValue(); };
  radios.forEach((r) => r.addEventListener('change', syncChosen));
  syncChosen();

  const say = (text: string, ok = false) => {
    msg.textContent = text;
    msg.dataset.state = ok ? 'ok' : 'err';
  };

  const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = val('su-name');
    const lineId = val('su-line');
    const email = val('su-email');
    const agree = (document.getElementById('su-agree') as HTMLInputElement).checked;

    /* 擋下來的只有「之後找不到人」的欄位。守則同意是承諾，也不能跳過。 */
    if (!name) return say('姓名還沒填，我們點名會叫這個。');
    if (!lineId) return say('LINE ID 還沒填，沒有它沒辦法把你加進群組。');
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return say('這個 Email 看起來不太對，再確認一下？');
    if (!agree) return say('守則那一格還沒勾。');

    btn.disabled = true;
    const original = btn.textContent;
    btn.textContent = '送出中…';
    say('');

    const payload = {
      action: 'signup',
      name, lineIdText: lineId, email,
      phone: val('su-phone'),
      cohort: pickedValue(),
      agree: true,
      timestamp: new Date().toISOString(),
      track: (window as any).trackPayload?.() ?? {},
    };

    try {
      /* text/plain＝簡單請求，不觸發 CORS 預檢（跟訂閱／測驗端同一個做法） */
      const r = await fetch(form.dataset.endpoint!, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(payload),
      });
      const d = await r.json().catch(() => ({}));
      if (!r.ok || d.status !== 'ok') throw new Error(d.status || `HTTP ${r.status}`);

      form.hidden = true;
      done.hidden = false;
      done.scrollIntoView({ behavior: 'smooth', block: 'start' });
      try { (window as any).track?.('lead_submit', { source: 'retrain' }); } catch {}
    } catch (err) {
      console.warn('報名送出失敗：', err);
      say('送出的時候出了點狀況，麻煩再按一次。連按兩次不會重複報名。');
      btn.disabled = false;
      btn.textContent = original;
    }
  });

  document.getElementById('copy-acct')?.addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText('60604709488');
      b.textContent = '已複製';
      setTimeout(() => { b.textContent = '複製帳號'; }, 2000);
    } catch {
      b.textContent = '複製失敗，請手動選取';
    }
  });
</script>

<style is:global>
  /* 這頁的主行動是報名鈕，不是健檢。sticky 欄留著會變成一頁兩顆主鈕。 */
  body.no-sticky .sticky-quiz { display: none !important; }

  /* 這兩條必須是 global：守則那幾條走 set:html，裡面的標籤拿不到 Astro 的 scope class。 */
  .nb { white-space: nowrap; }
  .rules b { color: var(--act-deep); }
</style>

<style>
  .head-lead { max-width: 46ch; margin-top: 16px; }
  .sig { margin-top: 28px; max-width: 160px; }

  .ups { list-style: none; padding: 0; margin-top: 28px; display: grid; gap: 14px; }
  .up-k {
    display: inline-block; font-size: 12px; font-weight: 700; letter-spacing: .1em;
    color: var(--act-deep); background: var(--a-tint); border-radius: 999px; padding: 3px 11px;
  }
  .ups h3 { margin-top: 11px; font-size: 20px; }
  .ups p { margin-top: 8px; color: var(--ink-soft); line-height: 1.9; }

  /* ── 梯次選擇：整張卡就是 radio，手機上不用去點那顆小圓圈 ── */
  .picks { margin-top: 28px; display: grid; gap: 14px; }
  .pick { position: relative; display: block; cursor: pointer; padding-right: 54px; }
  .pick input { position: absolute; opacity: 0; pointer-events: none; }
  .pick-body { display: block; }
  .pick-h { display: block; margin-top: 4px; font-size: 21px; font-weight: 700; }
  .pick-r { display: block; margin-top: 4px; font-size: 16px; color: var(--ink); }
  /* 一週一格，整格 nowrap——日期對本身被瀏覽器拆行（10/26・／10/30）比換行醜得多 */
  .pick-d { display: flex; flex-wrap: wrap; gap: 6px 8px; margin-top: 10px; }
  .wk {
    white-space: nowrap; font-size: 14px; color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
    background: var(--bg-alt); border: 1px solid var(--line);
    border-radius: 8px; padding: 3px 9px;
  }
  .pick-w { display: block; margin-top: 12px; font-size: 15px; color: var(--ink-soft); }

  .tick {
    position: absolute; top: 22px; right: 20px; width: 24px; height: 24px;
    border: 2px solid var(--line); border-radius: 50%; background: #fff;
  }
  .pick:has(input:checked) { border-color: var(--dim); box-shadow: 0 0 0 2px var(--dim-tint); }
  .pick:has(input:checked) .tick { border-color: var(--dim); background: var(--dim); }
  .pick:has(input:checked) .tick::after {
    content: ''; position: absolute; left: 6px; top: 2px; width: 6px; height: 12px;
    border: solid #fff; border-width: 0 2.5px 2.5px 0; transform: rotate(42deg);
  }
  .pick:has(input:focus-visible) { outline: 3px solid var(--act); outline-offset: 2px; }

  /* ── 費用 ── */
  .money { margin-top: 24px; background: var(--t-tint); border-radius: var(--r-card); padding: 24px; }
  .money-big { font-size: clamp(21px, 3vw, 25px); font-weight: 800; color: var(--t-deep); }
  .money p + p { margin-top: 10px; }
  .money-why { font-size: 15px; color: var(--ink-soft); line-height: 1.9; }

  .rules { margin-top: 26px; padding-left: 20px; }
  .rules li { margin-top: 12px; line-height: 1.9; }

  /* ── 表單 ── */
  .signup { margin-top: 28px; padding: clamp(22px, 4vw, 32px); }
  .f { margin-bottom: 18px; }
  .f label, .f .lab { display: block; font-size: 15px; font-weight: 700; margin-bottom: 7px; }
  .f em { font-style: normal; color: var(--act); margin-left: 3px; }
  .f .opt { margin-left: 7px; font-size: 13px; font-weight: 400; color: var(--ink-soft); }
  .f input {
    width: 100%; min-height: 54px; padding: 12px 16px;
    font-family: inherit; font-size: 16px; color: var(--ink);
    background: #fff; border: 1.5px solid var(--line-soft); border-radius: var(--r-btn);
  }
  .f input::placeholder { color: var(--ink-soft); opacity: .75; }
  .f input:focus-visible { border-color: var(--act); outline-offset: 1px; }

  .f-pick { background: var(--bg-alt); border-radius: var(--r-card); padding: 16px 18px; }
  .chosen { font-size: 16px; font-weight: 700; color: var(--act-deep); line-height: 1.7; }
  .relink { display: inline-block; margin-top: 6px; font-size: 14px; }

  .agree { display: flex; gap: 11px; align-items: flex-start; font-size: 15px; line-height: 1.8; }
  .agree input { flex: 0 0 auto; width: 22px; height: 22px; margin-top: 5px; accent-color: var(--act); }

  .signup .btn { width: 100%; margin-top: 22px; }
  .msg { margin-top: 12px; font-size: 15px; font-weight: 600; min-height: 1.5em; text-align: center; }
  .msg[data-state="ok"] { color: var(--t-deep); }
  .msg[data-state="err"] { color: var(--act-deep); }

  /* ── 送出成功後才露出的匯款資訊 ── */
  .done { margin-top: 28px; padding: clamp(24px, 4vw, 34px); }
  .done .atpi-rule { max-width: 120px; margin-bottom: 18px; }
  .done-p { margin-top: 12px; color: var(--ink-soft); line-height: 1.9; }
  .done-p b { color: var(--ink); }

  .bank { margin-top: 22px; border-top: 1px solid var(--line); }
  .bank > div { display: flex; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .bank dt { flex: 0 0 64px; font-size: 14px; color: var(--ink-soft); }
  .bank dd { margin: 0; font-size: 17px; font-weight: 700; }
  .acct { letter-spacing: .06em; }

  .done .btn { margin-top: 20px; }
  .done-note { margin-top: 16px; font-size: 14px; color: var(--ink-soft); }
</style>
