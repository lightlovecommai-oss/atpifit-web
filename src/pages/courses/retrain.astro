---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SHEET_API, LINKS } from '../../consts';

/* 複訓報名表（只給舊生，不對外招生）。
   ⚠️ noindex：這頁是電話邀請時貼的連結，不進搜尋、不進 sitemap。
   ⚠️ 沒串金流——保證金人工對帳，所以匯款資訊只在送出成功後才露出。
   ⚠️ 命名對齊字典（2026-09-01）：鍛鍊段 L1–L4／放大段 L5–L8／演說段 L9 起。
      梯次編號照老師給的班表（D 班＝L9–L12），作廢：一階／二階／三階／Level 1-3／1+1 系統。 */

const title = '超引力成交學・複訓報名';
const description = '舊生複訓專用報名表。ATPI 四塊肌肉＋每天練的 App，都是你當初上課時還不存在的東西。複訓免學費，只收一筆結業當天全額退還的學習態度保證金。';

const DEPOSIT = '5,000';

/* ⚠️ 課程編碼對應白話課名（2026-09-19 老師裁定）：
     L1–L4 鍛鍊段 = 影響力技巧心法
     L5–L8 放大段 = 1v1 顧問腳本
     L9–L12 演說段 = 1vN 公眾演說
   梯次卡要「編碼 + 白話課名」一起露，只給編碼舊生看不懂。 */
const cohorts = [
  {
    id: 'L1-L4-1109',
    range: 'L1–L4',
    stage: '鍛鍊段',
    title: '影響力技巧心法',
    month: '9 月開課',
    rhythm: '每週二、四　09:00–11:00',
    weeks: [
      ['9/29（二）', '10/1（四）'],
      ['10/6（二）', '10/8（四）'],
      ['10/13（二）', '10/15（四）'],
      ['10/20（二）', '10/22（四）'],
    ],
    who: '想把四塊肌肉一塊一塊重新拆開練。',
  },
  {
    id: 'L5-L8-1012',
    range: 'L5–L8',
    stage: '放大段',
    title: '1v1 顧問腳本',
    month: '10 月開課',
    rhythm: '每週一、五　09:30–11:30',
    weeks: [
      ['10/12（一）', '10/16（五）'],
      ['10/19（一）', '10/23（五）'],
      ['10/26（一）', '10/30（五）'],
      ['11/2（一）', '11/6（五）'],
    ],
    who: '單塊都練得動了，卡在一整場對話串不起來。',
  },
  {
    id: 'L5-L8-1110',
    range: 'L5–L8',
    stage: '放大段',
    title: '1v1 顧問腳本',
    month: '11 月開課',
    rhythm: '每週二、四　09:00–11:00',
    weeks: [
      ['11/10（二）', '11/12（四）'],
      ['11/17（二）', '11/19（四）'],
      ['11/24（二）', '11/26（四）'],
      ['12/1（二）', '12/3（四）'],
    ],
    who: '同上，但 10 月的時段排不進來。',
  },
  {
    id: 'L9-L12-1215',
    range: 'L9–L12',
    stage: '演說段',
    title: '1vN 公眾演說',
    month: '12 月開課',
    rhythm: '每週二、四　09:00–11:00',
    weeks: [
      ['12/15（二）', '12/17（四）'],
      ['12/22（二）', '12/24（四）'],
      ['12/29（二）', '12/31（四）'],
      ['1/5（二）', '1/7（四）'],
    ],
    who: '一對一已經會了，卡在一次只能面對一個人。',
    note: '最後一週跨到 2027 年 1 月。',
  },
];

/* 給 Sheet 存的梯次字串：光頭對帳時要一眼看得出是哪一梯，所以帶上白話課名＋開課日 */
const cohortLabel = (c: typeof cohorts[number]) =>
  `${c.range} ${c.stage}・${c.title}｜${c.month}｜${c.rhythm.replace(/　/g, ' ')}`;

/* ⚠️ 維度名對齊字典：吸引／信任／專業／推進「肌肉」，「〇〇力」作廢。
   P 的結果句是「讓他認定你就是那個人」（2026-09-01 定案，不可換成「讓他知道你有解答」）。 */
const atpi = [
  { dim: 'A', code: 'A', name: '吸引肌肉', r: '讓他想靠近你',
    b: '開口的前三十秒就決定了他要不要繼續聽。這塊練的是怎麼讓人自己靠過來，而不是你追過去。' },
  { dim: 'T', code: 'T', name: '信任肌肉', r: '讓他願意講真話',
    b: '他講的第一個問題通常不是真的問題。這塊練的是怎麼讓他把真正卡住的地方拿出來。' },
  { dim: 'P', code: 'P', name: '專業肌肉', r: '讓他認定你就是那個人',
    b: '不是講得多深，是講得讓他看見自己的處境。這塊練的是把你會的東西，換成他聽得懂的樣子。' },
  { dim: 'I', code: 'I', name: '推進肌肉', r: '讓他現在就動',
    b: '聊得很好卻沒有下一步，問題都出在這塊。這塊練的是怎麼把一場好對話收成一個決定。' },
];

const rules = [
  '每一梯八堂。你報的每一梯，缺席都在 <b>2 堂（含）以內</b>，保證金<span class="nb">全額退還</span>。',
  '任何一梯缺席 <b>3 堂（含）以上</b>，保證金不退。<span class="nb">這條先講清楚</span>，不等到最後再解釋。',
  '要請假請事先說，不要當天消失——課中是分組對練，你沒到，你那組就少一個人。',
  '課堂內容與同學講的案例都不外流。',
];
---

<BaseLayout title={title} description={description} noindex={true} bodyClass="no-sticky">
  <section class="section">
    <div class="wrap-text">
      <p class="kicker">複訓梯・只給舊生</p>
      <h1>你上課的那時候，<br />這套系統<span class="hl">還不存在</span></h1>
      <p class="lead head-lead">現在溝通被拆成四塊肌肉、十二個小肌群，而且有一支 App 讓你每天練得到。所以這不是回來複習——是來拿一套你當初沒有的東西。複訓<span class="nb">免學費</span>，只收一筆<span class="nb">結業當天退還</span>的保證金。</p>
      <div class="atpi-rule sig"><i></i><i></i><i></i><i></i></div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap-text">
      <h2>ATPI：把溝通拆成四塊肌肉</h2>
      <p class="lead">你當初學的是一招一招的作法。現在它們被歸位了——<b>吸引・信任・專業・推進</b>，每一招都屬於其中一塊。<span class="nb">先練哪一塊最有感、今天該做哪個動作</span>，都指得出來。</p>

      <details class="atpi-details">
        <summary>
          <span class="atpi-more atpi-more-closed">看四塊肌肉分別是什麼</span>
          <span class="atpi-more atpi-more-open">收起</span>
          <span class="atpi-fold" aria-hidden="true"></span>
        </summary>

        <ol class="atpi">
          {atpi.map((m) => (
            <li class="card muscle" data-dim={m.dim}>
              <span class="mcode" aria-hidden="true">{m.code}</span>
              <h3>{m.name}</h3>
              <p class="mres">{m.r}</p>
              <p class="mbody">{m.b}</p>
            </li>
          ))}
        </ol>

        <p class="mnote">四塊底下再各拆三塊小肌群，一共十二塊。入學前後各量一次，十二格的變化看得到。</p>
      </details>
    </div>
  </section>

  <section class="section">
    <div class="wrap-text">
      <div class="app">
        <p class="kicker">最大的差別</p>
        <h2>肌肉不是在教室長出來的</h2>
        <p class="app-p">課一週兩堂，中間那五天才是真的在練。以前上完課，你回去只能靠筆記跟感覺；現在有影響力健身房 App，每天一分鐘，把「對誰講了什麼、對方什麼反應」記下來——累積起來就是你自己的體格表。</p>
        <p class="app-p app-last"><b>課負責教你怎麼練，App 負責讓你真的天天練。</b>這一組東西，你當初上課的時候完全不存在。</p>

        <div class="app-btns">
          <a class="btn btn-sub" href={`${LINKS.gym}pro.html?demo=1&next=quiz`} target="_blank" rel="noopener">
            打開 App 看一眼<span class="btn-note">示範帳號，不用登入</span>
          </a>
          <a class="btn btn-sub" href={LINKS.quiz} target="_blank" rel="noopener">
            先量一次影響力健檢<span class="btn-note">十二格的起點，開課前先留著</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="pick-top">
    <div class="wrap-text">
      <h2>四梯，想上幾梯都可以</h2>
      <p class="lead">每一梯都是八堂、四週。可以複選，全部報也可以——<span class="nb">保證金還是那一筆</span>。</p>

      <div class="picks">
        {cohorts.map((c) => (
          <label class="pick card">
            <input type="checkbox" name="cohort" value={cohortLabel(c)} />
            <span class="tick" aria-hidden="true"></span>
            <span class="pick-body">
              <span class="pick-tag">{c.range}　{c.stage}</span>
              <span class="pick-title">{c.title}</span>
              <span class="pick-when"><b class="pick-month">{c.month}</b><span class="pick-when-sep">・</span>{c.rhythm}<span class="pick-when-sep">・</span>共 8 堂</span>

              <ol class="pick-weeks">
                {c.weeks.map((w, i) => (
                  <li>
                    <span class="wk-i">第 {i + 1} 週</span>
                    <span class="wk-days">{w.map((d) => <span class="wk-d">{d}</span>)}</span>
                  </li>
                ))}
              </ol>

              <span class="pick-w">{c.who}</span>
              {c.note && <span class="pick-n">{c.note}</span>}
            </span>
          </label>
        ))}
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="wrap-text">
      <h2>費用與課程守則</h2>

      <div class="money">
        <p class="money-big">複訓不收學費。四梯都一樣。</p>
        <p>報名時繳 <b>{DEPOSIT} 元</b>學習態度保證金。<br />不管你報幾梯，<span class="nb">就是這一筆</span>，<span class="nb">最後一梯結業當天全額退還</span>。</p>
        <p class="money-why">保證金不是營收，是為了讓每一堂課真的有人坐在裡面。課中是分組對練，少一個人，剩下的人就少一個對練的對象。</p>
      </div>

      <ul class="rules">
        {rules.map((r) => <li set:html={r} />)}
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="wrap-text">
      <div class="quote">
        <p>影響力練起來，是為了給出去，<br />不是為了贏誰。</p>
        <cite>— 光頭</cite>
      </div>
    </div>
  </section>

  <section class="section section-alt" id="signup">
    <div class="wrap-text">
      <h2>填一下，我們就把你排進去</h2>
      <p class="lead">送出之後這一頁會給你匯款帳號。<span class="nb">保證金入帳，報名才算完成。</span></p>

      <form class="signup card" id="signup-form" data-endpoint={SHEET_API} novalidate>
        <div class="f">
          <label for="su-name">姓名（或你在課堂上的綽號）<em>＊</em></label>
          <input id="su-name" name="name" type="text" autocomplete="name" required placeholder="我們點名會叫這個" />
        </div>

        <div class="f">
          <label for="su-line">LINE ID<em>＊</em></label>
          <input id="su-line" name="lineIdText" type="text" required placeholder="方便把你加進課程群組" />
        </div>

        <div class="f">
          <label for="su-email">Email<em>＊</em></label>
          <input id="su-email" name="email" type="email" autocomplete="email" required placeholder="課前通知與錄播連結寄這裡" />
        </div>

        <div class="f">
          <label for="su-phone">電話<span class="opt">選填</span></label>
          <input id="su-phone" name="phone" type="tel" autocomplete="tel" placeholder="突然的急事也許會用到" />
        </div>

        <div class="f f-pick">
          <span class="lab">你選的梯次</span>
          <ul class="chosen" id="su-chosen"></ul>
          <a class="relink" href="#pick-top">要改？回上面重選</a>
        </div>

        <label class="agree">
          <input type="checkbox" id="su-agree" name="agree" required />
          <span>我是舊生，我看過上面的課程守則，願意遵守——包含任何一梯缺席 3 堂以上，保證金不退。</span>
        </label>

        <button class="btn btn-main" type="submit">送出報名</button>
        <p class="msg" id="su-msg" role="status" aria-live="polite"></p>
      </form>

      <div class="done card" id="signup-done" hidden>
        <div class="atpi-rule"><i></i><i></i><i></i><i></i></div>
        <h3>收到了，名字已經在名單上。</h3>
        <p class="done-p">最後一步是保證金。<b>{DEPOSIT} 元</b>匯到下面這個帳戶。<br /><span class="nb">沒有線上金流，光頭是人工對帳</span>，所以匯完麻煩<b class="nb">把後五碼用 LINE 傳給他</b>，這樣對得比較快。</p>

        <dl class="bank">
          <div><dt>銀行</dt><dd>星展銀行（810）</dd></div>
          <div><dt>帳號</dt><dd class="acct num">60604709488</dd></div>
          <div><dt>戶名</dt><dd>徐哲彥</dd></div>
          <div><dt>金額</dt><dd class="num">NT$ {DEPOSIT}</dd></div>
        </dl>

        <button class="btn btn-sub" type="button" id="copy-acct">複製帳號</button>
        <p class="done-note">這筆錢結業當天原數退還。它不是學費，是位子。</p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('signup-form') as HTMLFormElement;
  const done = document.getElementById('signup-done') as HTMLElement;
  const chosen = document.getElementById('su-chosen') as HTMLElement;
  const msg = document.getElementById('su-msg') as HTMLElement;
  const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
  const boxes = Array.from(document.querySelectorAll<HTMLInputElement>('input[name="cohort"]'));

  /* 多選：一個人可以同時報好幾梯。Sheet 存成一格，用 ／ 串起來。 */
  const picked = () => boxes.filter((r) => r.checked).map((r) => r.value);
  const syncChosen = () => {
    const list = picked();
    chosen.innerHTML = '';
    if (!list.length) {
      const li = document.createElement('li');
      li.className = 'none';
      li.textContent = '還沒選。回上面點你要上的梯次，可以複選。';
      chosen.append(li);
      return;
    }
    list.forEach((v) => {
      const li = document.createElement('li');
      li.textContent = v;
      chosen.append(li);
    });
  };
  boxes.forEach((r) => r.addEventListener('change', syncChosen));
  syncChosen();

  const say = (text: string, ok = false) => {
    msg.textContent = text;
    msg.dataset.state = ok ? 'ok' : 'err';
  };

  const val = (id: string) => (document.getElementById(id) as HTMLInputElement).value.trim();

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const name = val('su-name');
    const lineId = val('su-line');
    const email = val('su-email');
    const agree = (document.getElementById('su-agree') as HTMLInputElement).checked;

    /* 擋下來的只有「之後找不到人」的欄位。守則同意是承諾，也不能跳過。 */
    if (!name) return say('姓名還沒填，我們點名會叫這個。');
    if (!lineId) return say('LINE ID 還沒填，沒有它沒辦法把你加進群組。');
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return say('這個 Email 看起來不太對，再確認一下？');
    if (!picked().length) return say('還沒選梯次。回上面點你要上的，可以複選。');
    if (!agree) return say('守則那一格還沒勾。');

    btn.disabled = true;
    const original = btn.textContent;
    btn.textContent = '送出中…';
    say('');

    const payload = {
      action: 'signup',
      name, lineIdText: lineId, email,
      phone: val('su-phone'),
      cohort: picked().join('　／　'),
      agree: true,
      timestamp: new Date().toISOString(),
      track: (window as any).trackPayload?.() ?? {},
    };

    try {
      /* text/plain＝簡單請求，不觸發 CORS 預檢（跟訂閱／測驗端同一個做法） */
      const r = await fetch(form.dataset.endpoint!, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(payload),
      });
      const d = await r.json().catch(() => ({}));
      if (!r.ok || d.status !== 'ok') throw new Error(d.status || `HTTP ${r.status}`);

      form.hidden = true;
      done.hidden = false;
      done.scrollIntoView({ behavior: 'smooth', block: 'start' });
      /* 兩個都送不是重複計數：lead_submit 是「留了聯絡方式」（跟訂閱同一層），
         workshop_register 是「報名了梯次」——漏斗第⑦段只認得後者。
         ⚠️ 這裡**不送 purchase**：保證金是匯款，瀏覽器看不到錢有沒有進來。 */
      try {
        (window as any).track?.('lead_submit', { source: 'retrain' });
        (window as any).track?.('workshop_register', {
          workshop_id: 'retrain-2026Q4',
          cohort: picked().join(' / '),
          cohort_count: picked().length,
        });
      } catch {}
    } catch (err) {
      console.warn('報名送出失敗：', err);
      say('送出的時候出了點狀況，麻煩再按一次。連按兩次不會重複報名。');
      btn.disabled = false;
      btn.textContent = original;
    }
  });

  document.getElementById('copy-acct')?.addEventListener('click', async (e) => {
    const b = e.currentTarget as HTMLButtonElement;
    try {
      await navigator.clipboard.writeText('60604709488');
      b.textContent = '已複製';
      setTimeout(() => { b.textContent = '複製帳號'; }, 2000);
    } catch {
      b.textContent = '複製失敗，請手動選取';
    }
  });
</script>

<style is:global>
  /* 這頁的主行動是報名鈕，不是健檢。sticky 欄留著會變成一頁兩顆主鈕。 */
  body.no-sticky .sticky-quiz { display: none !important; }

  /* 這兩條必須是 global：守則那幾條走 set:html，裡面的標籤拿不到 Astro 的 scope class。 */
  .nb { white-space: nowrap; }
  .rules b { color: var(--act-deep); }
</style>

<style>
  .head-lead { max-width: 46ch; margin-top: 16px; }
  .sig { margin-top: 28px; max-width: 160px; }

  /* ── ATPI 四塊。順序鎖 A→T→P→I，靠左色條＋角落字母 ── */
  .atpi-details { margin-top: 22px; }
  .atpi-details > summary {
    list-style: none; cursor: pointer;
    display: inline-flex; align-items: center; gap: 8px;
    padding: 12px 20px; border-radius: var(--r-btn);
    background: #fff; border: 1.5px solid var(--line);
    color: var(--act-deep); font-weight: 700; font-size: 15.5px;
  }
  .atpi-details > summary::-webkit-details-marker { display: none; }
  .atpi-details > summary::marker { content: ''; }
  .atpi-fold {
    width: 10px; height: 10px; border: solid var(--act-deep);
    border-width: 0 2px 2px 0; transform: rotate(45deg);
    transition: transform .2s; margin-top: -3px;
  }
  .atpi-details[open] > summary { background: var(--a-tint); border-color: var(--act-deep); }
  .atpi-details[open] .atpi-fold { transform: rotate(-135deg); margin-top: 3px; }
  .atpi-more-open { display: none; }
