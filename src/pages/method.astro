---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import { SITE, LINKS } from '../consts';

const title = 'ATPI 四塊影響力肌肉｜方法論';
const description =
  '影響力可以拆成吸引、信任、專業、推進四塊肌肉，每一塊都有方向、有動作、有檢查點。這頁把整套方法攤開：四塊在解決什麼、為什麼是這個順序、怎麼練、怎麼驗收。';

/* 值全部鎖在字典 01。結果句 01:58–61、方向問句 01:116、12 小肌群、身體對照，一律不自行改寫。 */
const muscles = [
  {
    dim: 'A', en: 'ATTRACT', name: '吸引肌肉',
    ask: '他願意留多久？', result: '讓他想靠近', body: '背',
    role: '點火。把溫度從零帶到有，特色是快生快滅。',
    subs: ['讓他開口', '讓他追問', '讓他記得'],
    slug: 'attract-muscle',
  },
  {
    dim: 'T', en: 'TRUST', name: '信任肌肉',
    ask: '誰先給？', result: '讓他願意說', body: '核心',
    role: '抬底線。一旦建立就不容易掉回去，四塊裡唯一不可逆的。',
    subs: ['讓他敢說', '讓他交心', '讓他當真'],
    slug: 'trust-muscle',
  },
  {
    dim: 'P', en: 'PROFESSIONAL', name: '專業肌肉',
    ask: '怎麼證明你能解？', result: '讓他要找你', body: '胸',
    role: '墊天花板。但底線沒到的時候，專業講得越多越糟。',
    subs: ['讓他釐清', '讓他有感', '讓他放心'],
    slug: 'professional-muscle',
  },
  {
    dim: 'I', en: 'IMPACT', name: '推進肌肉',
    ask: '他還差什麼？', result: '讓他願意動', body: '下肢',
    role: '閥門。溫度到了不趁熱推進，它就會涼掉。',
    subs: ['讓他想要', '讓他敢要', '讓他答應'],
    slug: 'impact-muscle',
  },
];

const faq = [
  {
    q: 'ATPI 是什麼意思？',
    a: 'A 是 ATTRACT 吸引肌肉、T 是 TRUST 信任肌肉、P 是 PROFESSIONAL 專業肌肉、I 是 IMPACT 推進肌肉。這是把影響力拆開之後的四塊，順序永遠是 A→T→P→I，不會依照分數高低重排。',
  },
  {
    q: '四塊肌肉是相加還是相乘？',
    a: '相乘。這代表還沒練起來的那一塊會拖住整體，也代表練那一塊漲最多，所以先練它最有感。要注意的是相乘是在描述關係，不是說少一塊就等於零。',
  },
  {
    q: 'ATPI 有沒有包含聲音、表情、肢體？',
    a: '沒有，這是刻意排除的。ATPI 只管說什麼、練什麼，也就是內容；聲音、身體、節奏、停頓屬於表達的載體，是另一個系統。在健身房的比喻裡，ATPI 是重訓，表達載體是有氧與柔軟度。',
  },
  {
    q: '為什麼叫「肌肉」不叫「能力」？',
    a: '因為「力」是天賦語氣，聽起來像有或沒有；「肌肉」是可練語氣，練了就長。這個用詞差異是整套方法的立場：影響力是肌肉，只會越練越強。',
  },
  {
    q: '這套方法只有做業務的人用得到嗎？',
    a: '不是。四塊肌肉處理的是「怎麼讓你說的話真的在對方身上發生作用」，這件事在家庭、職場、合作、教學裡都一樣。實際使用的場景大約三成人際、三成家庭、四成商務創業。',
  },
];

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${SITE.url}/method/#webpage`,
    name: title,
    description,
    url: `${SITE.url}/method/`,
    inLanguage: 'zh-Hant-TW',
    isPartOf: { '@id': `${SITE.url}/#website` },
  },
  {
    '@type': 'FAQPage',
    '@id': `${SITE.url}/method/#faq`,
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <!-- ═══ 開場：把「拆開」演在版面上 ═══
       標題壓在左欄、地圖出血到兩側，兩者刻意不共用同一條左界，讓版面本身是被剖開的。
       出血層帶視差：捲動時地圖與標題以不同速度移動，那個錯位就是「拆」。 -->
  <!-- ⚠️ 這頁不放 .slice-field：薄片場是 12 條小肌群，下面的地圖也是 12 條小肌群，
       兩套疊在一起會變成一團斜線，誰都讀不出來。地圖就是這頁的薄片宣告。 -->
  <section class="mhero">
    <div class="wrap mhead">
      <p class="kicker reveal">方法</p>
      <!-- .nb 把子句包成不可剖半的整塊：沒有它，大標會斷成「影響力可以拆／開」。 -->
      <h1 class="display reveal" style="--rd:.06s"><span class="nb">影響力可以拆開，</span><span class="nb hl">所以可以練</span></h1>
      <!-- ⚠️ 中文段落一律寫成單行：原始碼換行會變成一個空白，在中文裡會看成排版破洞。 -->
      <p class="lead head-lead reveal" style="--rd:.12s">整團的「影響力」沒辦法練，因為你不知道要練什麼。拆成四塊、<span class="nb">再拆成十二個看得到的行為</span>之後，每一個都有具體的動作可以做，也有對方的反應可以檢查。</p>
    </div>

    <!-- 12 小肌群薄片地圖（24 §3.9 八條）：一條基線、斜切共軸鎖畫面中線 y=175、
         全部淡底＋深版描邊（紅線：實色最多兩片——這張 0 片；I 金一律淡底＋深版描邊與字）。
         片高遞增＝三條小肌群是一階一階往上練的梯；字是標籤貼片下、放斜切群組外保持直立。
         標籤 x 補 skew 位移：底邊在 y=250，往左位移 tan12°×75≈16px。 -->
    <div class="mmap-bleed" data-px=".5" style="--px-amt:-30px">
      <div class="mmap-scroll reveal" style="--rd:.18s">
        <svg class="mmap" viewBox="0 88 940 256" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
          <line x1="26" y1="250" x2="914" y2="250" stroke="var(--ink)" stroke-width="3" opacity=".25" stroke-linecap="round" />
          <g class="skew-axis" style="--axis: 175px">
            {muscles.map((m, g) =>
              m.subs.map((_, s) => (
                <rect
                  x={40 + g * 224 + s * 66}
                  y={250 - (96 + s * 28)}
                  width="56"
                  height={96 + s * 28}
                  rx="8"
                  fill={`var(--${m.dim.toLowerCase()}-tint)`}
                  stroke={`var(--${m.dim.toLowerCase()}-deep)`}
                  stroke-width="2"
                />
              ))
            )}
          </g>
          {muscles.map((m, g) => (
            <>
              {m.subs.map((sub, s) => (
                <text x={40 + g * 224 + s * 66 + 12} y="278" font-size="15" font-weight="600" fill="var(--ink)" text-anchor="middle">{sub}</text>
              ))}
              <text x={40 + g * 224 + 78} y="312" font-size="18" font-weight="800" fill={`var(--${m.dim.toLowerCase()}-deep)`} text-anchor="middle">{m.name}</text>
              <text x={40 + g * 224 + 78} y="334" font-size="13.5" fill="var(--ink-soft)" text-anchor="middle">{m.ask}</text>
            </>
          ))}
        </svg>
      </div>
    </div>

    <div class="wrap">
      <p class="mmap-note reveal" style="--rd:.24s">一片＝一條小肌群，三片一組＝一塊大肌肉。十二個名字的主詞<span class="nb">全在對方身上</span>——<span class="nb">練到哪，看他的反應就知道。</span></p>
    </div>
  </section>

  <section class="section section-skew">
    <div class="wrap">
      <h2 class="reveal">四塊肌肉，各自在解決什麼</h2>
      <p class="lead reveal" style="--rd:.06s">每一塊都對應一個問句。你在對話裡卡住的地方，通常就是其中一個問句你還沒有答案。</p>

      <!-- 四塊改成四條全幅橫帶，不用 2×2 卡片網格：
           卡片會把四塊排成「四個選項」，但它們其實是一條會升溫的順序。
           橫帶讓 A→T→P→I 只能由上往下讀一次，順序就變成版面本身在說的事。 -->
      <ol class="bands">
        {muscles.map((m, i) => (
          <li class="band reveal" data-dim={m.dim} style={`--rd:${0.06 + i * 0.05}s`}>
            <div class="band-id">
              <span class="band-ghost" aria-hidden="true" data-px=".5" style="--px-amt:18px">{m.dim}</span>
              <span class="band-en">{m.en}</span>
              <h3 class="band-name">{m.name}</h3>
              <p class="band-result">{m.result}</p>
            </div>

            <div class="band-spec">
              <dl class="spec">
                <dt>要練的方向</dt><dd>{m.ask}</dd>
                <dt>在關係裡的角色</dt><dd>{m.role}</dd>
                <dt>身體上的對照</dt><dd>{m.body}</dd>
              </dl>
            </div>

            <div class="band-subs">
              <p class="subs-label">三個小肌群</p>
              <!-- 用薄片而不是頓號串字：三條小肌群是一階一階往上練的梯，
                   遞增的片高把那個順序畫出來，跟上面的地圖同一套語彙。 -->
              <ul class="subs">
                {m.subs.map((sub, s) => (
                  <li style={`--sh:${54 + s * 16}px`}><i></i><span>{sub}</span></li>
                ))}
              </ul>
              <a class="more" href={`/glossary/${m.slug}/`}>看這塊怎麼練 →</a>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap-text">
      <!-- 長文段落刻意不掛 .reveal：一段一段淡進來會讓閱讀變得一頓一頓。
           只有標題與規則塊揭示，節奏在骨架上，不在正文裡。 -->
      <h2 class="reveal">順序不是隨便排的</h2>
      <p>A、T、P、I 這個順序描述的是一段關係怎麼升溫。A 是點火，把溫度從零帶到有；T 是抬底線，信任一旦建立就不容易掉回去；P 是墊天花板，但底線沒到的時候，專業講得越多越糟；I 是閥門，溫度到了不趁熱推進，它就會涼掉。</p>

      <div class="atpi-rule reveal"><i></i><i></i><i></i><i></i></div>

      <p class="rule-line reveal">信賴感是門檻，解決問題是放大器；門檻沒過，專業是負分。</p>

      <p>這也解釋了一個很常見的挫折：你明明準備得很充分、東西講得很清楚，對方卻沒有反應。因為 P 在 T 還沒到位的時候是不生效的，你在墊一個還沒立起來的天花板。</p>

      <h2 class="reveal">四塊是相乘，不是相加</h2>
      <p>這件事有一個很實用的推論：<strong>還沒練起來的那一塊，練起來漲最多。</strong></p>
      <p>假設你的專業已經很強，再往上加，整體感受不會差太多；但如果信任那塊還沒開始練，把它拉起來一點，整體會明顯不一樣。這就是為什麼健檢做完之後，我們給的建議永遠是「先練這塊最有感」，而不是告訴你哪裡不好。</p>

      <h2 class="reveal">ATPI 不管什麼</h2>
      <p>ATPI 只管「說什麼、練什麼」，也就是內容本身。聲音、表情、肢體、節奏、停頓，這些屬於表達的載體，是另一個系統。</p>
      <p>這是刻意排除，不是漏掉。在健身房的比喻裡，ATPI 是重訓，表達載體是有氧與柔軟度，兩個都需要，但不會混在同一張課表裡練。</p>

      <h2 class="reveal">怎麼知道自己練起來了</h2>
      <p>用對方的反應當尺，不用自我感覺當尺。</p>
      <p>判斷你的信任肌肉有沒有練起來，不是問你覺得自己夠不夠真誠，而是看對方有沒有開始跟你說他原本不會說的事。十二個小肌群的名字主詞全都在對方身上，這是刻意的設計：多數溝通訓練問「你做了什麼」，這套問「他變成什麼樣」。</p>

      <h2 class="reveal">這套拆法不是憑空發明的</h2>
      <p>四塊肌肉、十二個小肌群，每一格背後都接得到一個既有的知識體系——古典修辭學、動機式晤談、訊號理論，也包括《論語》《荀子》《孟子》。我們把每一格接到哪裡、為什麼接得上、以及<strong>哪裡接不上</strong>，連同原文與出處一條一條寫出來了。</p>
      <p>裡面也列了九句看起來完美貼合、但查出來是誤植的名言。培訓市場引用率最高的那幾句就在其中。</p>
      <p class="lineage-link"><a href="/lineage">看理論血緣與引用查證</a></p>

      <div class="btn-row reveal">
        <a class="btn btn-main" href={LINKS.quiz}
           data-cta="method_quiz" data-cta-position="body">免費做影響力健檢</a>
        <a class="btn btn-sub" href="/glossary/">看完整名詞表</a>
      </div>
    </div>
  </section>

  <section class="section section-skew">
    <div class="wrap-text reveal">
      <Newsletter source="method" variant="sub" />
    </div>
  </section>

  <section class="section">
    <div class="wrap-text">
      <h2 class="reveal">常見問題</h2>
      <dl class="faq reveal" style="--rd:.08s">
        {faq.map((f) => (
          <>
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </>
        ))}
      </dl>
    </div>
  </section>
</BaseLayout>

<style>
  /* ═══ 開場 ═══ */
  .mhero {
    position: relative;
    overflow: hidden;
    padding: clamp(48px, 8vw, 96px) 0 clamp(40px, 6vw, 72px);
  }
  /* 標題欄縮到六成寬並靠左：右邊那塊空白是留給地圖出血用的，不是沒排滿 */
  .mhead { position: relative; max-width: 62ch; }
  .head-lead { max-width: 50ch; margin-top: 14px; }

  /* 地圖不進 .wrap：整塊貼齊視窗左右，出血本身就是「拆開」的動作。
     它是 .mhero 的直接子代，所以沒有版心邊界要掙脫。 */
  .mmap-bleed { position: relative; margin-top: 44px; }

  /* 薄片地圖：桌機滿版縮放；窄螢幕保住字級、改橫向滑動 */
  .mmap-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .mmap { width: 100%; min-width: 720px; height: auto; }
  .mmap-note { margin-top: 16px; font-size: 14.5px; color: var(--ink-soft); max-width: 62ch; }

  /* ═══ 四條肌肉橫帶 ═══ */
  .bands { list-style: none; padding: 0; margin: 40px 0 0; }
  .band {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1.15fr) minmax(0, .95fr);
    gap: clamp(20px, 3.4vw, 52px);
    align-items: start;
    padding: clamp(28px, 4vw, 44px) 0;
    border-top: 1px solid var(--line);
  }
  .band:last-child { border-bottom: 1px solid var(--line); }

  /* 巨型幽靈字母：墊在肌肉名後面當份量，不負責資訊（aria-hidden＋不可選）。
     ⚠️ 不要放在小肌群薄片那一欄：兩個都是色塊，疊起來會互相吃掉。 */
  .band-id { position: relative; }
  .band-ghost {
    position: absolute; left: -.18em; top: -.26em;
    z-index: 0;
    font-size: clamp(104px, 13vw, 168px);
    font-weight: 900;
    line-height: .8;
    letter-spacing: -.06em;
    /* 描邊而不是填色：填色在四個維度色下明暗差太多，輕的看不見、重的變色斑；
       描邊讓四條帶的份量一致，也才看得出來那是一個字母而不是一塊污漬。 */
    color: transparent;
    -webkit-text-stroke: 1.5px var(--dim);
    opacity: .22;
    pointer-events: none;
    user-select: none;
  }
  .band-en, .band-name, .band-result { position: relative; z-index: 1; }
  .band-en {
    display: block; font-size: 12px; font-weight: 700;
    letter-spacing: .16em; color: var(--dim-deep);
  }
  .band-name { margin-top: 6px; font-size: clamp(24px, 3.2vw, 34px); line-height: 1.25; }
  .band-result {
    margin-top: 8px; font-size: clamp(17px, 2vw, 20px);
    font-weight: 700; color: var(--dim-deep);
  }

  .band-spec, .band-subs { position: relative; }

  /* 小肌群薄片梯：片高遞增＝一階一階往上練，跟開場地圖同一套語彙 */
  .subs-label {
    font-size: 13px; font-weight: 700; letter-spacing: .04em; color: var(--ink-soft);
  }
  .subs {
    list-style: none; padding: 0;
    margin: 12px 0 0;
    display: flex; align-items: flex-end; gap: 10px;
  }
  .subs li { flex: 1; display: flex; flex-direction: column; gap: 8px; }
  .subs i {
    display: block; height: var(--sh);
    background: var(--dim-tint);
    border: 2px solid var(--dim-deep);
    border-radius: 8px;
    transform: skewX(var(--skew));
  }
  .subs span { font-size: 13.5px; font-weight: 600; line-height: 1.4; }

  @media (max-width: 900px) {
    .band { grid-template-columns: 1fr 1fr; }
    .band-id { grid-column: 1 / -1; }
  }
  @media (max-width: 620px) {
    .band { grid-template-columns: 1fr; gap: 22px; }
    .band-ghost { font-size: clamp(88px, 24vw, 120px); -webkit-text-stroke-width: 1.5px; opacity: .34; }
  }

  .spec { font-size: 15px; }
  .spec dt {
    font-size: 13px; font-weight: 700; color: var(--ink-soft);
    letter-spacing: .04em; margin-top: 12px;
  }
  .spec dt:first-child { margin-top: 0; }
  .spec dd { margin: 3px 0 0; line-height: 1.75; }

  .more {
    display: inline-block; margin-top: 20px; font-size: 15px;
    font-weight: 600; color: var(--dim-deep); text-decoration: none;
  }
  .more:hover { text-decoration: underline; }

  .rule-line {
    margin: 4px 0 28px; font-size: 19px; font-weight: 700;
    line-height: 1.8; text-align: center; color: var(--act-deep);
  }

  /* 這條連結緊跟在主行動鈕上面，所以要讀得出是「延伸閱讀」不是第三顆鈕。 */
  .lineage-link { margin: 18px 0 34px; font-weight: 600; }

  .faq { margin-top: 24px; }
  .faq dt { font-weight: 700; font-size: 18px; margin-top: 28px; }
  .faq dd { margin: 8px 0 0; color: var(--ink-soft); line-height: 1.9; }
</style>
