---
/* 乾貨訂閱專屬著陸頁。LINE OA rich menu 右下格直接跳這。
   跟 Newsletter 元件的差別：這頁只收 email，不提 LINE 入口——
   使用者多半是從 LINE 來的，再推 LINE 等於原地踏步。

   文案方向：拿消費者想要的結果吸引他（皮 > 肉 > 骨 的順序；
   見 productkit CLAUDE.md 的「對消費者皮優先」）。
   頁面裡講的「結果」一律對得上 ATPI 四結果句——
   A=讓他想靠近 / T=讓他願意說 / P=讓他要找你 / I=讓他願意動。

   後端走 SHEET_API（跟官網文章頁、首頁的訂閱共用一支 Apps Script）。*/
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE, SHEET_API, CASES } from '../consts';

const title = '乾貨訂閱';
const description = '每週一封信，拆一塊「影響力肌肉」的練法——練到他主動來找你。';
const source = 'subscribe-page';

/* 挑一個案例當社會證明。王偉翔是負債 100 萬轉行到府按摩、單月做到 13.5 萬——
   「主動開口的客源」最能證明這封信在練的東西。 */
const featureCase = CASES.find((c) => c.name === '王偉翔') ?? CASES[0];

const schema = {
  '@type': 'WebPage',
  '@id': `${SITE.url}/subscribe/#webpage`,
  name: title,
  description,
  url: `${SITE.url}/subscribe/`,
  inLanguage: 'zh-Hant-TW',
  isPartOf: { '@id': `${SITE.url}/#website` },
};
---

<BaseLayout title={title} description={description} schema={schema}>
  <section class="section hero">
    <div class="wrap-text">
      <p class="kicker">乾貨訂閱 · 每週一封</p>
      <h1>
        讓他主動<span class="hl">想找你</span><br>的那種溝通
      </h1>
      <p class="lead">
        不用追著賣、不用自我吹捧、不用壓單——每週一封信，拆一塊<b>影響力肌肉</b>怎麼練，附一個今天就能試的動作。
      </p>
      <p class="lead-fine">免費，看到不喜歡隨時可退。</p>
    </div>
  </section>

  <section class="section benefits-sec">
    <div class="wrap-text">
      <h2 class="section-title">練下去，三件事會變</h2>
      <ol class="benefits">
        <li class="benefit b-a">
          <span class="n">01</span>
          <div>
            <h3>從追著賣，變有人主動開口</h3>
            <p>吸引肌肉練起來，客人會自己過來講他的狀況，不是你去講服務。</p>
          </div>
        </li>
        <li class="benefit b-t">
          <span class="n">02</span>
          <div>
            <h3>從對方不講真的，變他願意講</h3>
            <p>信任肌肉練起來，第一次見面對方就會把真正的卡點說出來，不只是客氣。</p>
          </div>
        </li>
        <li class="benefit b-p">
          <span class="n">03</span>
          <div>
            <h3>從自己推銷，變專業被看見</h3>
            <p>專業肌肉練起來，報價不用自己開口；對方會直接問「怎麼合作」。</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="section first-letter">
    <div class="wrap-text">
      <div class="letter-card">
        <p class="kicker">第一封立刻到</p>
        <h3>〈先練吸引，還是信任？〉</h3>
        <p class="letter-lead">
          90% 的人在這一題就答錯——以為自己缺信任，其實少的是吸引；
          或反過來。這封信給你一個 30 秒的判斷法，先搞清楚自己缺哪塊，再來練。
        </p>
      </div>
    </div>
  </section>

  <section class="section form-outer">
    <div class="wrap-text">
      <section class="form-sec" aria-labelledby="form-title">
        <h2 id="form-title">留 Email，第一封就來</h2>
        <form class="form" data-source={source} data-endpoint={SHEET_API} novalidate>
          <div class="fields">
            <label class="visually-hidden" for="nl-email">Email</label>
            <input id="nl-email" name="email" type="email" autocomplete="email" required
                   placeholder="你的 Email" aria-describedby="nl-msg" />
            <button class="btn btn-main" type="submit">開始收信</button>
          </div>
          <p class="msg" id="nl-msg" role="status" aria-live="polite"></p>
          <p class="fine">我們不寄廣告，也不會把你的 Email 給任何人。隨時可以退訂。</p>
        </form>
      </section>
    </div>
  </section>

  {featureCase && (
    <section class="section case-sec">
      <div class="wrap-text">
        <p class="kicker">練完的人後來怎麼了</p>
        <figure class="case">
          <blockquote>「{featureCase.quote}」</blockquote>
          <figcaption>
            <strong>{featureCase.name}</strong>
            <span>　{featureCase.who}</span>
            {featureCase.stat && (
              <span class="stat"><b>{featureCase.stat.num}</b>　{featureCase.stat.label}</span>
            )}
          </figcaption>
        </figure>
      </div>
    </section>
  )}

  <section class="section bone-sec">
    <div class="wrap-text bone">
      <p>練溝通不是為了壓過誰——</p>
      <p><b>是為了讓你想幫到的人，真的被你幫到。</b></p>
    </div>
  </section>
</BaseLayout>

<script>
  /* 低摩擦守則（規範 31）：追蹤或網路出事都不可以卡住使用者，一律只寫 console。 */
  const form = document.querySelector<HTMLFormElement>('.form')!;
  const email = form.querySelector<HTMLInputElement>('input[name="email"]')!;
  const btn = form.querySelector<HTMLButtonElement>('button')!;
  const msg = form.querySelector<HTMLElement>('.msg')!;
  const endpoint = form.dataset.endpoint!;

  const say = (text: string, good = false) => {
    msg.textContent = text;
    msg.classList.toggle('ok', good);
    msg.classList.toggle('err', !good);
  };

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const value = email.value.trim();
    if (!value || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)) {
      say('請留下你的 Email。');
      email.focus();
      return;
    }
    btn.disabled = true;
    const original = btn.textContent;
    btn.textContent = '送出中…';
    msg.textContent = '';

    const payload = {
      action: 'subscribe',
      email: value,
      name: '',
      source: form.dataset.source || 'subscribe-page',
      page: location.pathname,
      timestamp: new Date().toISOString(),
      track: (window as any).trackPayload?.() ?? {},
    };

    try {
      const r = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=utf-8' },
        body: JSON.stringify(payload),
      });
      const d = await r.json().catch(() => ({}));
      if (!r.ok || d.status !== 'ok') throw new Error(d.status || `HTTP ${r.status}`);

      form.querySelector('.fields')!.remove();
      say('訂閱好了，第一封信在路上。', true);
      try { (window as any).track?.('lead_submit', { source: payload.source }); } catch {}
    } catch (err) {
      console.error('[subscribe]', err);
      btn.disabled = false;
      btn.textContent = original;
      say('送出時卡了一下，再試一次？若還是不行，寫信到 hello@atpifit.com。');
    }
  });
</script>

<style>
  :root {
    --a: #e8734a;
    --t: #33c495;
    --p: #4b9bf0;
    --i: #e6a93a;
    --warm: #F7F1EC;
    --warm-2: #EFE7DE;
    --ink: #2A1F14;
    --ink-soft: rgba(42,31,20,.62);
  }

  .wrap-text { max-width: 720px; margin: 0 auto; padding: 0 20px; }

  /* ───── Hero ───── */
  .hero .kicker {
    font-size: 13px; letter-spacing: .22em; text-transform: uppercase;
    color: var(--ink-soft); margin-bottom: 10px;
  }
  h1 {
    font-family: 'Noto Serif TC', serif;
    font-weight: 900;
    font-size: clamp(40px, 7vw, 68px);
    line-height: 1.12;
    letter-spacing: -.03em;
    margin: 0 0 28px;
  }
  h1 .hl { color: var(--a); }
  .hero .lead {
    font-size: 20px; line-height: 1.7;
    color: var(--ink);
    margin-bottom: 10px;
  }
  .hero .lead-fine {
    font-size: 14px; color: var(--ink-soft); margin: 0;
  }

  .section-title {
    font-family: 'Noto Serif TC', serif;
    font-weight: 900;
    font-size: clamp(26px, 4vw, 34px);
    letter-spacing: -.02em;
    margin: 0 0 24px;
  }

  /* ───── Benefits ───── */
  .benefits-sec { background: var(--warm); margin-top: 48px; padding: 56px 0; }
  .benefits { list-style: none; padding: 0; margin: 0; display: grid; gap: 20px; }
  .benefit {
    display: grid;
    grid-template-columns: 72px 1fr;
    gap: 20px;
    align-items: start;
    padding: 24px 24px 24px 0;
    border-left: 6px solid var(--a);
    padding-left: 24px;
    background: #fff;
    border-radius: 0 12px 12px 0;
  }
  .benefit.b-a { border-left-color: var(--a); }
  .benefit.b-t { border-left-color: var(--t); }
  .benefit.b-p { border-left-color: var(--p); }
  .benefit .n {
    font-family: 'Noto Serif TC', serif;
    font-weight: 900;
    font-size: 44px;
    line-height: 1;
    color: var(--ink);
    opacity: .35;
    letter-spacing: -.02em;
  }
  .benefit h3 {
    font-family: 'Noto Serif TC', serif;
    font-weight: 700;
    font-size: 22px;
    line-height: 1.3;
    margin: 0 0 8px;
  }
  .benefit p { margin: 0; color: var(--ink-soft); line-height: 1.65; }

  /* ───── First-letter card ───── */
  .first-letter { padding-top: 56px; }
  .letter-card {
    background: var(--ink);
    color: var(--warm);
    padding: 32px 36px;
    border-radius: 16px;
    position: relative;
    overflow: hidden;
  }
  .letter-card::before {
    content: '';
    position: absolute;
    right: -40px; top: -40px;
    width: 180px; height: 180px;
    background: var(--i);
    transform: skewX(-14deg);
    border-radius: 20px;
    opacity: .22;
  }
  .letter-card .kicker {
    font-size: 12px; letter-spacing: .22em; text-transform: uppercase;
    color: rgba(247,241,236,.55);
    margin-bottom: 8px;
  }
  .letter-card h3 {
    font-family: 'Noto Serif TC', serif;
    font-weight: 900;
    font-size: 28px;
    letter-spacing: -.02em;
    margin: 0 0 14px;
    position: relative;
  }
  .letter-card .letter-lead {
    color: rgba(247,241,236,.78);
    line-height: 1.7;
    margin: 0;
    position: relative;
  }

  /* ───── Form ───── */
  .form-outer { padding-top: 48px; padding-bottom: 24px; }
  .form-sec {
    background: var(--warm);
    border-radius: 16px;
    padding: 32px;
  }
  .form-sec h2 {
    font-family: 'Noto Serif TC', serif;
    font-weight: 900;
    font-size: 26px;
    margin: 0 0 16px;
    letter-spacing: -.02em;
  }
  .form .fields { display: flex; gap: 12px; flex-wrap: wrap; }
  .form input[type="email"] {
    flex: 1 1 260px; padding: 14px 18px;
    border: 1px solid #d9c9b6; border-radius: 10px;
    font: inherit; background: #fff;
  }
  .form .btn {
    padding: 14px 32px;
    border-radius: 10px; border: 0;
    background: var(--a); color: #fff;
    font-weight: 700; cursor: pointer; font: inherit;
    letter-spacing: .04em;
  }
  .form .btn:hover { opacity: .92; }
  .form .btn:disabled { opacity: .6; cursor: wait; }
  .msg { margin-top: 12px; min-height: 1.5em; }
  .msg.ok { color: #2a7c4e; }
  .msg.err { color: #b53a2d; }
  .fine { font-size: 12px; color: var(--ink-soft); margin-top: 14px; }

  /* ───── Case / 社會證明 ───── */
  .case-sec { padding-top: 48px; }
  .case-sec .kicker {
    font-size: 13px; letter-spacing: .22em; text-transform: uppercase;
    color: var(--ink-soft); margin: 0 0 16px;
  }
  .case {
    margin: 0;
    padding: 32px 36px;
    background: #fff;
    border: 1px solid var(--warm-2);
    border-left: 6px solid var(--a);
    border-radius: 0 14px 14px 0;
  }
  .case blockquote {
    font-family: 'Noto Serif TC', serif;
    font-size: 22px;
    line-height: 1.55;
    color: var(--ink);
    margin: 0 0 16px;
    quotes: none;
  }
  .case figcaption {
    font-size: 14px;
    color: var(--ink-soft);
    line-height: 1.6;
  }
  .case figcaption strong { color: var(--ink); font-weight: 700; }
  .case figcaption .stat {
    display: block; margin-top: 10px;
    color: var(--ink);
  }
  .case figcaption .stat b {
    color: var(--a); font-weight: 900; font-size: 20px;
    font-family: 'Noto Serif TC', serif;
    margin-right: 6px;
  }

  /* ───── Bone 骨層句 ───── */
  .bone-sec { padding: 56px 0 72px; }
  .bone {
    text-align: center;
    font-family: 'Noto Serif TC', serif;
    font-size: clamp(18px, 2.6vw, 22px);
    line-height: 1.7;
    color: var(--ink-soft);
  }
  .bone p { margin: 4px 0; }
  .bone b { color: var(--ink); font-weight: 700; }

  .visually-hidden {
    position: absolute; width: 1px; height: 1px; padding: 0;
    margin: -1px; overflow: hidden; clip: rect(0,0,0,0); border: 0;
  }
</style>
