---
import BaseLayout from '../layouts/BaseLayout.astro';
import Newsletter from '../components/Newsletter.astro';
import CaseCard from '../components/CaseCard.astro';
import { LINKS, SITE, FOUNDER_PHOTO, CASES } from '../consts';

/* 視覺語言來源（2026-09-10 這輪）：quiz／member 的 UI 元素＋v4 圖形語言
   （productkit 3-教材/演說型公版-v4提案-圖形語言.md，2026-09-09 拍板）。
   薄片鐵則：一片＝一條小肌群、三片疊＝一塊大肌肉（24 §1.1）；
   數量即語意、差異即資訊、灰階打底彩色點名；斜切軸鎖畫面中線。 */

const title = '影響力健身房 ATPIFit｜把影響力當肌肉練';
const description =
  '影響力不是天生的個性，是可以量、可以練、可以驗收的能力。ATPI 把它拆成吸引、信任、專業、推進四塊肌肉，先量一次，再一次練一塊。';

/* 四塊影響力肌肉。
   正式名一律「〇〇肌肉」，不寫「〇〇力」也不簡寫成「〇〇肌」（字典 01:40–47）。
   結果句是給對外入口用的那一套，值鎖死在字典 01:58–61，不可自行改寫：
   A 讓他想靠近／T 讓他願意說／P 讓他要找你／I 讓他願意動。
   英文標籤定稿 ATTRACT／TRUST／PROFESSIONAL／IMPACT（01:53，其餘寫法已作廢）。 */
const muscles = [
  {
    dim: 'A',
    en: 'ATTRACT',
    name: '吸引肌肉',
    result: '讓他想靠近',
    body: '同一句話，有人講完沒人接，有人講完全場轉頭。差別在你有沒有給對方一個想再聽下去的理由。',
  },
  {
    dim: 'T',
    en: 'TRUST',
    name: '信任肌肉',
    result: '讓他願意說',
    body: '對方說「我再考慮一下」，通常不是真的在考慮。他心裡真正的那句話沒出來，你就只能用猜的。',
  },
  {
    dim: 'P',
    en: 'PROFESSIONAL',
    name: '專業肌肉',
    result: '讓他要找你',
    body: '專業不是你懂多少，是他聽完之後認定你就是那個人：這件事，找你就對了。',
  },
  {
    dim: 'I',
    en: 'IMPACT',
    name: '推進肌肉',
    result: '讓他願意動',
    body: '聊得很好但沒有下一步，等於沒發生。推進是把好感變成一個具體的、今天就會動的動作。',
  },
];

/* Hero 右側的體格單示意（統一能力值儀表板標準態，規格＝consult-workshop demo-muscle-card v4.2）：
   大肌肉列標成數、12 小肌群「名字露、分數模糊」＝偷看鉤子。
   小肌群名稱原文＝quiz 題庫 label（讓他開口⋯讓他答應），不可自創。 */
const mockBoard = [
  { dim: 'A', en: 'ATTRACT', zh: '吸引肌肉', v: 68, minis: ['讓他開口', '讓他追問', '讓他記得'] },
  { dim: 'T', en: 'TRUST', zh: '信任肌肉', v: 55, minis: ['讓他敢說', '讓他交心', '讓他當真'] },
  { dim: 'P', en: 'PROFESSIONAL', zh: '專業肌肉', v: 61, minis: ['讓他釐清', '讓他有感', '讓他放心'] },
  { dim: 'I', en: 'IMPACT', zh: '推進肌肉', v: 47, minis: ['讓他想要', '讓他敢要', '讓他答應'] },
];

/* 嚐一口＝quiz 題庫 A1 原題原錨點（comconverttest QS[2]），一字不改。
   quiz 不支援帶答案深連結，所以文案只說「進去把 12 題量完」，不承諾這題會帶過去。 */
const taste = {
  label: '吸引肌肉｜讓他開口',
  text: '在還不熟的場合，你主動開口聊，對方會接著聊下去——不是客套一兩句就結束。',
  anchors: ['沒做到', '偶爾，而且生硬', '想到才做、時好時壞', '多數情境做得到', '穩定到自動化'],
};

/* 三張身分卡＝quiz 首頁「這份測驗為誰做？」原文（2026-09-05 老師備註【首-2】定稿），一字不改。 */
const who = [
  { dim: 'A', t: '上班族・想說話有份量', s: '同事、家人、老闆——同一句話，你說出來就有人聽。' },
  { dim: 'P', t: '業務・顧問・接案者', s: '不推銷。對方聊完主動問「那要怎麼跟你合作？」' },
  { dim: 'I', t: '講師・帶團隊的人', s: '一開口全場想聽，每個人覺得「這說的就是我」。' },
];

/* 八招 ⑧ 全貌感：全圖露出、現在位置亮。視覺＝quiz 首頁 q-5 地圖同款（四色縱線＋脈動點）。
   第 4 站＝課程鉤子（2026-09-10 拍板：官網首頁至少露出「這條路的終點」，不賣、只接路）。 */
const roadmap = [
  { n: 1, name: '量一次', here: true, body: '3 分鐘影響力健檢，知道四塊肌肉現在的樣子，先練哪塊最有感。' },
  { n: 2, name: '一次練一塊', here: false, body: '進影響力健身房，每天一個小動作、記一塊肌肉。' },
  { n: 3, name: '練到會用', here: false, body: '把方法帶進真實的對話現場——談合作、帶團隊、講你正在做的事。' },
  { n: 4, name: '想走快一點，帶教練', here: false, body: '超引力成交學是館裡的教練課：從一對一到一對多，有教練看著你練。', link: '/courses', linkText: '認識超引力成交學' },
];

const faq = [
  {
    q: '影響力健身房是什麼？',
    a: '影響力健身房（英文 ATPIFit）是一間把影響力當肌肉來練的場館，也是整個品牌的招牌。它用 ATPI 四塊影響力肌肉，也就是吸引、信任、專業、推進，把抽象的影響力拆成可以量測、可以逐塊練習的能力，並提供影響力健檢、每日練習與課程。',
  },
  {
    q: 'ATPI 是什麼意思？',
    a: 'ATPI 是影響力的四塊肌肉：A 吸引肌肉（ATTRACT）讓他想靠近、T 信任肌肉（TRUST）讓他願意說、P 專業肌肉（PROFESSIONAL）讓他要找你、I 推進肌肉（IMPACT）讓他願意動。四塊是相乘的關係，任何一塊趨近零，整體影響力都會嚴重折損。',
  },
  {
    q: '影響力健檢要花多久？要付費嗎？',
    a: '影響力健檢是免費的，大約三分鐘。核心是 12 題肌肉自評，加上幾題基本背景。做完會拿到四塊肌肉的分數，以及先練哪一塊最有感的建議。',
  },
  {
    q: '我不是業務，也需要練影響力嗎？',
    a: '需要。只要你要讓別人理解你在做什麼、願意跟你一起做，影響力就是你每天在用的能力。ATPI 四塊肌肉在人際溝通、家庭對話與商務創業上都適用。',
  },
  {
    q: '影響力健身房跟超引力成交學是什麼關係？',
    a: '影響力健身房是館名，也是母品牌；超引力成交學是這間館裡的教練課系列。就像健身房本身跟教練課的關係：你可以先自己進場練，也可以另外報名教練課。',
  },
];

const schema = [
  {
    '@type': 'WebPage',
    '@id': `${SITE.url}/#webpage`,
    url: SITE.url,
    name: title,
    description,
    inLanguage: 'zh-Hant-TW',
    isPartOf: { '@id': `${SITE.url}/#website` },
    about: { '@id': `${SITE.url}/#organization` },
  },
  {
    '@type': 'FAQPage',
    '@id': `${SITE.url}/#faq`,
    mainEntity: faq.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <!-- ═══ Hero：一頁只有一顆主行動鈕（24 §3.8 Nike 原則）＝「免費做影響力健檢」。
       右欄體格單＝「量化」的自我示範：賣量化的品牌，門面第一屏就要有量出來的東西。 ═══ -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="kicker">影響力健身房 ATPIFit</p>
        <h1>影響力是肌肉，<span class="hl">越練越強</span></h1>
        <!-- ⚠️ 中文段落一律寫成單行：原始碼換行會變成一個空白，在中文裡會看成排版破洞。 -->
        <p class="lead hero-lead">它不是天生的個性，也不是話術的天分。它是可以量、可以練、可以驗收的能力。</p>

        <div class="btn-row hero-cta">
          <a class="btn btn-main" href={LINKS.quiz} data-cta="quiz" data-cta-position="home-hero">
            免費做影響力健檢
          </a>
          <a class="btn btn-sub" href="/method">先看看這套方法</a>
        </div>
        <!-- meta 三格＝quiz 首頁 dq-hero-meta 同款（3 分鐘承諾是 2026-09-07 拍板值，不寫 60 秒不寫題數） -->
        <p class="hero-meta"><span>⏱ <b>3 分鐘</b></span><span>📱 不用留資料</span><span>🎁 測完馬上知道先練哪塊</span></p>
      </div>

      <!-- 體格單示意卡（v4.2 標準態）：4 大肌肉列＋12 格名字露、分數模糊的偷看鉤子 -->
      <aside class="board card" aria-label="影響力體格單示意">
        <div class="board-head">
          <span class="board-sec">MUSCLE CHECK · <b>你的影響力體格單</b></span>
          <span class="board-tag">示意</span>
        </div>
        {mockBoard.map((m) => (
          <div class="bsec" data-dim={m.dim}>
            <div class="brow">
              <span class="ben">{m.dim} {m.en}</span>
              <span class="bzh">{m.zh}</span>
              <span class="bbar">
                {[0, 1, 2].map((s) => {
                  const fill = Math.max(0, Math.min(100, 3 * m.v - 100 * s));
                  return <i style={`background:linear-gradient(90deg,var(--dim) ${fill}%,#EFE6DB ${fill}%)`}></i>;
                })}
              </span>
              <span class="bv num">{m.v}</span>
            </div>
            <div class="brow3">
              {m.minis.map((mini) => (
                <span class="mini">
                  <span class="mini-n">{mini}</span>
                  <span class="mini-bar peek"><i style={`width:${40 + Math.round(Math.random() * 45)}%`}></i></span>
                </span>
              ))}
            </div>
          </div>
        ))}
        <!-- 赤字語言禁用：低的那塊不叫弱點，叫「先練最有感」（相乘槓桿） -->
        <p class="board-note">這份是示意——推進肌肉先練最有感。你的體格單，健檢做完馬上拿到。</p>
        <div class="board-rule" role="presentation"></div>
      </aside>
    </div>
  </section>

  <!-- ═══ 嚐一口：健檢的第 1 題直接搬上首頁（文章〈讓他嚐一口〉的自我示範）═══ -->
  <section class="section section-alt">
    <div class="wrap-text">
      <p class="kicker">先試一題</p>
      <h2>健檢長什麼樣？<span class="hl">現在就試一題</span></h2>

      <div class="taste card">
        <div class="taste-top">
          <span class="qlabel">{taste.label}</span>
          <span class="taste-prog num">肌肉題 1／12</span>
        </div>
        <!-- 進度＝12 片小肌群薄片（v4：數量即語意）。彩色那片＝這題量的那條，灰片＝還沒量。 -->
        <div class="qslices" role="presentation">
          {Array.from({ length: 12 }).map((_, i) => <i class:list={[{ lit: i === 0 }]}></i>)}
        </div>
        <p class="qtxt">{taste.text}</p>
        <div class="opts">
          {taste.anchors.map((a, i) => (
            <button class="opt" type="button" data-v={i + 1}>
              <span class="odot num">{i + 1}</span>
              <span class="otxt">{a}</span>
            </button>
          ))}
        </div>
        <div class="taste-after" hidden>
          <p class="taste-fb">記下了——這是吸引肌肉的第一條小肌群「讓他開口」。剩下的題目，會把信任、專業、推進也一起量出來。</p>
          <a class="btn btn-main taste-go" href={LINKS.quiz} data-cta="quiz" data-cta-position="home-taste">
            進去把 12 題量完
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ 問題共鳴 ═══ -->
  <section class="section">
    <div class="wrap-text">
      <p class="kicker">為什麼要練</p>
      <h2>你講得很好，可是<span class="hl">對方沒動</span></h2>
      <p class="lead pain-lead">報價寄出去，對方說再看看。會議上你講完了，大家點頭，然後沒有然後。內容明明是對的，只是那句話沒有落到他心裡。</p>
      <p class="pain-body">多數人這時會去找更厲害的話術。但話術像打氣打出來的肌肉——看起來壯，一鬆手就消。真正在運作的，是底下那四塊看不見的肌肉。</p>
    </div>
  </section>

  <!-- ═══ 三張身分卡（quiz 首-2 原文搬入：人先認出自己）═══ -->
  <section class="section section-alt">
    <div class="wrap">
      <p class="kicker">誰在練</p>
      <h2>三種人，<span class="hl">練同一套肌肉</span></h2>
      <div class="grid who">
        {who.map((w) => (
          <div class="who-card" data-dim={w.dim}>
            <p class="who-t">{w.t}</p>
            <p class="who-s">{w.s}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ 四塊影響力肌肉 ═══ -->
  <section class="section">
    <div class="wrap">
      <p class="kicker">ATPI 四塊影響力肌肉</p>
      <h2>影響力可以拆開，<span class="hl">一塊一塊練</span></h2>
      <p class="lead sec-lead">溝通不是藝術，而是科學。能拆解，就能練；能練，就能量出進步。</p>

      <!-- 標題只放正式名；結果句另起一行當描述，不拿它當維度標籤（字典 01:87）。 -->
      <div class="grid muscles">
        {muscles.map((m) => (
          <article class="card muscle" data-dim={m.dim}>
            <span class="m-slices" role="presentation"><i></i><i></i><i></i></span>
            <span class="m-en">{m.dim} · {m.en}</span>
            <h3>{m.name}</h3>
            <p class="muscle-result">{m.result}</p>
            <p class="m-body">{m.body}</p>
          </article>
        ))}
      </div>

      <p class="muscles-note">四塊不是加起來，是<b>相乘</b>。所以還沒練起來的那一塊，練起來漲最多，<b>先練那塊最有感</b>。</p>
    </div>
  </section>

  <!-- ═══ 全貌感：影響力之路（八招 ⑧，視覺＝quiz q-5 地圖同款）═══ -->
  <section class="section section-alt">
    <div class="wrap-text">
      <p class="kicker">你會怎麼走</p>
      <h2>全部的路<span class="hl">先給你看</span></h2>

      <!-- 主圖形＝L5-01 全貌圖同款（24 §3.9 薄片八條）：一條基線、三態薄片不給圖例——
           實色加高＝你現在這站，虛線描邊＝還沒到。實色只有 1 片（紅線：一張圖最多 2 片）。
           斜切共軸鎖畫面中線 y=150；字是標籤，貼片下、放群組外保持直立。 -->
      <div class="map-fig" aria-hidden="true">
        <svg viewBox="30 24 580 280" xmlns="http://www.w3.org/2000/svg">
          <line x1="60" y1="230" x2="580" y2="230" stroke="var(--ink)" stroke-width="3" opacity=".25" stroke-linecap="round" />
          <g transform="translate(0,150) skewX(-12) translate(0,-150)">
            <rect x="80" y="80" width="90" height="150" rx="10" fill="var(--a)" />
            <rect x="210" y="120" width="90" height="110" rx="10" fill="none" stroke="var(--ink)" stroke-width="2" stroke-dasharray="7 7" opacity=".28" />
            <rect x="340" y="120" width="90" height="110" rx="10" fill="none" stroke="var(--ink)" stroke-width="2" stroke-dasharray="7 7" opacity=".28" />
            <rect x="470" y="120" width="90" height="110" rx="10" fill="none" stroke="var(--ink)" stroke-width="2" stroke-dasharray="7 7" opacity=".28" />
          </g>
          <text x="118" y="52" font-size="21" font-weight="700" fill="var(--a-deep)" text-anchor="middle">你在這裡</text>
          <path d="M118 62 L118 74" stroke="var(--a-deep)" stroke-width="2.5" stroke-linecap="round" />
          <text x="118" y="266" font-size="19" font-weight="700" fill="var(--ink)" text-anchor="middle">01 量一次</text>
          <text x="243" y="266" font-size="19" font-weight="400" fill="var(--ink)" opacity=".55" text-anchor="middle">02 練一塊</text>
          <text x="373" y="266" font-size="19" font-weight="400" fill="var(--ink)" opacity=".55" text-anchor="middle">03 練到會用</text>
          <text x="503" y="266" font-size="19" font-weight="400" fill="var(--ink)" opacity=".55" text-anchor="middle">04 帶教練</text>
        </svg>
      </div>

      <div class="map">
        {roadmap.map((r) => (
          <div class:list={['stn', `n${r.n}`, { here: r.here }]}>
            <p class="stn-t">第 {r.n} 站・{r.name}{r.here && <span class="you">你在這</span>}</p>
            <p class="stn-s">{r.body}{r.link && <> <a href={r.link}>{r.linkText} →</a></>}</p>
          </div>
        ))}
      </div>

      <p class="road-end">走到最後，不是你變成一個很會講話的人，而是<b>你說的話開始有人願意照著做，因為他們相信的是你這個人</b>。</p>
    </div>
  </section>

  <!-- ═══ 教的人是誰（2026-09-11 老師點名：官網看不到「人」違反 ATPI 信任原則——
       方法看完，緊接著就要看到教的人。數字與頭銜＝about 頁同一份，不可自行增補。
       照片位由 FOUNDER_PHOTO 開關：沒填就純文字版，照片到了 consts.ts 填路徑即亮。 ═══ -->
  <section class="section">
    <div class:list={['wrap', 'coach', { 'has-photo': !!FOUNDER_PHOTO }]}>
      {FOUNDER_PHOTO && (
        <figure class="coach-photo">
          <img src={FOUNDER_PHOTO} alt="平凡人光頭（徐哲彥）——影響力健身房創辦人" width="380" height="450" loading="lazy" />
          <div class="coach-rule" role="presentation"></div>
        </figure>
      )}
      <div class="coach-copy">
        <p class="kicker">教的人是誰</p>
        <h2>平凡人光頭，<span class="hl">不是天生會講的人</span></h2>
        <p class="lead coach-lead">本名徐哲彥。影響力健身房創辦人、ATPI 溝通 4 大肌肉框架創始人。名字裡留著「平凡人」三個字，因為這套方法的前提就是：影響力不是天賦，是練出來的肌肉。</p>
        <ul class="coach-nums">
          <li><b class="bignum">200+</b><span>場演講</span></li>
          <li><b class="bignum">2000+</b><span>位學員</span></li>
