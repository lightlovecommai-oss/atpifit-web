<script>
  /* 嚐一口：選了就給回饋＋放行下一步。答案不送後端（quiz 不支援帶答案深連結），只記事件。 */
  const opts = document.querySelectorAll<HTMLButtonElement>('.taste .opt');
  const after = document.querySelector<HTMLElement>('.taste-after')!;
  opts.forEach((btn) => {
    btn.addEventListener('click', () => {
      opts.forEach((b) => b.classList.toggle('sel', b === btn));
      if (after.hidden) {
        after.hidden = false;
        after.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      }
      try { (window as any).track?.('cta_click', { cta_id: 'home_taste_answer', value: Number(btn.dataset.v) }); } catch {}
    });
  });
</script>

